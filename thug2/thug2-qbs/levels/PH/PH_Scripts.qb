SCRIPT PH_2d_sign_element_create parent = menu3d_anchor 
	IF GetGlobalFlag flag = SCREEN_MODE_WIDE 
		<offset> = PAIR(-8.00000000000, 0.00000000000) 
	ELSE 
		<offset> = PAIR(0.00000000000, 0.00000000000) 
	ENDIF 
	CreateScreenElement { 
		Type = SpriteElement 
		parent = <parent> 
		texture = PH_icon_1 
		id = PH_tag 
		scale = 2.50000000000 
		rgba = [ 128 128 128 100 ] 
		pos = ( PAIR(20.00000000000, 80.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ left top ] 
		z_priority = -51 
	} 
	CreateScreenElement { 
		Type = SpriteElement 
		parent = <parent> 
		texture = PH_icon_2 
		id = PH_bandaid 
		scale = 1.79999995232 
		rgba = [ 128 128 128 100 ] 
		pos = ( PAIR(72.00000000000, 320.00000000000) + <offset> ) 
		rot_angle = -90 
		just = [ center center ] 
		z_priority = -51 
	} 
	RunScriptOnScreenElement id = PH_tag PH_tag_anim 
	RunScriptOnScreenElement id = PH_bandaid do_random_effect_paused params = { id = <id> } 
ENDSCRIPT

SCRIPT PH_tag_anim 
	BEGIN 
		start_pos = PAIR(20.00000000000, 80.00000000000) 
		DoMorph time = 0 pos = ( <start_pos> - PAIR(100.00000000000, 0.00000000000) ) scale = 2.50000000000 rot_angle = 0 
		wait 2 seconds 
		DoMorph time = 0.30000001192 pos = <start_pos> 
		wait RANDOM(1, 1, 1) RANDOMCASE 2 RANDOMCASE 3 RANDOMCASE 4 RANDOMEND seconds 
		DoMorph time = 0.20000000298 pos = ( <start_pos> - PAIR(100.00000000000, 0.00000000000) ) 
		wait RANDOM(1, 1, 1) RANDOMCASE 5 RANDOMCASE 8 RANDOMCASE 3 RANDOMEND seconds 
	REPEAT 
ENDSCRIPT


