SCRIPT PH_HogeysCreate 
	create prefix = "PH_Hogey" 
	create prefix = "PH_Trigger_Hogey" 
ENDSCRIPT

SCRIPT PH_HogeysKill 
	kill prefix = "PH_Hogey" 
	kill prefix = "PH_Trigger_Hogey" 
ENDSCRIPT

SCRIPT PH_TrashCreate 
	create prefix = "TRG_TrashTrigger" 
	create prefix = "trash" 
	create prefix = "TRG_Trash_Box" 
ENDSCRIPT

SCRIPT PH_TrashKill 
	kill prefix = "trash" 
	kill prefix = "TRG_Trash_Box" 
	kill prefix = "TRG_TrashTrigger" 
ENDSCRIPT

FLAG_BA_TRASHCAN_SPINNING = 0 
FLAG_LA_LATTE1 = 100 
FLAG_LA_LATTE2 = 101 
FLAG_LA_LATTE3 = 102 
FLAG_LA_LATTE4 = 103 
FLAG_LA_LATTE5 = 104 
SCRIPT BA_TrashCan_Spinny1 
	printf "BA_Trashcan_spinny1" 
	Obj_GetID 
	IF isalive name = trash14 
		kill name = <name> 
		Obj_SetFlag FLAG_BA_TRASHCAN_SPINNING 
		CreateFastParticleSystem name = JOW_Trash01 params_Script = JOW_PH_Trash01_fast_particle_params 
		trash01 : Rigidbody_Kick Vel = VECTOR(5, 5, 0) RotVel = VECTOR(10, 10, 10) 
		trash02 : Rigidbody_Kick Vel = VECTOR(0, 5, 0) RotVel = VECTOR(10, -10, 10) 
		trash03 : Rigidbody_Kick Vel = VECTOR(0, 0, 0) RotVel = VECTOR(-10, 10, 10) 
		trash04 : Rigidbody_Kick Vel = VECTOR(5, 15, 0) RotVel = VECTOR(10, 10, -10) 
		trash05 : Rigidbody_Kick Vel = VECTOR(0, 15, 0) RotVel = VECTOR(-10, -10, 10) 
		trash06 : Rigidbody_Kick Vel = VECTOR(0, 15, 5) RotVel = VECTOR(10, -10, 10) 
		trash07 : Rigidbody_Kick Vel = VECTOR(0, 15, 0) RotVel = VECTOR(10, 10, -10) 
		trash08 : Rigidbody_Kick Vel = VECTOR(0, 0, 0) RotVel = VECTOR(-10, 10, -10) 
		trash09 : Rigidbody_Kick Vel = VECTOR(5, 1, 0) RotVel = VECTOR(-10, -10, -10) 
		trash10 : Rigidbody_Kick Vel = VECTOR(5, 0, 0) RotVel = VECTOR(10, -10, -10) 
		trash11 : Rigidbody_Kick Vel = VECTOR(0, 15, 0) RotVel = VECTOR(10, 10, -10) 
		trash12 : Rigidbody_Kick Vel = VECTOR(0, 0, 0) RotVel = VECTOR(-10, 10, -10) 
		trash13 : Rigidbody_Kick Vel = VECTOR(5, 1, 0) RotVel = VECTOR(-10, -10, -10) 
		trash14 : Rigidbody_Kick Vel = VECTOR(5, 0, 0) RotVel = VECTOR(10, -10, -10) 
		kill name = TRG_TrashTrigger01 
		playsound Bouncy_UmbrellaHit01 
		wait 10 frames 
		playsound HitMetalCan 
		Obj_ClearFlag FLAG_BA_TRASHCAN_SPINNING 
		goal_collect_got_object goal_id = PH_classic_goal_collect flag = got_1 
		SetFlag flag = FLAG_LA_LATTE1 
	ENDIF 
ENDSCRIPT

