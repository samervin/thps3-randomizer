	LoadParticleTexture "particles\\apm_leaf04" 
	LoadParticleTexture "particles\\ba_apm_smokepuff01s" 
	LoadParticleTexture "particles\\apm_debis_02" 
	LoadParticleTexture "particles\\apm_ring_02" 
ENDSCRIPT

