SCRIPT BE_Pub_Clock 
	BEGIN 
		g_destroyed_coo_coo_pend01 : obj_rotate absolute = VECTOR(45.00000000000, 0.00000000000, 0.00000000000) time = 1 Second 
		g_destroyed_coo_coo_pend01 : Obj_WaitRotate 
		g_destroyed_coo_coo_pend01 : obj_rotate absolute = VECTOR(-45.00000000000, 0.00000000000, 0.00000000000) time = 1 Second 
		g_destroyed_coo_coo_pend01 : Obj_WaitRotate 
		wait 1 gameframe 
	REPEAT 
ENDSCRIPT

