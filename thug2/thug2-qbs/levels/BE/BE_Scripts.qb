SCRIPT BE_SkateTheLine_Got1 
	IF NOT GoalManager_HasWonGoal name = BE_AddGoal_SkateTheLine 
		printf "Set Flag======================1" 
		GoalManager_SetGoalFlag name = BE_Goal_SkateTheLine got_1 1 
	ENDIF 
ENDSCRIPT

SCRIPT BE_SkateTheLine_Got2 
