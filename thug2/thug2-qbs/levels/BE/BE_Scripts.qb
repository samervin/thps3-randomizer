				goal_flags = [ got_1 
					got_2 
					got_3 
					got_4 
				] 
				view_goals_cameras = [ { virtual_cam 
						targetid = world 
						targetOffset = VECTOR(330.1, -527.3, -7464.3) 
						positionOffset = VECTOR(-3952.6, 1236.3, 1398.3) 
						frames = 200 
						skippable = 1 
					} 
				] 
			} 
			AddGoal_collect { 
				unlimited_Time 
				classic_mode_goal 
