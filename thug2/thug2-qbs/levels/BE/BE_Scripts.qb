						positionOffset = VECTOR(-2817.3, 1528, 549.8) 
						frames = 200 
						skippable = 1 
					} 
				] 
			} 
			AddGoal_gaps { 
				classic_mode_goal 
				version = 17 
				unlimited_Time 
				goal_text = "\\t1 (\\k1) the soldiers" 
				view_goals_text = "\\t1 (\\k1) the soldiers" 
				goal_deScription = "\\t1 (\\k1) the soldiers" 
				goal_flags = [ got_1 
				] 
