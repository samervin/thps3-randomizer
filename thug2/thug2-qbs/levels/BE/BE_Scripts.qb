						targetOffset = VECTOR(-1770.4, 933.7, 11431.7) 
						positionOffset = VECTOR(-2156.9, 402.3, 1453.3) 
						frames = 200 
						skippable = 1 
					} 
				] 
				key_combos = [ Air_CircleUR ] 
			} 
			AddGoal_gaps { 
				classic_mode_goal 
				version = 18 
				unlimited_Time 
				collect_type = "Acid Drops" 
				goal_text = "Acid Drop from the 4 Beer-steins" 
				view_goals_text = "Acid Drop from the 4 Beer-steins" 
				use_hud_counter 
