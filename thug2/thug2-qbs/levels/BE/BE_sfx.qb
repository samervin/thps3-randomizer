		RANDOMCASE Obj_PlayStream SK6_BE_CityTraffic03 vol = 150 emitter = TRG_SFX_SOB_DistRiver02 dropoff_function = linear 
	RANDOMEND 
	wait 25 seconds 
ENDSCRIPT

