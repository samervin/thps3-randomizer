			wait 7 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird15 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_Birds05 RANDOMCASE TRG_SFX_SOB_Birds06 RANDOMCASE TRG_SFX_SOB_Birds07 RANDOMEND priority = StreamPriorityLow 
			wait 7 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird16 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_Birds05 RANDOMCASE TRG_SFX_SOB_Birds06 RANDOMCASE TRG_SFX_SOB_Birds07 RANDOMEND priority = StreamPriorityLow 
