			wait 0.50999999046 seconds 
			RANDOMCASE Obj_PlayStream SK6_SmSpark20 emitter = <emitter> vol = 50 dropoff_function = exponential priority = StreamPriorityLow 
			wait 0.34000000358 seconds 
			RANDOMCASE Obj_PlayStream SK6_SmSpark21 emitter = <emitter> vol = 50 dropoff_function = exponential priority = StreamPriorityLow 
