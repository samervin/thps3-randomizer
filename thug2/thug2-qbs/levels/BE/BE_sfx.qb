SCRIPT BE_SFX_DistRiver01 
	RANDOM_NO_REPEAT(1, 1, 1) 
		RANDOMCASE Obj_PlayStream SK6_BE_CityTraffic01 vol = 150 emitter = TRG_SFX_SOB_DistRiver01 dropoff_function = linear 
		RANDOMCASE Obj_PlayStream SK6_BE_CityTraffic02 vol = 150 emitter = TRG_SFX_SOB_DistRiver01 dropoff_function = linear 
		RANDOMCASE Obj_PlayStream SK6_BE_CityTraffic03 vol = 150 emitter = TRG_SFX_SOB_DistRiver01 dropoff_function = linear 
	RANDOMEND 
	wait 25 seconds 
ENDSCRIPT

