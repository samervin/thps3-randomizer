			wait 0.43999999762 seconds 
			RANDOMCASE Obj_PlayStream SK6_SmSpark08 emitter = <emitter> vol = 50 dropoff_function = exponential priority = StreamPriorityLow 
			wait 0.99000000954 seconds 
			RANDOMCASE Obj_PlayStream SK6_SmSpark09 emitter = <emitter> vol = 50 dropoff_function = exponential priority = StreamPriorityLow 
			wait 0.43000000715 seconds 
			RANDOMCASE Obj_PlayStream SK6_SmSpark10 emitter = <emitter> vol = 50 dropoff_function = exponential priority = StreamPriorityLow 
			wait 0.66000002623 seconds 
			RANDOMCASE Obj_PlayStream SK6_SmSpark11 emitter = <emitter> vol = 50 dropoff_function = exponential priority = StreamPriorityLow 
			wait 0.46000000834 seconds 
			RANDOMCASE Obj_PlayStream SK6_SmSpark12 emitter = <emitter> vol = 50 dropoff_function = exponential priority = StreamPriorityLow 
			wait 0.58999997377 seconds 
			RANDOMCASE Obj_PlayStream SK6_SmSpark13 emitter = <emitter> vol = 50 dropoff_function = exponential priority = StreamPriorityLow 
			wait 0.52999997139 seconds 
			RANDOMCASE Obj_PlayStream SK6_SmSpark14 emitter = <emitter> vol = 50 dropoff_function = exponential priority = StreamPriorityLow 
			wait 1.00000000000 seconds 
			RANDOMCASE Obj_PlayStream SK6_SmSpark15 emitter = <emitter> vol = 50 dropoff_function = exponential priority = StreamPriorityLow 
			wait 1.08000004292 seconds 
			RANDOMCASE Obj_PlayStream SK6_SmSpark16 emitter = <emitter> vol = 50 dropoff_function = exponential priority = StreamPriorityLow 
			wait 1.53999996185 seconds 
			RANDOMCASE Obj_PlayStream SK6_SmSpark17 emitter = <emitter> vol = 50 dropoff_function = exponential priority = StreamPriorityLow 
			wait 0.68000000715 seconds 
