	IF NOT IsSoundPlaying ThisBarrelsSound01 
		TRG_SFX_Ghost_Barrel02 : Obj_PlaySound HitTrafficBarrier vol = 200 dropoff = 150 id = ThisBarrelsSound01 
	ENDIF 
	IF NOT IsStreamPlaying SK6_TeaWater 
