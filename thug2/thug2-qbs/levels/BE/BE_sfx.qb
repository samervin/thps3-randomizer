SCRIPT BE_SFX_Pigeons_Idle 
	IF skatercamanimfinished 
		wait RANDOM(1, 1, 1) RANDOMCASE 1 RANDOMCASE 0.50000000000 RANDOMCASE 0.10000000149 RANDOMEND seconds 
		IF NOT IsStreamPlaying PigeonFlyUpSound 
			IF NOT IsStreamPlaying PigeonIdleSound 
				RANDOM(2, 1, 1) 
					RANDOMCASE 
					RANDOMCASE Obj_PlayStream BO_Pigeon id = PigeonIdleSound vol = 50 pitch = RANDOM_RANGE PAIR(95.00000000000, 100.00000000000) priority = StreamPriorityLowMid 
					RANDOMCASE Obj_PlayStream BO_Pigeon_02 id = PigeonIdleSound vol = 50 pitch = RANDOM_RANGE PAIR(95.00000000000, 100.00000000000) priority = StreamPriorityLowMid 
				RANDOMEND 
			ENDIF 
		ENDIF 
	ENDIF 
ENDSCRIPT

SCRIPT BE_SFX_Pigeons_FlyUp 
	IF IsStreamPlaying PigeonIdleSound 
		StopStream PigeonIdleSound 
	ENDIF 
	IF IsStreamPlaying BO_Pigeon 
		StopStream BO_Pigeon 
	ENDIF 
	StopStream BO_PigeonFly 
	IF NOT IsStreamPlaying PigeonFlyUpSound 
		Obj_PlayStream BO_PigeonFly id = PigeonFlyUpSound vol = 150 
	ENDIF 
ENDSCRIPT

SCRIPT BE_SFX_Bats_Loop 
	BEGIN 
		IF NOT IsStreamPlaying ThisBatLoopStream 
			Obj_PlayStream SK6_BE_BatsLoopStream01 priority = StreamPriorityLowMid dropoff = 60 id = ThisBatLoopStream 
		ENDIF 
		wait 1 second 
	REPEAT 
ENDSCRIPT


