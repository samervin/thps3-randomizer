SCRIPT SK6_BE_SFX_TankCracking 
	TRG_SFX_Ghost_Fishtank : Obj_PlaySound SK6_GlassCrackQuick01 vol = 120 dropoff = 150 
	TRG_SFX_Ghost_Fishtank : Obj_PlayStream SK6_GlassCracking01 vol = 120 dropoff = 150 priority = 101 
ENDSCRIPT

SCRIPT SK6_BE_SFX_TankBreakingOpen 
	TRG_SFX_Ghost_Fishtank : Obj_PlayStream SK6_WaterRushOut01 vol = 150 dropoff = 150 priority = 101 
	TRG_SFX_Ghost_Fishtank : Obj_PlaySound SK6_BreakGlassPane01 vol = 120 dropoff = 150 
ENDSCRIPT

SCRIPT SK6_BE_SFX_ChurchGlassPaneBreak01 
	PlaySound SK6_BreakGlassPane01 vol = 120 pitch = RANDOM(1, 1, 1) RANDOMCASE 80 RANDOMCASE 90 RANDOMCASE 100 RANDOMEND 
ENDSCRIPT

SCRIPT BE_SFX_AssfartWaterfall01 
	Obj_PlaySound SK6_BE_AssfartFountain01 vol = 70 emitter = TRG_SFX_SOB_AssfartWaterfall01 dropoff_function = linear 
ENDSCRIPT

SCRIPT BE_SFX_AssfartReverb01 
	IF NOT GameIsPaused 
		IF NOT InSplitscreenGame 
			IF ( inside ) 
				change InsideAdjacentReverbBox01 = 1 
				GetValueFromVolume cdvol 
				IF ( <value> = 0 ) 
					SetSfxReverb 60 mode = REV_MODE_ROOM 
				ELSE 
					SetSfxReverb 75 mode = REV_MODE_ROOM 
				ENDIF 
			ELSE 
				IF ( InsideAdjacentReverbBox02 = 0 ) 
					SetSfxReverb 0 mode = REV_MODE_ROOM 
				ELSE 
					GetValueFromVolume cdvol 
					IF ( <value> = 0 ) 
						SetSfxReverb 60 mode = REV_MODE_ARENA 
					ELSE 
						SetSfxReverb 75 mode = REV_MODE_ARENA 
					ENDIF 
				ENDIF 
				change InsideAdjacentReverbBox01 = 0 
			ENDIF 
		ENDIF 
	ENDIF 
ENDSCRIPT

SCRIPT BE_SFX_TreeBirds01 
	wait RANDOM(1, 1, 1, 1) RANDOMCASE 0 RANDOMCASE 0.50000000000 RANDOMCASE 0.69999998808 RANDOMCASE 0.10000000149 RANDOMEND seconds 
	BEGIN 
		RANDOM_NO_REPEAT(1, 1, 1, 1, 1, 1, 1, 1, 1) 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird09 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds01 RANDOMCASE TRG_SFX_SOB_Birds02 RANDOMEND priority = StreamPriorityLow 
			wait 5 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird10 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds01 RANDOMCASE TRG_SFX_SOB_Birds02 RANDOMEND priority = StreamPriorityLow 
			wait 7 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird11 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds01 RANDOMCASE TRG_SFX_SOB_Birds02 RANDOMEND priority = StreamPriorityLow 
			wait 4 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird12 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds01 RANDOMCASE TRG_SFX_SOB_Birds02 RANDOMEND priority = StreamPriorityLow 
			wait 3 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird13 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds01 RANDOMCASE TRG_SFX_SOB_Birds02 RANDOMEND priority = StreamPriorityLow 
			wait 3 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird14 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds01 RANDOMCASE TRG_SFX_SOB_Birds02 RANDOMEND priority = StreamPriorityLow 
			wait 7 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird15 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds01 RANDOMCASE TRG_SFX_SOB_Birds02 RANDOMEND priority = StreamPriorityLow 
			wait 7 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird16 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds01 RANDOMCASE TRG_SFX_SOB_Birds02 RANDOMEND priority = StreamPriorityLow 
			wait 7 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird17 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds01 RANDOMCASE TRG_SFX_SOB_Birds02 RANDOMEND priority = StreamPriorityLow 
			wait 5 seconds 
		RANDOMEND 
		wait RANDOM(1, 1, 1) RANDOMCASE 0.50000000000 RANDOMCASE 1.10000002384 RANDOMCASE 1.29999995232 RANDOMEND seconds 
	REPEAT 
ENDSCRIPT

SCRIPT BE_SFX_TreeBirds02 
	wait RANDOM(1, 1, 1, 1) RANDOMCASE 0 RANDOMCASE 0.20000000298 RANDOMCASE 0.80000001192 RANDOMCASE 0.89999997616 RANDOMEND seconds 
	BEGIN 
		RANDOM_NO_REPEAT(1, 1, 1, 1, 1, 1, 1, 1) 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird01 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds03 RANDOMCASE TRG_SFX_SOB_Birds04 RANDOMEND priority = StreamPriorityLow 
			wait 4 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird02 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds03 RANDOMCASE TRG_SFX_SOB_Birds04 RANDOMEND priority = StreamPriorityLow 
			wait 5 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird03 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds03 RANDOMCASE TRG_SFX_SOB_Birds04 RANDOMEND priority = StreamPriorityLow 
			wait 4 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird04 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds03 RANDOMCASE TRG_SFX_SOB_Birds04 RANDOMEND priority = StreamPriorityLow 
			wait 5 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird05 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds03 RANDOMCASE TRG_SFX_SOB_Birds04 RANDOMEND priority = StreamPriorityLow 
			wait 8 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird06 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds03 RANDOMCASE TRG_SFX_SOB_Birds04 RANDOMEND priority = StreamPriorityLow 
			wait 9 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird07 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds03 RANDOMCASE TRG_SFX_SOB_Birds04 RANDOMEND priority = StreamPriorityLow 
			wait 4 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird08 vol = BE_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1) RANDOMCASE TRG_SFX_SOB_Birds03 RANDOMCASE TRG_SFX_SOB_Birds04 RANDOMEND priority = StreamPriorityLow 
			wait 5 seconds 
		RANDOMEND 
		wait RANDOM(1, 1, 1) RANDOMCASE 0.50000000000 RANDOMCASE 1.10000002384 RANDOMCASE 1.29999995232 RANDOMEND seconds 
	REPEAT 
ENDSCRIPT

