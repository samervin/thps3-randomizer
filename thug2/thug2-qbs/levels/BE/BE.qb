SCRIPT g_phil_BulbShatter01Script 
	Shatter { Name = g_phil_BulbShatter01 
		area = 2000 
		texture_swap = BA_APM_brokenglass01 
		variance = 1.00000000000 
		spread = 1.00000000000 
		life = 6 
		bounce = 1 
		scale = 1.00000000000 
		vel_x = 30 
		vel_y = 30 
		vel_z = 30 
	} 
	Invisible Name = g_phil_BulbShatter01 
	Wait 10 seconds 
	Visible Name = g_phil_BulbShatter01 
ENDSCRIPT

