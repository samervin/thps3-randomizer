SCRIPT DJ_Boost01 
	IF NOT walking 
		Trigger_Speed_Boost speed = 1600 
	ENDIF 
ENDSCRIPT

SCRIPT ALC_Televator 
	TeleportSkaterToNode nodename = TRG_Restart_05 
	IF NOT GotParam cut 
		create_panel_message { 
			id = leaving_message 
			text = "Rewind!" 
			pos = PAIR(320, 180) 
			rgba = [ 118 , 110 , 14 , 128 ] 
			pulse_blur 
			start = 200 
			speed = 1 
			scale = 1.00000000000 
		} 
	ENDIF 
	IF GotParam sound 
		playsound <sound> 
	ENDIF 
	playsound LA_Skid_11 
	IF GotParam node 
		sk3_teleporttonode nodename = <node> 
	ELSE 
	ENDIF 
ENDSCRIPT

SCRIPT ALC_Televator1 
	TeleportSkaterToNode nodename = TRG_Restart_01 
	IF NOT GotParam cut 
		create_panel_message { 
			id = leaving_message 
			text = "Rewind!" 
			pos = PAIR(320.00000000000, 180.00000000000) 
			rgba = [ 118 , 110 , 14 , 128 ] 
			pulse_blur 
			start = 200 
			speed = 1 
			scale = 1.00000000000 
		} 
	ENDIF 
	IF GotParam sound 
		playsound <sound> 
	ENDIF 
	playsound LA_Skid_11 
	IF GotParam node 
		sk3_teleporttonode nodename = <node> 
	ELSE 
	ENDIF 
ENDSCRIPT

