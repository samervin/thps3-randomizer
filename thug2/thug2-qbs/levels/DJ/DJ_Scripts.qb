SCRIPT DJ_2d_sign_element_create parent = menu3d_anchor 
	IF GetGlobalFlag flag = SCREEN_MODE_WIDE 
		<offset> = PAIR(-8.00000000000, 0.00000000000) 
	ELSE 
		<offset> = PAIR(0.00000000000, 0.00000000000) 
	ENDIF 
	Theme_GetPauseBarColor return_value = warning_color 
	CreateScreenElement { 
		Type = ContainerElement 
		parent = <parent> 
		id = DJ_warning 
		pos = PAIR(0.00000000000, 0.00000000000) 
		z_priority = -53 
	} 
	CreateScreenElement { 
		Type = SpriteElement 
		parent = DJ_warning 
		texture = DJ_icon_1 
		id = DJ_quad1 
		scale = PAIR(0.80000001192, 3.20000004768) 
		rgba = <warning_color> 
		pos = ( PAIR(138.00000000000, 180.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ left top ] 
	} 
	CreateScreenElement { 
		Type = SpriteElement 
		parent = DJ_warning 
		texture = DJ_icon_1 
		id = DJ_quad2 
		scale = PAIR(0.80000001192, 3.20000004768) 
		rgba = <warning_color> 
		pos = ( PAIR(84.00000000000, 252.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ left top ] 
	} 
	CreateScreenElement { 
		Type = SpriteElement 
		parent = DJ_warning 
		texture = DJ_icon_1 
		id = DJ_quad3 
		scale = PAIR(0.80000001192, 3.20000004768) 
		rgba = <warning_color> 
		pos = ( PAIR(29.00000000000, 284.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ left top ] 
		flip_v 
	} 
	CreateScreenElement { 
		Type = SpriteElement 
		parent = DJ_warning 
		texture = DJ_icon_1 
		id = DJ_quad4 
		scale = PAIR(0.80000001192, 3.20000004768) 
		rgba = <warning_color> 
		pos = ( PAIR(-24.00000000000, 218.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ left top ] 
		flip_v 
	} 
	CreateScreenElement { 
		Type = SpriteElement 
		parent = <parent> 
		texture = DJ_icon_2 
		id = DJ_chevron1 
		scale = PAIR(1.79999995232, 3.59999990463) 
		rgba = [ 128 128 128 100 ] 
		pos = ( PAIR(59.00000000000, 220.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ center center ] 
		z_priority = -51 
	} 
	CreateScreenElement { 
		Type = SpriteElement 
		parent = <parent> 
		texture = DJ_icon_2 
		id = DJ_chevron2 
		scale = PAIR(1.20000004768, 2.40000009537) 
		rgba = [ 128 128 128 40 ] 
		pos = ( PAIR(59.00000000000, 170.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ center center ] 
		z_priority = -51 
	} 
	RunScriptOnScreenElement id = <parent> DJ_chevron_anim 
ENDSCRIPT

SCRIPT DJ_chevron_anim 
	BEGIN 
		RunScriptOnScreenElement id = DJ_chevron2 DJ_chevron_flash_anim 
		wait 0.50000000000 seconds 
		RunScriptOnScreenElement id = DJ_chevron1 DJ_chevron_flash_anim 
		wait 0.50000000000 seconds 
		RunScriptOnScreenElement id = DJ_warning DJ_warning_anim 
	REPEAT 
ENDSCRIPT

SCRIPT DJ_chevron_flash_anim 
	DoMorph time = 0 alpha = 0 
	DoMorph time = 0.50000000000 alpha = 1 
	wait 0.20000000298 seconds 
	DoMorph time = 0.50000000000 alpha = 0 
ENDSCRIPT

SCRIPT DJ_warning_anim 
	DoMorph time = 0 alpha = 0 
	DoMorph time = 0.25000000000 alpha = 0.50000000000 
	wait 0.20000000298 seconds 
	DoMorph time = 0.25000000000 alpha = 0 
ENDSCRIPT


