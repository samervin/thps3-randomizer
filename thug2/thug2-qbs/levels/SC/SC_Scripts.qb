SCRIPT ALC_Televator { text = "Asshole!" } 
	IF NOT GotParam cut 
		Create_Panel_Message { 
			id = leaving_message 
			text = <text> 
			pos = PAIR(320, 150) 
			rgba = [ 118 , 110 , 14 , 128 ] 
			pulse_blur 
			start = 200 
			speed = 1 
			scale = 1.00000000000 
		} 
	ENDIF 
	IF GotParam sound 
		playsound <sound> 
	ENDIF 
	playsound LA_Skid_11 
	IF GotParam node 
		sk3_teleporttonode nodename = <node> 
	ELSE 
		Create_Panel_Message id = death_message text = "You forgot node=<nodename>!!" pos = PAIR(320.00000000000, 200.00000000000) 
	ENDIF 
ENDSCRIPT

SCRIPT whatever 
	bouncy 
	wait 4 second 
	Die 
ENDSCRIPT

SCRIPT basket 
	GetBonus score = 1000 text = "Gym Backboard Shattered!!" 
	ShatterAndDie name = School_Gym_Backboard area = 100 variance = 0.00000000000 vel_x = 50 vel_y = 50 vel_z = 50 spread = 0.50000000000 
	playsound HitGlassPane2x volume = 100.00000000000 pitch = 100.00000000000 
	Kill name = School_Gym_Backboard01 
ENDSCRIPT

SCRIPT SC_Secret_Entrance 
	GetBonus score = 1000 text = "Crack!" 
	Create name = SC_BreakeableGate_02 
	ShatterAndDie name = SC_BreakeableGate_02 area = 100 variance = 0.00000000000 vel_x = 50 vel_y = 50 vel_z = 50 spread = 0.50000000000 texture_swap = CG_SE2_Shatter_Grate 
	ShatterAndDie name = SC_BreakeableGate area = 100 variance = 0.00000000000 vel_x = 50 vel_y = 50 vel_z = 50 spread = 0.50000000000 texture_swap = CG_SE2_Shatter_Grate 
	playsound HitGlassPane2x volume = 100.00000000000 pitch = 100.00000000000 
	Kill name = SC_BreakeableGate 
	Kill name = SC_BreakeableGateTrigg 
	Kill name = SC_BreakeableGate_02 
ENDSCRIPT

SCRIPT SC_WoodPlank 
	ShatterAndDie name = Skylight001 area = 5000 variance = 4 vel_x = 50 vel_y = 50 vel_z = 50 spread = 1 playsound HitGlassPane2x volume = 100.00000000000 pitch = 100.00000000000 
	Kill name = Plank_TriggerBox01 
	Kill name = Plank_TriggerBox02 
