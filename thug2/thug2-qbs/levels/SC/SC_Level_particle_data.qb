	setEmitRange width = 20.00000000000 height = 20.00000000000 depth = 20.00000000000 
	setLife min = 2.00000000000 max = 3.00000000000 
	setAngleSpread spread = 1.00000000000 
	setSpeedRange min = 2.00000000000 max = 4.00000000000 
	setEmitTarget x = -1.00000000000 y = 0.50000000000 z = 0.00000000000 
	setForce x = 0.00000000000 y = -0.07999999821 z = 0.00000000000 
	setParticleSize sw = 8.00000000000 ew = 8.00000000000 
	setColor corner = 0 sr = 119 sg = 119 sb = 119 sa = 255 er = 119 eg = 119 eb = 119 ea = 255 
	setColor corner = 1 sr = 119 sg = 119 sb = 119 sa = 255 er = 119 eg = 119 eb = 119 ea = 255 
