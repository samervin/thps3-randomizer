SCRIPT SFX_PlaneBy_01 
	TRG_SFX_Ghost_Airplane_By_01 : Obj_MoveToNode name = TRG_AirplaneWayPoint0101 speed = 100 
	wait 8 seconds 
	BEGIN 
		TRG_SFX_Ghost_Airplane_By_01 : Obj_MoveToNode name = TRG_AirplaneWayPoint0102 speed = 25 
		RANDOM_NO_REPEAT(1, 1, 1, 1, 1) 
			RANDOMCASE TRG_SFX_Ghost_Airplane_By_01 : Obj_PlayStream vol = 200 TR_DistHelo01 dropoff = 2000 priority = StreamPriorityHigh 
			RANDOMCASE TRG_SFX_Ghost_Airplane_By_01 : Obj_PlayStream vol = 200 TR_DistHelo02 dropoff = 2000 priority = StreamPriorityHigh 
			RANDOMCASE TRG_SFX_Ghost_Airplane_By_01 : Obj_PlayStream vol = 200 TR_DistPlane01 dropoff = 2000 priority = StreamPriorityHigh 
			RANDOMCASE TRG_SFX_Ghost_Airplane_By_01 : Obj_PlayStream vol = 200 TR_DistPlane02 dropoff = 2000 priority = StreamPriorityHigh 
			RANDOMCASE TRG_SFX_Ghost_Airplane_By_01 : Obj_PlayStream vol = 200 TR_DistPlane03 dropoff = 2000 priority = StreamPriorityHigh 
		RANDOMEND 
		wait RANDOM(1, 1, 1) RANDOMCASE 40 RANDOMCASE 60 RANDOMCASE 90 RANDOMEND seconds 
		TRG_SFX_Ghost_Airplane_By_01 : Obj_MoveToNode name = TRG_AirplaneWayPoint0101 speed = 25 
		RANDOM_NO_REPEAT(1, 1, 1, 1, 1) 
			RANDOMCASE TRG_SFX_Ghost_Airplane_By_01 : Obj_PlayStream vol = 200 TR_DistHelo01 dropoff = 2000 priority = StreamPriorityHigh 
			RANDOMCASE TRG_SFX_Ghost_Airplane_By_01 : Obj_PlayStream vol = 200 TR_DistHelo02 dropoff = 2000 priority = StreamPriorityHigh 
			RANDOMCASE TRG_SFX_Ghost_Airplane_By_01 : Obj_PlayStream vol = 200 TR_DistPlane01 dropoff = 2000 priority = StreamPriorityHigh 
			RANDOMCASE TRG_SFX_Ghost_Airplane_By_01 : Obj_PlayStream vol = 200 TR_DistPlane02 dropoff = 2000 priority = StreamPriorityHigh 
			RANDOMCASE TRG_SFX_Ghost_Airplane_By_01 : Obj_PlayStream vol = 200 TR_DistPlane03 dropoff = 2000 priority = StreamPriorityHigh 
		RANDOMEND 
		wait RANDOM(1, 1, 1) RANDOMCASE 40 RANDOMCASE 60 RANDOMCASE 90 RANDOMEND seconds 
	REPEAT 
ENDSCRIPT

