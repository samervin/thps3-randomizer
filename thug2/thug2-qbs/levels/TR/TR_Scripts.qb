			IF ( <state> = Skater_InManual ) 
				EndGap GapID = TeachManual gapScript = TR_ADDGOAL_ManualGot_1 
			ELSE 
				Create_Panel_Message ID = Goal_Message text = "Not in Manual" Style = Panel_Message_Generic_Loss 
