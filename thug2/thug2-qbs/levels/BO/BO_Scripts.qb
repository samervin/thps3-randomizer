SCRIPT BO_flame 
	IF NOT InMultiplayerGame 
		IF NOT GetFlag flag = FLAG_BO_SKATER_IS_ON_FIRE 
			IF NOT IsSkaterOnVehicle 
				IF GameModeEquals is_career 
					IF NOT GoalManager_GoalIsLocked name = BO_Goal_HighCombo2 
						IF NOT GoalManager_HasWonGoal name = BO_Goal_HighCombo2 
							GoalManager_GetDifficultyLevel 
							SWITCH <difficulty_level> 
								CASE 0 
									Create_Panel_Block { id = VertList 
										text = "Start and land a 5,000 point combo while on fire." 
										rgba = { 70 , 70 , 144 , 10 } 
										pos = PAIR(150.00000000000, 250.00000000000) 
										time = 4500 
										just = { left left } 
										internal_just = { left left } 
									} 
								CASE 1 
									Create_Panel_Block { id = VertList 
										text = "Start and land a 15,000 point combo while on fire." 
										rgba = { 70 , 70 , 144 , 10 } 
										pos = PAIR(150.00000000000, 250.00000000000) 
										time = 4500 
										just = { left left } 
										internal_just = { left left } 
									} 
								CASE 2 
									Create_Panel_Block { id = VertList 
										text = "Start and land a 50,000 point combo while on fire." 
										rgba = { 70 , 70 , 144 , 10 } 
										pos = PAIR(150.00000000000, 250.00000000000) 
										time = 4500 
										just = { left left } 
										internal_just = { left left } 
									} 
							ENDSWITCH 
						ENDIF 
					ENDIF 
				ENDIF 
				SetFlag flag = FLAG_BO_SKATER_IS_ON_FIRE 
				goal_highcombo_enter_area goal_id = BO_Goal_HighCombo2 
				SpawnSkaterScript BO_FireParticlesOff 
				SpawnSkaterScript BO_SmokeParticlesOff 
				wait 1 frame 
				SpawnSkaterScript BO_FireParticlesOn 
				SpawnSkaterScript BO_SmokeParticlesOn 
				wait 5 seconds 
				printf "Wait 5 - 1" 
				wait 5 seconds 
				printf "Wait 5 - 2" 
				wait 5 seconds 
				printf "Wait 5 - 3" 
				wait 5 seconds 
				printf "Wait 5 - 4" 
				wait 5 seconds 
				printf "Wait 5 - 5" 
				SpawnSkaterScript BO_FireParticlesOff 
				UnSetFlag flag = FLAG_BO_SKATER_IS_ON_FIRE 
				goal_highcombo_leave_area goal_id = BO_Goal_HighCombo2 
				wait 3 seconds 
				SpawnSkaterScript BO_SmokeParticlesOff 
			ENDIF 
		ENDIF 
	ENDIF 
	UnSetFlag flag = FLAG_BO_SKATER_IS_ON_FIRE 
ENDSCRIPT

SCRIPT BO_FireParticlesOn 
	printf "Fire" 
	SpawnSound BO_SFX_Skater_Ignite 
	CreateFlexibleParticleSystem name = BurnMoFo params_script = APM_flamingBOARD_particle_params 
ENDSCRIPT

SCRIPT BO_FireParticlesOff 
	SpawnSound BO_SFX_Skater_Put_Out_Fire 
	DestroyFlexibleParticleSystem name = BurnMoFo 
ENDSCRIPT

SCRIPT BO_SmokeParticlesOn 
	printf "Fire" 
	CreateFlexibleParticleSystem name = SmokeyMoFo params_script = apm_OILYsmoke_particle_params 
ENDSCRIPT

SCRIPT BO_SmokeParticlesOff 
	DestroyFlexibleParticleSystem name = SmokeyMoFo 
ENDSCRIPT

SCRIPT BO_AllParticlesOff 
	SpawnSound BO_SFX_Skater_Put_Out_Fire 
	SpawnSkaterScript BO_FireParticlesOff 
	UnSetFlag flag = FLAG_BO_SKATER_IS_ON_FIRE 
	SpawnSkaterScript BO_SmokeParticlesOff 
	goal_highcombo_leave_area goal_id = BO_Goal_HighCombo2 
ENDSCRIPT

SCRIPT BO_Cannon1_Lit 
	GetTriggerArray grind off 
	IF Triggertype <trigger_array> 
		IF GetFlag flag = FLAG_BO_SKATER_IS_ON_FIRE 
			IF GetFlag flag = FLAG_BO_CANNON2_LIT 
				IF NOT IsAlive name = CANNON01_SMOKE_Start 
					Create name = CANNON01_SMOKE_Start 
					Create name = Cannon01_SPARKS_end_Start 
				ENDIF 
				Kill name = CANNON01_SMOKE_Start 
				Kill name = Cannon01_SPARKS_end_Start 
				Kill name = CANNON02_SMOKE_Start 
				Kill name = Cannon02_SPARKS_Start 
				BO_Cannon_Event 
			ELSE 
				SetFlag flag = FLAG_BO_CANNON1_LIT 
				IF NOT IsAlive name = CANNON01_SMOKE_Start 
					SpawnSound BO_SFX_Cannon_01_Fuse 
					Create name = CANNON01_SMOKE_Start 
					Create name = Cannon01_SPARKS_end_Start 
				ENDIF 
			ENDIF 
			wait 5 seconds 
			UnSetFlag flag = FLAG_BO_CANNON1_LIT 
			BO_Kill_Cannon1_Particles 
		ENDIF 
	ENDIF 
ENDSCRIPT

SCRIPT BO_Cannon2_Lit 
	GetTriggerArray grind off 
	IF Triggertype <trigger_array> 
		IF GetFlag flag = FLAG_BO_SKATER_IS_ON_FIRE 
			IF GetFlag flag = FLAG_BO_CANNON1_LIT 
				IF NOT IsAlive name = CANNON02_SMOKE_Start 
					Create name = CANNON02_SMOKE_Start 
					Create name = Cannon02_SPARKS_Start 
				ENDIF 
				Kill name = CANNON01_SMOKE_Start 
				Kill name = Cannon01_SPARKS_end_Start 
				Kill name = CANNON02_SMOKE_Start 
				Kill name = Cannon02_SPARKS_Start 
				BO_Cannon_Event 
			ELSE 
				SetFlag flag = FLAG_BO_CANNON2_LIT 
				IF NOT IsAlive name = CANNON02_SMOKE_Start 
					SpawnSound BO_SFX_Cannon_02_Fuse 
					Create name = CANNON02_SMOKE_Start 
					Create name = Cannon02_SPARKS_Start 
				ENDIF 
			ENDIF 
			wait 5 seconds 
			UnSetFlag flag = FLAG_BO_CANNON2_LIT 
			BO_Kill_Cannon2_Particles 
		ENDIF 
	ENDIF 
ENDSCRIPT

SCRIPT BO_Kill_Cannon1_Particles 
	IF IsAlive name = Cannon01_SPARKS_end_Start 
		StopParticleObject name = Cannon01_SPARKS_end_Start 
	ENDIF 
	IF IsAlive name = CANNON01_SMOKE_Start 
		StopParticleObject name = CANNON01_SMOKE_Start 
	ENDIF 
ENDSCRIPT

SCRIPT BO_Kill_Cannon2_Particles 
	IF IsAlive name = Cannon02_SPARKS_Start 
		StopParticleObject name = Cannon02_SPARKS_Start 
	ENDIF 
	IF IsAlive name = CANNON02_SMOKE_Start 
		StopParticleObject name = CANNON02_SMOKE_Start 
	ENDIF 
ENDSCRIPT

SCRIPT BO_NatasSpin 
	printf "Natas Check" 
	GetTriggerArray spin onto 
	IF Triggertype <trigger_array> 
		printf "spin onto" 
		SetException EX = SkaterJump scr = BO_Natas_Done 
		SetException EX = SkaterBailed scr = BO_Natas_Done 
		SetException EX = SkaterEnterAir scr = BO_Natas_Done 
		wait 3 seconds 
		IF NOT IsAlive name = <water_node> 
			Create name = <water_node> 
			IF ( <water_node> = JG_BO_HydrantWater03 ) 
				Create name = JG_BO_HydrantWater03A 
				Create name = JG_BO_HydrantWater03B 
			ENDIF 
			GetBonus score = 1000 text = "Hydrant Pop" 
			SpawnSound BO_SFX_HydrantPop_01 params = { HydrantNode = <water_node> } 
		ENDIF 
		printf "Natas for 3" 
	ENDIF 
ENDSCRIPT

SCRIPT BO_Natas_Done 
	printf "Natas done" 
ENDSCRIPT

SCRIPT BO_Decapitate_Statue01 
	IF NOT InMultiplayerGame 
		ClearExceptionGroup BO_Statue01 
		GetTriggerArray lip onto 
		IF Triggertype <trigger_array> 
			GetBonus score = 1000 text = "Destruction Bonus" 
			SpawnSound BO_SFX_HeadCrumble01 
			SetException EX = SkaterExitLip scr = BO_Decapitate_Statue01_Out Group = BO_Statue01 
			block 
		ENDIF 
	ENDIF 
ENDSCRIPT

SCRIPT BO_Decapitate_Statue01_Out 
	IF NOT InMultiplayerGame 
		ClearExceptionGroup BO_Statue01 
		StopStream SK6_CrumblingStone 
		SpawnSound BO_SFX_TakeOffStatueHead 
		IF IsAlive name = BO_StatueHead01 
			Kill name = BO_StatueHead01 
			Kill name = TRG_Rail_Statue13 
			Kill name = TRG_Rail_Statue14 
			Kill name = JG_SH_StatueShadowHead02 
			Create name = Bouncy_StatueHead01 
			Bouncy_StatueHead01 : Rigidbody_Kick vel = VECTOR(0.00000000000, 10.00000000000, -50.00000000000) rotVel = VECTOR(10.00000000000, 10.00000000000, 10.00000000000) 
			IF GoalManager_GoalExists name = BO_Goal_Gaps5 
				GoalManager_SetGoalFlag name = BO_Goal_Gaps5 got_1 1 
			ENDIF 
		ENDIF 
	ENDIF 
ENDSCRIPT

