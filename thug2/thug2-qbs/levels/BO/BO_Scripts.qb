SCRIPT BO_Gaps12_success 
	StopStream JesseJamesFindStream 
	wait 1 gameframe 
	TRG_Ped_Bum01 : Obj_PlayFam JesseJames_BO_Goal_Gaps12_Camanim01_lip vol = 200 priority = StreamPriorityHighest 
	TODManager_SetFogActive 0 
	TODManager_ResetLevelLights state_name = afternoon 
	Kill name = TRG_Ped_Hint_Jeers 
	IF ScreenElementExists id = ped_speech_dialog 
		DestroyScreenElement id = ped_speech_dialog 
	ENDIF 
	IF NOT IsAlive name = TRG_HalfpipeRV 
		Create name = TRG_HalfpipeRV 
	ENDIF 
	IF NOT IsAlive name = TRG_Ped_Segway 
		Create name = TRG_Ped_Segway 
	ENDIF 
ENDSCRIPT

SCRIPT BO_Gaps12_Post_Success1 
	StopStream JesseJames_BO_Goal_Gaps12_Camanim01_lip 
	StopStream JesseJames_BO_Goal_Gaps12_Camanim01_lip 
	StopStream JesseJames_BO_Goal_Gaps12_Camanim01_lip 
	wait 1 gameframe 
	PlayStream BO_Goal_Gaps12_Jesse_02 vol = 200 id = JesseJamesFindStream 
	TODManager_SetFogActive 1 
	TODManager_ResetLevelLights 
ENDSCRIPT

