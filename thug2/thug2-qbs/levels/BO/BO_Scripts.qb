SCRIPT BO_SkateStopper 
	IF IsAlive name = <stopper> 
		IF GetFlag flag = FLAG_BO_SKATER_IS_SPECIAL 
			ShatterAndDie name = <stopper> area = 2000 variance = 4 vel_x = 50 vel_y = 50 vel_z = 50 spread = 1 
			BroadcastEvent type = SkateStopper 
		ELSE 
			MakeSkaterGoto PedKnockdown 
			create_panel_message { text = "Get special to grind off the skatestoppers!" style = goal_collect_text } 
		ENDIF 
	ENDIF 
ENDSCRIPT

SCRIPT BO_SkateStopperDummy 
	ClearExceptionGroup BO_SkaterStopperDummy 
	WaitForEvent type = SkateStopper 
	PlaySound GoalDone 
	create_panel_message { text = "Grind off 3 more skatestoppers!" style = goal_collect_text } 
	ClearExceptionGroup BO_SkaterStopperDummy 
	WaitForEvent type = SkateStopper 
	PlaySound GoalDone 
	create_panel_message { text = "Grind off 2 more skatestoppers!" style = goal_collect_text } 
	ClearExceptionGroup BO_SkaterStopperDummy 
	WaitForEvent type = SkateStopper 
	PlaySound GoalDone 
	create_panel_message { text = "Grind off 1 more skatestopper!" style = goal_collect_text } 
	ClearExceptionGroup BO_SkaterStopperDummy 
	WaitForEvent type = SkateStopper 
	PlaySound GapSound_11 
	create_panel_message { text = "Grind off the skatestoppers Complete!" style = goal_collect_text } 
	SetSlomo 0.30000001192 
	skater : setSkaterCamOverride heading = 2.00000000000 tilt = -0.10000000149 time = 0.10000000149 zoom = 0.75000000000 
	wait 45 frames 
	skater : ClearSkaterCamOverride 
	SetSlomo 1.00000000000 
ENDSCRIPT

SCRIPT BO_Cop_Idle 
	ClearExceptionGroup BO_Cop 
	SetException EX = SkaterInArea scr = BO_Cop_WaitForSkate Group = BO_Cop 
	printf "Cop Idle" 
	Obj_PlayAnim Anim = Ped_Cop_Idle1 cycle 
	block 
ENDSCRIPT

SCRIPT BO_Cop_WaitForSkate 
	ClearExceptionGroup BO_Cop 
	SetException EX = SkaterOutOfArea scr = BO_Cop_Idle Group = BO_Cop 
	SetException EX = SkaterEnterSkating scr = BO_Cop_Attack Group = BO_Cop 
	printf "Wait For Skate" 
	Obj_PlayAnim Anim = Ped_Cop_Idle1 cycle 
	block 
ENDSCRIPT

SCRIPT BO_Cop_Attack 
	ClearExceptionGroup BO_Cop 
	printf "Attack" 
	create_panel_message { text = "Hey no skating!" style = goal_collect_text } 
	Obj_SetInnerRadius 5 
	Obj_SetOuterRadius 40 
	Obj_SetException EX = ObjectInRadius scr = BO_Cop_HitSkater Group = BO_Cop 
	Obj_SetException EX = SkaterOutOfArea scr = BO_Cop_Return Group = BO_Cop 
	BEGIN 
		Obj_LookAtObject type = skater time = 0.25000000000 
		Obj_WaitRotate 
		IF NOT Obj_GetCollision height = 0.50000000000 length = 15 
			Obj_CycleAnim Anim = Ped_Cop_RunFromIdle from = start to = 10 
			Obj_MoveForward dist = 300 speed = 10 acceleration = 1 
		ELSE 
		ENDIF 
		Obj_CycleAnim Anim = Ped_Cop_RunFromIdle from = 11 to = end 
		Obj_PlayAnim Anim = Ped_Cop_Run cycle 
		Obj_WaitMove 
		Obj_CycleAnim Anim = Ped_Cop_Idle1 
	REPEAT 
ENDSCRIPT

SCRIPT BO_Cop_Return 
	ClearExceptionGroup BO_Cop 
	SetException EX = SkaterInArea scr = BO_Cop_WaitForSkate Group = BO_Cop 
	Obj_LookAtNode name = TRG_Ped_Cop01 time = 0.50000000000 
	Obj_WaitRotate 
	Obj_PlayAnim Anim = Ped_Cop_Run cycle 
	Obj_MoveToNode name = TRG_Ped_Cop01 speed = 5 
	Obj_WaitMove 
	Goto BO_Cop_Idle 
ENDSCRIPT

SCRIPT BO_Cop_HitSkater 
	ClearExceptionGroup BO_Cop 
	SetException EX = SkaterOutOfArea scr = BO_Cop_Idle Group = BO_Cop 
	MakeSkaterGoto PedKnockdown 
	Obj_CycleAnim Anim = Ped_Cop_Hit 
	Obj_LookAtNode name = TRG_Ped_Cop01 time = 0.50000000000 
	Obj_WaitRotate 
	Obj_PlayAnim Anim = Ped_Cop_Run cycle 
	Obj_MoveToNode name = TRG_Ped_Cop01 speed = 5 
	Obj_WaitMove 
	Goto BO_Cop_Attack 
ENDSCRIPT

