	Kill name = JG_SH_BallTop01 
	Kill name = JG_SH_BallTop02 
	IF NOT IsAlive name = JG_SH_DstryArchLght 
		GetBonus score = 1000 text = "Destruction Bonus" 
		Create name = JG_SH_DstryArchLght 
		Create name = ParticleBox_ArchExp01A 
		Create name = ParticleBox_ArchSmoke01A 
		Create name = ParticleBox_ArchSparks01A 
