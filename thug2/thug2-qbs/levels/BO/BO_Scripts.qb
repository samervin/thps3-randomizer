SCRIPT BO_BailDummy 
	ClearExceptionGroup BO_SkaterBail 
	SetException EX = SkaterEnterBail scr = BO_BailDummy_Bail 
	printf "waiting for bail" 
	block 
ENDSCRIPT

SCRIPT BO_BailDummy_Bail 
	printf "Bailed" 
	wait 1 second 
	IF NOT IsAlive name = BOUNCY_SkaterObject01 
		printf "Create it" 
		Create name = BOUNCY_SkaterObject01 
		wait 5 frames 
		skater : Obj_GetPosition 
		BOUNCY_SkaterObject01 : Obj_SetPosition position = <pos> 
		wait 5 frames 
		BOUNCY_SkaterObject01 : Rigidbody_Kick vel = VECTOR(10.00000000000, 10.00000000000, 10.00000000000) rotVel = VECTOR(10.00000000000, 10.00000000000, 10.00000000000) 
	ENDIF 
	Goto BO_BailDummy 
ENDSCRIPT

