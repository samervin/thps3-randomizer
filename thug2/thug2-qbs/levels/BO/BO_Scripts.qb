	IF IsAlive name = ATM_CashB01 
		StopParticleObject name = ATM_CashB01 
	ENDIF 
	IF IsAlive name = ATM_CashC01 
		StopParticleObject name = ATM_CashC01 
	ENDIF 
ENDSCRIPT

