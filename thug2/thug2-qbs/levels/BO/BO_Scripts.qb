	ClearExceptionGroup BO_jumpfan 
	KillSpawnedscript name = BO_jump_fan 
ENDSCRIPT

SCRIPT BO_Gurney 
	Obj_ClearExceptions 
	IF GameModeEquals is_career 
		setup_ped_speech { ped_id = TRG_Gurney_Ghost 
			accept_text = "Press \\m5 to take gurney." 
			activation_script = BO_Gurney_Go 
		} 
	ELSE 
		Die 
	ENDIF 
ENDSCRIPT

SCRIPT BO_Gurney_Go 
	IF ScreenElementExists id = ped_speech_dialog 
		DestroyScreenElement id = ped_speech_dialog 
	ENDIF 
	Get_Current_Skater_Name 
	IF NOT IsSkaterOnVehicle 
		IF NOT IsAlive name = TRG_Tony_Ghost 
			Create name = TRG_Tony_Ghost 
		ENDIF 
		Kill prefix = "TRG_Ped_Gurney" 
		Create prefix = "TRG_Ped_Gurney" 
		TeleportSkaterToNode nodename = TRG_Restart_Gurney orient 
		wait 5 frames 
		Vehicle_Start params = gurney_params 
		GoalManager_ActivateGoal name = BO_Goal_Gaps7 
		Create_Panel_Block id = current_goal text = "Take the sick kid to meet Tony" style = panel_message_goal 
	ENDIF 
ENDSCRIPT

SCRIPT BO_Tony_Ghost 
	Obj_ClearExceptions 
	printf "Tony_Ghost" 
	Obj_SetInnerRadius 10 
	Obj_SetException EX = ObjectInRadius scr = BO_Meet_Tony_Win 
ENDSCRIPT

SCRIPT BO_Meet_Tony_Win 
	Obj_ClearExceptions 
	printf "Meet_Tony_Win" 
	IF GoalManager_GoalExists name = BO_Goal_Gaps7 
		GoalManager_SetGoalFlag name = BO_Goal_Gaps7 got_1 1 
	ENDIF 
	MakeSkaterGoto SkaterInit params = { walk } 
	Die 
ENDSCRIPT

SCRIPT BO_Teapot 
	GetTriggerArray grind onto 
	IF Triggertype <trigger_array> 
		SpawnSound BO_SFX_Grind_Teapot_Whistle 
		printf "Teapot" 
	ENDIF 
ENDSCRIPT

SCRIPT BO_Sick_Kid 
	Obj_PlayAnim Anim = Gurney_Stand_Idle_Rider cycle 
ENDSCRIPT

SCRIPT BO_Paramedic 
	Obj_ClearExceptions 
	Obj_SetInnerRadius 5 
	SetException EX = ObjectInRadius scr = BO_Paramedic_Knock 
	printf "BO_Paramedic" 
ENDSCRIPT

SCRIPT BO_Paramedic_Knock 
	Obj_ClearExceptions 
	printf "BO_Paramedic_Knock" 
	MakeSkaterGoto vehicle_bail 
ENDSCRIPT

SCRIPT BO_Kill_Paramedics 
	GoalManager_LoseGoal name = BO_Goal_Gaps7 
	Kill prefix = "TRG_Ped_Gurney" 
	wait 4 seconds 
	Kill name = TRG_Ped_Attendant 
	Kill name = TRG_Ped_Nurse01 
	IF NOT IsAlive name = TRG_Ped_Attendant 
		Create name = TRG_Ped_Attendant 
	ENDIF 
	IF NOT IsAlive name = TRG_Ped_Nurse01 
		Create name = TRG_Ped_Nurse01 
	ENDIF 
ENDSCRIPT

SCRIPT BO_Paramedic_Idle 
	ClearExceptionGroup BO_Paramedic 
	Obj_SetInnerRadius 45 
	SetException EX = ObjectInRadius scr = BO_Paramedic_Attack Group = BO_Paramedic 
	Obj_PlayAnim Anim = Ped_M_Idle1 cycle 
	block 
ENDSCRIPT

SCRIPT BO_Paramedic_Attack 
	ClearExceptionGroup BO_Paramedic 
	printf "Attack" 
	Obj_SetInnerRadius 5 
	Obj_SetOuterRadius 50 
	Obj_SetException EX = ObjectInRadius scr = BO_Paramedic_HitSkater Group = BO_Paramedic 
	Obj_SetException EX = SkaterOutOfArea scr = BO_Paramedic_Return Group = BO_Paramedic 
	BEGIN 
		Obj_LookAtObject type = skater time = 0.25000000000 
		Obj_WaitRotate 
		IF NOT Obj_GetCollision height = 0.50000000000 length = 15 
			Obj_CycleAnim Anim = Ped_M_RunFromIdle from = start to = 10 
			Obj_MoveForward dist = 300 speed = 10 acceleration = 1 
		ELSE 
		ENDIF 
		Obj_CycleAnim Anim = Ped_M_RunFromIdle from = 11 to = end 
		Obj_PlayAnim Anim = Ped_M_Run cycle 
		Obj_WaitMove 
		Obj_CycleAnim Anim = Ped_M_Idle1 
	REPEAT 
ENDSCRIPT

SCRIPT BO_Paramedic_Return 
	ClearExceptionGroup BO_Paramedic 
	Obj_LookAtNode name = TRG_Ped_Gurney01 time = 0.50000000000 
	Obj_WaitRotate 
	Obj_PlayAnim Anim = Ped_M_Run cycle 
	Obj_MoveToNode name = TRG_Ped_Gurney01 speed = 5 
	Obj_WaitMove 
	Goto BO_Paramedic_Idle 
ENDSCRIPT

SCRIPT BO_Paramedic_HitSkater 
	ClearExceptionGroup BO_Paramedic 
	SetException EX = SkaterOutOfArea scr = BO_Paramedic_Idle Group = BO_Paramedic 
	MakeSkaterGoto vehicle_bail 
	Obj_CycleAnim Anim = Ped_M_Push 
	Obj_LookAtNode name = TRG_Ped_Gurney01 time = 0.50000000000 
	Obj_WaitRotate 
	Obj_PlayAnim Anim = Ped_M_Run cycle 
	Obj_MoveToNode name = TRG_Ped_Gurney01 speed = 5 
	Obj_WaitMove 
	Goto BO_Paramedic_Attack 
ENDSCRIPT

SCRIPT BO_CarHop 
	ClearExceptionGroup CarHop 
	WaitForEvent type = SkaterCarHop 
	printf "Hey I got a car hop" 
	Get_Current_Skater_Name 
	IF ( <name> = segwayrider ) 
		IF GoalManager_GoalExists name = BO_Goal_Gaps14 
			GoalManager_SetGoalFlag name = BO_Goal_Gaps14 got_1 1 
		ENDIF 
	ELSE 
		Die 
	ENDIF 
	wait 30 frames 
	ClearExceptionGroup CarHop 
	WaitForEvent type = SkaterCarHop 
	printf "Hey I got 2 car hops" 
	Get_Current_Skater_Name 
	IF ( <name> = segwayrider ) 
		IF GoalManager_GoalExists name = BO_Goal_Gaps14 
			GoalManager_SetGoalFlag name = BO_Goal_Gaps14 got_2 1 
		ENDIF 
	ELSE 
		Die 
	ENDIF 
	wait 30 frames 
	ClearExceptionGroup CarHop 
	WaitForEvent type = SkaterCarHop 
	printf "Hey I got 3 car hops" 
	Get_Current_Skater_Name 
	IF ( <name> = segwayrider ) 
		IF GoalManager_GoalExists name = BO_Goal_Gaps14 
			GoalManager_SetGoalFlag name = BO_Goal_Gaps14 got_3 1 
		ENDIF 
	ELSE 
		Die 
	ENDIF 
ENDSCRIPT

SCRIPT BO_Focus 
	ClearExceptionGroup BO_Focus 
	WaitForEvent type = PedHitByProjectile 
	printf "Smack that Bitch" 
ENDSCRIPT

SCRIPT BO_Subway 
	SpawnSound BO_SFX_SubwayPassBy 
	BEGIN 
		Obj_MoveToNode name = <endnode> speed = RANDOM_RANGE PAIR(60.00000000000, 65.00000000000) 
		Obj_WaitMove 
		wait RANDOM_NO_REPEAT(1, 1, 1, 1) RANDOMCASE 3 RANDOMCASE 5 RANDOMCASE 7 RANDOMCASE 9 RANDOMEND seconds 
		Obj_MoveToNode name = <startnode> speed = RANDOM_RANGE PAIR(60.00000000000, 65.00000000000) 
		Obj_WaitMove 
		wait RANDOM_NO_REPEAT(1, 1, 1, 1) RANDOMCASE 3 RANDOMCASE 5 RANDOMCASE 7 RANDOMCASE 9 RANDOMEND seconds 
	REPEAT 
ENDSCRIPT

SCRIPT BO_Subway_Off 
	TODManager_SetFogActive 1 
	TODManager_ResetLevelLights 
	Kill prefix = "TRG_Ped_Sub" 
	Kill name = BO_Subway01 
	Kill name = BO_Subway03 
	Invisible prefix = "BO_Subway_Pillar" 
	Invisible prefix = "BO_SubwayBench" 
	Invisible prefix = "BO_SubwayExit" 
	Invisible prefix = "JG_Sub_BlinkingLights" 
	Invisible prefix = "JG_Sub_CarPass" 
	Invisible prefix = "JG_Sub_Fence" 
	Invisible prefix = "JG_Sub_FenceFrame" 
	Invisible prefix = "JG_Sub_FenceShadow" 
	Invisible prefix = "JG_Sub_HangingSign" 
	Invisible prefix = "JG_Sub_PillarShadows" 
