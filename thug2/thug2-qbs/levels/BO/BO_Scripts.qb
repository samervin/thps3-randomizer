				KillAllTextureSplats box = { height = 7 dist = 7 width = 7 offset = VECTOR(17.00000000000, 22.00000000000, 117.00000000000) } 
				KillAllTextureSplats box = { height = 9 dist = 7 width = 7 offset = VECTOR(230.00000000000, 31.00000000000, -133.00000000000) } 
