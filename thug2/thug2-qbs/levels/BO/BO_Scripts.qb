		ENDIF 
	ENDIF 
ENDSCRIPT

SCRIPT BO_BreakMast 
	GetBonus score = 1000 text = "Destruction Bonus" 
	Shatter { name = BO_ShatterMast 
		area = 2000 
		texture_swap = apm_Crate02_xploder02 
		variance = 1.00000000000 
		spread = 1.50000000000 
		life = 3 
		bounce = 0 
		scale = 0.40000000596 
		vel_x = 0 
		vel_y = 60 
		vel_z = 0 
	} 
	Kill name = BO_ShatterMast 
	Kill name = BO_Boat_Mast 
	SpawnSound BO_SFX_MastBreakOff 
	Kill name = BO_BoatMast_Lights 
	Kill name = TRGP_BrokenMast 
	Kill name = BO_TB_Boat_Mast_Shadow 
	Kill name = BO_Boat_RedFlag 
	BO_Broken_Mast : Rigidbody_Kick vel = VECTOR(0.00000000000, 1.00000000000, -1.00000000000) rotVel = VECTOR(1.00000000000, -1.00000000000, 1.00000000000) 
	IF NOT InMultiplayerGame 
		PlayObjectAnim name = BO_SmallEvent_Ship 
		BO_TB_Boat_Flag_01 : Rigidbody_Kick vel = VECTOR(0.00000000000, 5.00000000000, -5.00000000000) rotVel = VECTOR(-1.00000000000, 1.00000000000, 1.00000000000) 
		BO_TB_Boat_Flag_02 : Rigidbody_Kick vel = VECTOR(5.00000000000, -5.00000000000, -5.00000000000) rotVel = VECTOR(1.00000000000, 1.00000000000, -1.00000000000) 
		BO_TB_Boat_Flag_03 : Rigidbody_Kick vel = VECTOR(0.00000000000, -5.00000000000, 0.00000000000) rotVel = VECTOR(-1.00000000000, -1.00000000000, 1.00000000000) 
		BO_TB_Boat_Flag_04 : Rigidbody_Kick vel = VECTOR(-5.00000000000, 0.00000000000, -5.00000000000) rotVel = VECTOR(1.00000000000, -1.00000000000, -1.00000000000) 
		BO_TB_Boat_Flag_05 : Rigidbody_Kick vel = VECTOR(0.00000000000, 5.00000000000, -5.00000000000) rotVel = VECTOR(1.00000000000, 1.00000000000, -1.00000000000) 
		BO_TB_Boat_Flag_06 : Rigidbody_Kick vel = VECTOR(5.00000000000, -5.00000000000, -5.00000000000) rotVel = VECTOR(-1.00000000000, 1.00000000000, -1.00000000000) 
	ENDIF 
