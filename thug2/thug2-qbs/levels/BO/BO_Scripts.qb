SCRIPT BO_jump_fan 
	printf " waiting for ollie " 
	ClearExceptionGroup BO_jumpfan 
	SetException EX = SkaterJump scr = BO_jump_fan_ollie Group = BO_jumpfan 
	SetException EX = SkaterOffEdge scr = BO_jump_fan_nothing Group = BO_jumpfan 
	block 
ENDSCRIPT

SCRIPT BO_jump_fan_ollie 
	GetTriggerArray jump off 
	IF Triggertype <trigger_array> 
		trigger_jump_boost speed = 500 
	ENDIF 
ENDSCRIPT

SCRIPT BO_jump_fan_ollie_old 
	printf " ollie " 
	ClearExceptionGroup BO_jumpfan 
	trigger_jump_boost multi = 2 
	KillSpawnedscript name = BO_jump_fan 
ENDSCRIPT

SCRIPT BO_jump_fan_nothing 
