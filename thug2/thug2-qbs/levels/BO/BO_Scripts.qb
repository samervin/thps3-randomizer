SCRIPT BO_AddGoal_FindJesse 
	AddGoal_gaps { 
		version = 12 
		silent_activation 
		skater = custom 
		reward_points = 25 
		view_goals_text = BO_Gap12_Goal_Text 
		goal_description = BO_Gap12_Goal_Description 
		view_goals_tip = BO_Gap12_Goal_Tip 
		goal_flags = [ got_1 
		] 
		pro = "JesseJames" 
		full_name = "Jesse James" 
		success_node = TRG_Restart_Jeers 
		success_cam_anims = [ 
			{ virtual_cam 
				targetid = world 
				targetOffset = VECTOR(-8345.7, -1357, -9475) 
				positionOffset = VECTOR(-1582.5, -142.2, -2209.8) 
				frames = 100 
