SCRIPT BO_TagChecker01 
	ClearExceptionGroup BO_TagChecker 
	SetException EX = SkaterExitAir scr = BO_TagCheckerLand Group = BO_TagChecker 
	SetException EX = SkaterExitWallplant scr = BO_TagCheckerReplace01 Group = BO_TagChecker 
	block 
ENDSCRIPT

SCRIPT BO_TagCheckerReplace01 
	ClearExceptionGroup BO_TagChecker 
	BroadcastEvent type = GotTag 
	IF SkaterCurrentScorePotGreaterThan 20000 
		Kill name = TAG_Neversoft01 
		Kill name = THROWUP_Neversoft01 
		IF NOT IsAlive name = PIECE_Neversoft01 
			Create name = PIECE_Neversoft01 
			skater : GetGap score = 500 text = "Grafitti Masterpiece" 
		ENDIF 
	ELSE 
		IF SkaterCurrentScorePotGreaterThan 10000 
			Kill name = TAG_Neversoft01 
			IF NOT IsAlive name = PIECE_Neversoft01 
				IF NOT IsAlive name = THROWUP_Neversoft01 
					Create name = THROWUP_Neversoft01 
					skater : GetGap score = 1000 text = "Grafitti Throwup" 
				ENDIF 
			ENDIF 
		ELSE 
			IF NOT IsAlive name = PIECE_Neversoft01 
				IF NOT IsAlive name = THROWUP_Neversoft01 
					IF NOT IsAlive name = TAG_Neversoft01 
						Create name = TAG_Neversoft01 
						skater : GetGap score = 100 text = "Grafitti Tag" 
					ENDIF 
				ENDIF 
			ENDIF 
		ENDIF 
	ENDIF 
ENDSCRIPT

