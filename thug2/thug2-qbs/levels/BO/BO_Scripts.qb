SCRIPT BO_Church_Sign 
	GetTriggerArray wallplant onto 
	IF Triggertype <trigger_array> 
		SpawnSound BO_SFX_Hit_Church_Sign_01 
		GetGap score = 500 text = "Church Sign Slap" 
		ShatterAndDie name = BO_TB_Church_Sign_Shatter_02 area = 500 variance = 4 vel_x = 50 vel_y = 50 vel_z = 50 spread = 1 
		Kill name = BO_TB_Church_Sign_01 
		IF NOT IsAlive name = BO_Church_Shatter01 
			GetBonus score = 1000 text = "Destruction Bonus" 
			Create name = BO_Church_Shatter01 
			Create prefix = "Church_SmallSparkA" 
			Create prefix = "Church_SmallSparkB" 
			Create prefix = "Church_SmallSparkC" 
			Create prefix = "Church_SparksA" 
			Create prefix = "Church_SparksB" 
			Create prefix = "Church_SparksC" 
			wait 3 seconds 
			BO_ChurchSparks_Off 
		ENDIF 
	ENDIF 
ENDSCRIPT

SCRIPT BO_Church_Sign_Shattered 
	GetTriggerArray wallplant onto 
	IF Triggertype <trigger_array> 
		GetGap score = 500 text = "Church Sign Slap" 
	ENDIF 
ENDSCRIPT

SCRIPT BO_ChurchSparks_Off 
	IF IsAlive name = Church_SparksA01 
		StopParticleObject name = Church_SparksA01 
	ENDIF 
	IF IsAlive name = Church_SparksB01 
		StopParticleObject name = Church_SparksB01 
	ENDIF 
	IF IsAlive name = Church_SparksC01 
		StopParticleObject name = Church_SparksC01 
	ENDIF 
ENDSCRIPT

