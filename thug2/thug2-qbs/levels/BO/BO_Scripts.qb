SCRIPT BO_Shatter_CrowsNest 
	GetBonus score = 1000 text = "Destruction Bonus" 
	Shatter { name = <name> 
		area = 2000 
		texture_swap = apm_Crate02_xploder02 
		variance = 1.00000000000 
		spread = 1.50000000000 
		life = 3 
		bounce = 0 
		scale = 0.40000000596 
		vel_x = 0 
		vel_y = 60 
		vel_z = 0 
	} 
	Kill name = <name> 
	PlaySound HitTrafficBarrier vol = 200 
ENDSCRIPT

SCRIPT BO_Shatter_Barrels 
	GetBonus score = 1000 text = "Destruction Bonus" 
	SpawnSound BO_SFX_BarrelShatter params = { defname = <name> } 
	Shatter { name = <name> 
		area = 2000 
		texture_swap = TB_BO_Barrel_Shatter_01 
		variance = 1.00000000000 
		spread = 1.50000000000 
		life = 6 
		bounce = 0.50000000000 
		scale = 0.40000000596 
		vel_x = 0 
		vel_y = 60 
		vel_z = 0 
	} 
	Kill name = <name> 
	Kill name = <shadow> 
	IF ( ( GameModeEquals is_classic ) | ( InNetGame ) ) 
		SWITCH <name> 
			CASE BO_Classic_Barrel_01 
				goal_collect_got_object goal_id = bo_classic_goal_collect flag = got_1 
			CASE BO_Classic_Barrel_02 
				goal_collect_got_object goal_id = bo_classic_goal_collect flag = got_2 
			CASE BO_Classic_Barrel_03 
				goal_collect_got_object goal_id = bo_classic_goal_collect flag = got_3 
			CASE BO_Classic_Barrel_04 
				goal_collect_got_object goal_id = bo_classic_goal_collect flag = got_4 
			CASE BO_Classic_Barrel_05 
				goal_collect_got_object goal_id = bo_classic_goal_collect flag = got_5 
		ENDSWITCH 
	ENDIF 
	IF NOT InMultiplayerGame 
		IF NOT IsAlive name = <ring1> 
			Create name = <ring1> 
			<ring1> : Rigidbody_Kick vel = VECTOR(0.00000000000, 0.00000000000, 0.00000000000) 
		ENDIF 
		IF NOT IsAlive name = <ring2> 
			Create name = <ring2> 
			<ring2> : Rigidbody_Kick vel = VECTOR(0.00000000000, 0.00000000000, 0.00000000000) 
		ENDIF 
		IF NOT IsAlive name = <tea> 
			Create name = <tea> 
		ENDIF 
		wait 0.25000000000 seconds 
		IF IsAlive name = <tea> 
			StopParticleObject name = <tea> 
		ENDIF 
	ENDIF 
ENDSCRIPT

