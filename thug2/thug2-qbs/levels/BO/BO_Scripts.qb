	Kill prefix = "Particle_LeavesA" 
	wait 2 frames 
	Create prefix = "Particle_LeavesA" 
	wait 10 seconds 
	IF IsAlive name = Particle_LeavesA01 
		StopParticleObject name = Particle_LeavesA01 
