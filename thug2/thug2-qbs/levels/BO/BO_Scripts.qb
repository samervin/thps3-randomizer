SCRIPT BO_SkateStoppers 
	IF NOT walking 
		Get_Current_Skater_Name 
		IF IsSkaterOnVehicle 
			IF ( <name> = segwayrider ) 
				printf "kill stopper" 
				GoalManager_SetGoalFlag name = BO_Goal_gaps15 <flag> 1 
				PlaySound SK6_BO_GrindblockerPop vol = 200 
				ShatterAndDie name = <stopper> area = 2000 variance = 4 vel_x = 50 vel_y = 50 vel_z = 50 spread = 1 
			ELSE 
				MakeSkaterGoto vehicle_bail 
			ENDIF 
		ELSE 
			MakeSkaterGoto PedKnockdown 
		ENDIF 
	ENDIF 
ENDSCRIPT

