SCRIPT BO_Blader_Trick_Dummy 
	TRG_Blader_Trick_Dummy : BO_Blader_Trick_Dummy2 
ENDSCRIPT

SCRIPT BO_Blader_Trick_Dummy2 
	Obj_ClearExceptions 
	ClearExceptionGroup BO_Blader_Trick_Dummy 
	Obj_LockToObject Objectname = TRG_Ped_RollerBlader VECTOR(0.00000000000, 0.00000000000, 0.00000000000) 
	printf "BO_Blader_Trick_Dummy" 
	Obj_SetInnerRadius 7 
	Obj_SetException EX = ObjectInRadius scr = BO_Blader_Trick_Near 
ENDSCRIPT

SCRIPT BO_Blader_Trick_Near 
	Obj_ClearExceptions 
	ClearExceptionGroup BO_Blader_Trick_Dummy 
	UnSetFlag flag = FLAG_BO_GOT_TRICK 
	printf "BO_Blader_Trick_Near" 
	Obj_SetOuterRadius 8 
	Obj_SetException EX = ObjectOutofRadius scr = BO_Blader_Trick_Dummy 
	SetException EX = SkaterEnterAir scr = BO_Blader_Trick_InAir Group = BO_Blader_Trick_Dummy 
ENDSCRIPT

SCRIPT BO_Blader_Trick_InAir 
	Obj_ClearExceptions 
	ClearExceptionGroup BO_Blader_Trick_Dummy 
	SetException EX = SkaterLanded scr = BO_Blader_Trick_Land Group = BO_Blader_Trick_Dummy 
	skater : GetGap score = 100 text = "Blader Hop" 
	BEGIN 
		wait 1 frame 
		GetNumberOfTrickOccurrences TrickText = "Kickflip" 
		Printstruct <...> 
		IF ( <Number_Of_Occurrences> > 0 ) 
			printf "tricky" 
			SetFlag flag = FLAG_BO_GOT_TRICK 
		ENDIF 
	REPEAT 
ENDSCRIPT

SCRIPT BO_Blader_Trick_Land 
	Obj_ClearExceptions 
	ClearExceptionGroup BO_Blader_Trick_Dummy 
	printf "BO_Blader_Trick_Land" 
	IF GameModeEquals is_career 
		IF GetFlag flag = FLAG_BO_GOT_TRICK 
			GetCurrentSkaterProfileIndex 
			GetSkaterProfileInfo player = <currentSkaterProfileIndex> 
			<Blader_Flips> = 0 
			IF NOT GoalManager_GoalIsLocked name = BO_Goal_Gaps11 
				IF ( <skater_family> = family_pro ) 
					printf "Check it" 
					IF NOT GoalManager_GoalFlagSet name = BO_Goal_Gaps11 flag = got_1 skater = pro 
						GoalManager_SetGoalFlag name = BO_Goal_Gaps11 got_1 1 skater = pro 
						printf "Set It" 
					ENDIF 
				ELSE 
					IF ( <name> = custom ) 
						IF NOT GoalManager_GoalFlagSet name = BO_Goal_Gaps11 flag = got_1 skater = <name> 
							GoalManager_SetGoalFlag name = BO_Goal_Gaps11 got_1 1 skater = <name> 
						ENDIF 
					ELSE 
						IF ( <name> = benfranklin ) 
							IF NOT GoalManager_GoalFlagSet name = BO_Goal_Gaps11 flag = got_1 skater = <name> 
								GoalManager_SetGoalFlag name = BO_Goal_Gaps11 got_1 1 skater = <name> 
							ENDIF 
						ENDIF 
					ENDIF 
				ENDIF 
				IF GoalManager_GoalFlagSet name = BO_Goal_Gaps11 flag = got_1 skater = pro 
					<Blader_Flips> = ( <Blader_Flips> + 1 ) 
				ENDIF 
				IF GoalManager_GoalFlagSet name = BO_Goal_Gaps11 flag = got_1 skater = custom 
					<Blader_Flips> = ( <Blader_Flips> + 1 ) 
				ENDIF 
				IF GoalManager_GoalFlagSet name = BO_Goal_Gaps11 flag = got_1 skater = benfranklin 
					<Blader_Flips> = ( <Blader_Flips> + 1 ) 
				ENDIF 
				SWITCH <Blader_Flips> 
					CASE 0 
						printf "0" 
					CASE 1 
						create_panel_message { text = "1 of 3 Blader Kickflips" style = goal_collect_text } 
					CASE 2 
						create_panel_message { text = "2 of 3 Blader Kickflips" style = goal_collect_text } 
					DEFAULT 
				ENDSWITCH 
			ENDIF 
			UnSetFlag flag = FLAG_BO_GOT_TRICK 
		ENDIF 
	ENDIF 
	BO_Blader_Trick_Dummy 
ENDSCRIPT

SCRIPT BO_FireProxim 
	Obj_ClearExceptions 
	Obj_SetInnerRadius 5 
	SetException EX = ObjectInRadius scr = BO_FireProximNear 
	printf "Not Near Fire" 
ENDSCRIPT

SCRIPT BO_FireProximNear 
	Obj_ClearExceptions 
	Obj_SetOuterRadius 7 
	SetException EX = ObjectOutofRadius scr = BO_FireProxim 
	printf "Near Fire" 
	BEGIN 
		IF skater : animequals [ Standing_Tag2 ] 
			printf "Whoosh" 
			Create prefix = "FireB" 
			wait 1 second 
			Kill prefix = "FireB" 
		ENDIF 
		wait 2 frames 
	REPEAT 
ENDSCRIPT

