SCRIPT BO_DuckSkitch 
	IF GameModeEquals is_career 
		IF NOT GoalManager_GoalIsLocked name = BO_Goal_Gaps6 
			printf "Skitching a duck" 
			BroadcastEvent type = BO_DuckSkitch 
		ENDIF 
	ENDIF 
ENDSCRIPT

SCRIPT BO_DuckManager_Wait 
	ClearExceptionGroup DuckSkitch 
	SetException EX = BO_DuckSkitch scr = BO_DuckManager_Skitching 
	printf "DuckManager_Wait" 
	IF ObjectExists id = current_goal 
		DestroyScreenElement id = current_goal 
	ENDIF 
	block 
ENDSCRIPT

SCRIPT BO_DuckManager_Skitching 
	ClearExceptionGroup DuckSkitch 
	SetException EX = SkaterExitSkitch scr = BO_DuckManager_Wait 
	IF NOT GoalManager_HasWonGoal name = BO_Goal_Gaps6 
		printf "DuckManager_Skitching" 
		Skitch_Timer = 20 
		BEGIN 
			printf "Timer Loop" 
			FormatText TextName = SkitchText "Skitch a Seaworthy vehicle\\n%a seconds left" a = <Skitch_Timer> 
			Create_Panel_Block id = current_goal text = <SkitchText> style = goal_collect_text 
			Skitch_Timer = ( <Skitch_Timer> -1 ) 
			wait 1 second 
		REPEAT 20 
		IF GoalManager_GoalExists name = BO_Goal_Gaps6 
			GoalManager_SetGoalFlag name = BO_Goal_Gaps6 got_1 1 
		ENDIF 
		Die 
	ENDIF 
ENDSCRIPT

SCRIPT BO_BenWaiting 
	ClearExceptionGroup BenWaiting 
	Obj_PlayAnim Anim = WStand cycle 
	WaitForEvent type = BO_NearBen 
	Obj_PlayStream Franklin_Escape vol = 400 dropoff = 100 priority = 100 
	Obj_MoveToLink speed = 10 
	Obj_CycleAnim Anim = WStandToRun 
	Obj_PlayAnim Anim = WRun cycle 
	Obj_WaitMove 
	Die 
ENDSCRIPT

