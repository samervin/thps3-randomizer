	IF IsSkaterOnVehicle 
		MakeSkaterGoto vehicle_bail 
		PlayStream SK6_BO_DieBySubway vol = 200 priority = 100 
		SK3_Killskater nodename = TRG_Restart_SubwayCenter 
	ELSE 
		PlayStream SK6_BO_DieBySubway vol = 200 priority = 100 
		SK3_Killskater nodename = TRG_Restart_SubwayCenter 
	ENDIF 
ENDSCRIPT

