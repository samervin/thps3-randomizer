SCRIPT BO_Initializer 
	BO_Library_Off 
	BO_Subway_Off 
	IF GameModeEquals is_classic 
		Kill name = TRG_HalfpipeRV 
		Kill prefix = "TRG_Pigeon_Normal" 
		Kill prefix = "BO_Barrel_Boat" 
	ENDIF 
	IF GameModeEquals is_career 
		Create name = TRG_Ped_Hawk 
		Create name = TRG_Ped_TeammatePro 
		IF GoalManager_HasWonGoal name = BO_Goal_Gaps10 
			Create name = BO_AS_MasterPiece_final01 
		ENDIF 
		IF GoalManager_HasWonGoal name = BO_Goal_Gaps8 
			Create prefix = "SPAT_COVER" 
		ELSE 
			Create prefix = "SPAT" 
			Create prefix = "TRGP_Graffiti_Hint" 
			Kill prefix = "SPAT_COVER" 
		ENDIF 
		IF NOT GoalManager_HasWonGoal name = BO_Goal_SkateTheLine4 
			Create name = TRG_Race_Ped 
			Create name = Paulie_Collision 
		ENDIF 
		IF GoalManager_HasWonGoal name = BO_Goal_Gaps 
			Create name = TRG_Ped_BenFranklin 
			Kill name = TRG_Ped_BenWaiting 
		ELSE 
			Create name = TRG_Ped_BenWaiting 
		ENDIF 
		IF GoalManager_HasWonGoal name = BO_Goal_gaps15 
		ELSE 
			Create prefix = "BO_SkateStopper" 
			Create name = TRG_Ped_Hint_Skatestopper 
		ENDIF 
		IF GoalManager_HasWonGoal name = BO_Goal_Gaps12 
			Create name = TRG_Ped_Segway 
			Kill name = TRG_Ped_Hint_Jeers 
		ELSE 
			Create name = TRG_Ped_Hint_Jeers 
		ENDIF 
		IF NOT GoalManager_HasWonGoal name = BO_Goal_Gaps7 
			Create name = TRG_Gurney_Ghost 
			Create name = Gurney 
			Create name = TRG_Ped_Sick_Kid 
		ENDIF 
		IF GoalManager_HasWonGoal name = BO_Goal_Gaps14 
			BO_RV_Traffic 
		ENDIF 
		IF NOT GoalManager_HasWonGoal name = BO_Goal_Gaps8 
			Create name = TRG_Ped_Hint_Graf 
			Create prefix = "TRGP_Graffiti_Hint" 
		ENDIF 
		IF NOT GoalManager_HasWonGoal name = BO_Goal_Gaps13 
			IF NOT GoalManager_GoalIsLocked name = BO_Goal_Gaps13 
				IF NOT IsAlive name = TRG_Ped_Hint_Washington 
					Create name = TRG_Ped_Hint_Washington 
				ENDIF 
			ENDIF 
		ENDIF 
		IF NOT GoalManager_HasWonGoal name = BO_Goal_HighCombo2 
			IF NOT GoalManager_GoalIsLocked name = BO_Goal_HighCombo2 
				IF NOT IsAlive name = TRG_Ped_Hint_Fire 
					Create name = TRG_Ped_Hint_Fire 
				ENDIF 
			ENDIF 
		ENDIF 
		IF NOT GoalManager_HasWonGoal name = BO_Goal_SkateTheLine2 
			IF NOT GoalManager_GoalIsLocked name = BO_Goal_SkateTheLine2 
				IF NOT IsAlive name = TRG_Ped_Hint_Metals 
					Create name = TRG_Ped_Hint_Metals 
				ENDIF 
			ENDIF 
		ENDIF 
		IF NOT GoalManager_HasWonGoal name = BO_Goal_SkateTheLine3 
			IF NOT GoalManager_GoalIsLocked name = BO_Goal_SkateTheLine3 
				IF NOT IsAlive name = TRG_Ped_Hint_Liberty 
					Create name = TRG_Ped_Hint_Liberty 
				ENDIF 
			ENDIF 
		ENDIF 
	ENDIF 
ENDSCRIPT

