SCRIPT BO_2d_sign_element_create parent = menu3d_anchor 
	IF GetGlobalFlag flag = SCREEN_MODE_WIDE 
		<offset> = PAIR(-8.00000000000, 0.00000000000) 
	ELSE 
		<offset> = PAIR(0.00000000000, 0.00000000000) 
	ENDIF 
	CreateScreenElement { 
		type = SpriteElement 
		parent = <parent> 
		texture = BO_icon_1 
		id = BO_icon_smiley 
		scale = PAIR(1.54999995232, 1.54999995232) 
		rgba = [ 128 128 128 50 ] 
		pos = ( PAIR(62.00000000000, 110.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ left top ] 
		z_priority = -51 
	} 
	CreateScreenElement { 
		type = SpriteElement 
		parent = <parent> 
		texture = BO_icon_2 
		id = BO_icon_deck 
		scale = PAIR(2.29999995232, 1.39999997616) 
		rgba = [ 128 128 128 60 ] 
		pos = ( PAIR(-23.00000000000, 208.00000000000) + <offset> ) 
		rot_angle = 5 
		just = [ left top ] 
		z_priority = -51 
	} 
	RunScriptOnScreenElement id = BO_icon_smiley do_random_effect_paused params = { id = <id> } 
	RunScriptOnScreenElement id = BO_icon_deck do_random_effect_paused params = { id = <id> } 
ENDSCRIPT

BO_StateLogic_Table = { 
	BO_STATE_drummer_drumwalking = { 
		ped_update_type = generic_move_update 
		script_ped_state = BO_STATECONTROL_drummer_drumwalking 
	} 
	BO_STATE_drummer_drumstanding = { 
		ped_update_type = no_move_update 
		script_ped_state = BO_STATECONTROL_drummer_drumstanding 
	} 
	BO_STATE_rollerblading = { 
		ped_update_type = generic_move_update 
		script_ped_state = BO_STATECONTROL_rollerblading 
	} 
} 
BO_PaulieLogic_Table = { 
	BO_STATE_Paulie_Waiting = { 
		script_ped_state = BO_STATECONTROL_Paulie_Waiting 
	} 
	STATE_getattention = { 
		script_ped_state = BO_STATECONTROL_Paulie_GetAttention 
	} 
} 
SCRIPT PEDAI_DrummerStopWaypoint 
	Ped_SetLogicState BO_STATE_drummer_drumstanding Table = BO_StateLogic_Table 
ENDSCRIPT

SCRIPT BO_STATECONTROL_drummer_drumwalking 
	GetTags 
	OBJ_EnableAnimBlending enabled = 1 
	BEGIN 
		RANDOM(1, 1, 1, 1, 1) 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Sldr_Marching01 blendperiod = 0 
			change DrumPartialNumber = 1 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Sldr_Marching01 PartialAnimOverlay = Ped_Sldr_Marching02_P 
			change DrumPartialNumber = 2 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Sldr_Marching01 PartialAnimOverlay = Ped_Sldr_Marching03_P 
			change DrumPartialNumber = 3 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Sldr_Marching01 PartialAnimOverlay = Ped_Sldr_Marching04_P 
			change DrumPartialNumber = 4 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Sldr_Marching01 PartialAnimOverlay = Ped_Sldr_Marching06_P 
			change DrumPartialNumber = 6 
		RANDOMEND 
		OBJ_waitanimfinished 
	REPEAT 
ENDSCRIPT

SCRIPT BO_STATECONTROL_drummer_drumstanding 
	Ped_StopMoving 
	PlayAnimWithPartialAnimIfExists Anim = Ped_Sldr_Stop01 
	OBJ_waitanimfinished 
	GetRandomValue name = RepeatCount a = 3 b = 6 resolution = 3 Integer 
	BEGIN 
		RANDOM(1, 1, 1, 1, 1) 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Sldr_Drumming02 
			change DrumPartialNumber = 2 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Sldr_Drumming02 PartialAnimOverlay = Ped_Sldr_Drumming04_P 
			change DrumPartialNumber = 4 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Sldr_Drumming02 PartialAnimOverlay = Ped_Sldr_Drumming06_P 
			change DrumPartialNumber = 6 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Sldr_Drumming02 PartialAnimOverlay = Ped_Sldr_Drumming08_P 
			change DrumPartialNumber = 8 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Sldr_Drumming02 PartialAnimOverlay = Ped_Sldr_Drumming10_P 
			change DrumPartialNumber = 10 
		RANDOMEND 
		OBJ_waitanimfinished 
	REPEAT <RepeatCount> 
	Ped_StartMoving 
	PlayAnimWithPartialAnimIfExists Anim = Ped_Sldr_Start 
	OBJ_waitanimfinished 
	Ped_SetLogicState BO_STATE_drummer_drumwalking Table = BO_StateLogic_Table 
ENDSCRIPT

SCRIPT BO_STATECONTROL_rollerblading 
	BEGIN 
		RANDOM(3, 1, 1, 1, 1) 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Rollerblader_SkateCycle 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Rollerblader_HeelClick 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_RollerBlader_ParadingAss 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Rollerblader_StartHipPrance 
			OBJ_waitanimfinished 
			GetRandomValue name = RepeatCount a = 1 b = 3 resolution = 3 Integer 
			BEGIN 
				PlayAnimWithPartialAnimIfExists Anim = Ped_Rollerblader_HipPrance 
				OBJ_waitanimfinished 
			REPEAT <RepeatCount> 
			PlayAnimWithPartialAnimIfExists Anim = Ped_Rollerblader_StopHipPrance 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Rollerblader_Spin2Back 
			OBJ_waitanimfinished 
			GetRandomValue name = RepeatCount a = 1 b = 3 resolution = 3 Integer 
			BEGIN 
				PlayAnimWithPartialAnimIfExists Anim = Ped_Rollerblader_BackSkate 
				OBJ_waitanimfinished 
			REPEAT <RepeatCount> 
			PlayAnimWithPartialAnimIfExists Anim = Ped_Rollerblader_Spin2Front 
		RANDOMEND 
		OBJ_waitanimfinished 
	REPEAT 
ENDSCRIPT

SCRIPT BO_STATECONTROL_Paulie_Waiting 
	printf "Paulie Chillin" 
	Ped_Utils_SetMiscEventHandlers 
	PlayAnimWithPartialAnimIfExists Anim = Wheelchair_Idle cycle 
ENDSCRIPT

SCRIPT BO_STATECONTROL_Paulie_GetAttention 
	printf "Paulie Attention" 
	Get_Current_Skater_Name 
	IF ( <name> = segwayrider ) 
		printf "Race Paulie Biotch!" 
		setup_ped_speech { ped_id = TRG_Race_Ped 
			inner_radius = 7 
			outer_radius = 8 
			accept_text = "Press \\m5 to Race." 
			activation_script = BO_Race_Ped_Go 
		} 
	ELSE 
		printf "Talk to Paulie" 
		setup_ped_speech { ped_id = TRG_Race_Ped 
			inner_radius = 7 
			outer_radius = 8 
			accept_text = "Press \\m5 to Talk." 
			activation_script = BO_Paulie_TalkShit 
			dont_deactivate_goals 
		} 
	ENDIF 
	PlayAnimWithPartialAnimIfExists Anim = Wheelchair_Attention 
	OBJ_waitanimfinished 
	BEGIN 
		IF NOT Obj_ObjectInAttentionRadius 
			printf "Paulie losing attention" 
			Ped_Utils_SetMiscEventHandlers 
			Ped_StateLogic_SetDefaultState 
			RETURN 
		ENDIF 
		RANDOM(1, 3) 
			RANDOMCASE 
			PlayAnimWithPartialAnimIfExists Anim = Wheelchair_Attention 
			RANDOMCASE 
			PlayAnimWithPartialAnimIfExists Anim = Wheelchair_Idle 
		RANDOMEND 
		OBJ_waitanimfinished 
	REPEAT 
ENDSCRIPT

SCRIPT BO_Paulie_TalkShit 
	printf "PUALIE TALKS SOME SHIT!!" 
	IF ScreenElementExists id = ped_speech_dialog 
		speech_box_exit anchor_id = ped_speech_dialog 
	ENDIF 
	unpauseskaters 
	RANDOM(1, 1, 1) 
		RANDOMCASE hint_text = "Come back when you\'re riding something with batteries, bitch." 
		vo = Paulie_NoRace01 
		RANDOMCASE hint_text = "A skateboard is no match for a sweet ride like mine!" 
		vo = Paulie_NoRace02 
		RANDOMCASE hint_text = "Come back when you\'re riding something with real power, slacker." 
		vo = Paulie_NoRace03 
	RANDOMEND 
	create_speech_box { 
		anchor_id = ped_hint_dialog 
		text = <hint_text> 
		no_pad_choose 
		no_pad_start 
		bg_rgba = [ 100 100 100 128 ] 
		text_rgba = [ 128 128 128 128 ] 
		pos = PAIR(320.00000000000, 400.00000000000) 
		bg_x_scale = 1.39999997616 
		z_priority = 5 
	} 
	IF GotParam vo 
		TRG_Race_Ped : Obj_PlayStream <vo> vol = GlobalHintVOVol dropoff = GlobalHintVODropoff 
	ENDIF 
	TRG_Race_Ped : OBJ_waitanimfinished 
	TRG_Race_Ped : PlayAnimWithPartialAnimIfExists Anim = Wheelchair_Idle 
	TRG_Race_Ped : OBJ_waitanimfinished 
	TRG_Race_Ped : PlayAnimWithPartialAnimIfExists Anim = Wheelchair_Spin 
	TRG_Race_Ped : OBJ_waitanimfinished 
	IF ObjectExists id = ped_hint_dialog 
		DestroyScreenElement id = ped_hint_dialog 
	ENDIF 
	TRG_Race_Ped : Ped_SetLogicState BO_STATE_Paulie_Waiting Table = BO_StateLogic_Table 
	unpauseskaters 
ENDSCRIPT

SCRIPT BO_Musicplay 
	TRG_MusicPed_On : Ped_SetLogicState ALL_STATE_guitarist_playing Table = ALL_StateLogic_Table 
	unpauseskaters 
ENDSCRIPT

SCRIPT BO_MusicStop 
	TRG_MusicPed_On : Ped_SetLogicState ALL_STATE_guitarist Table = ALL_StateLogic_Table 
	unpauseskaters 
ENDSCRIPT

SCRIPT CutKey_BO_LevelEvent_580_Safe 
	CreateFastParticleSystem name = xploder02 params_script = apm_BOc1_xploder02_fast_particle_params attachObjID = Xploder_dummy01 
	CreateFastParticleSystem name = xploder params_script = apm_BOc1_xploder02_fast_particle_params attachObjID = Xploder_dummy01 
	CreateFastParticleSystem name = xploder_smoke01 params_script = apm_BOc1_xploder_smoke1_fast_particle_params attachObjID = Xploder_dummy01 
	CreateFastParticleSystem name = xploder_Debris01 params_script = apm_BOc_xploder_debis01_fast_particle_params attachObjID = Xploder_dummy01 
	CreateFastParticleSystem name = xploder_smoke3 params_script = apm_BOc_xploder_smoke3_fast_particle_params attachObjID = Xploder_dummy01 
	Sparklies_dummy01 : CreateFlexibleParticleSystem name = xploder_sparklies params_script = apm_BOc_sparklies_particle_params 
	skater : Vibrate_Controller_Safe actuator = 0 percent = 100 
	wait 5 gameframes 
ENDSCRIPT

SCRIPT CutKey_BO_LevelEvent_591_Safe 
	destroyfastparticlesystem name = xploder02 attachObjID = Xploder_dummy01 
	destroyfastparticlesystem name = xploder attachObjID = Xploder_dummy01 
	destroyfastparticlesystem name = xploder_smoke01 attachObjID = Xploder_dummy01 
	destroyfastparticlesystem name = xploder_Debris01 attachObjID = Xploder_dummy01 
	destroyfastparticlesystem name = xploder_Smoke4 attachObjID = Xploder_dummy01 
	skater : Vibrate_Controller_Safe actuator = 0 percent = 0 
ENDSCRIPT


