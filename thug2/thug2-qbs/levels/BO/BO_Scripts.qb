		Create name = Paulie_Collision 
	ENDIF 
ENDSCRIPT

SCRIPT BO_Race_Ped_Go 
	Obj_ClearExceptions 
	Get_Current_Skater_Name 
	IF NOT GoalManager_HasWonGoal name = BO_Goal_SkateTheLine4 
		IF ( <name> = segwayrider ) 
			TRG_Race_Ped : Obj_SetInnerRadius 0 
			TRG_Race_Ped : Obj_SetOuterRadius 0 
			Kill name = Paulie_Collision 
			GoalManager_SetGoalFlag name = BO_Goal_SkateTheLine4 got_1 1 
			StopStream SK6_BO_Paulie_Race_Fail 
			TRG_Race_Ped : Obj_PlayStream SK6_BO_PaulieWheelchairGoal vol = 200 priority = 102 dropoff = 500 dropoff_function = exponential 
			unpauseskaters 
			TRG_Race_Ped : Ped_initAI skater speed = 100 skater_override_anim = Wheelchair_Idle 
		ELSE 
			wait 1 seconds 
			unpauseskaters 
			TRG_Race_Ped : Ped_SetLogicState BO_STATE_Paulie_Waiting 
		ENDIF 
	ELSE 
		wait 1 seconds 
		TRG_Race_Ped : Ped_SetLogicState BO_STATE_Paulie_Waiting 
		unpauseskaters 
	ENDIF 
ENDSCRIPT

