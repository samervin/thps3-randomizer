SCRIPT BO_Intro_Line1 
	TRG_Ped_Hawk : Obj_PlayFam BO_Intro_01_Lip vol = 160 priority = StreamPriorityHighest 
ENDSCRIPT

SCRIPT BO_Intro_Line2 
	TRG_Ped_Hawk : Obj_PlayFam BO_Intro_02_Lip vol = 160 priority = StreamPriorityHighest 
ENDSCRIPT

SCRIPT BO_Intro_Line3 
	TRG_Ped_Hawk : Obj_PlayFam BO_Intro_03_Lip vol = 160 priority = StreamPriorityHighest 
ENDSCRIPT

SCRIPT BO_Setup 
	BO_CreateCars 
	BO_CreatePeds all 
	BO_Initializer 
ENDSCRIPT

SCRIPT BO_startup 
	LoadAsset "levels\\BO\\CAM_ComboBench.ska" desc = CAM_ComboBench 
	LoadAsset "levels\\BO\\CAM_SkateStoppers.ska" desc = CAM_SkateStoppers 
	LoadAsset "levels\\BO\\CAM_Tag.ska" desc = CAM_Tag 
	IF NOT InNetGame 
		LoadAsset "cutscenes\\BO_SmallEvent_Scaffold.cut" desc = BO_SmallEvent_Scaffold 
	ENDIF 
	LoadAsset "cutscenes\\BO_SmallEvent_Ship.cut" desc = BO_SmallEvent_Ship 
	LoadAsset "models\\gameobjects\\projectiles\\apple\\apple.tex" 
	LoadAsset "models\\gameobjects\\projectiles\\apple\\apple.mdl" parent = %"models\gameobjects\projectiles\apple\apple.tex" 
	IF GameModeEquals is_career 
		LoadAsset "models\\veh\\veh_gurney\\veh_gurney.tex" 
		LoadAsset "models\\veh\\veh_gurney\\veh_gurney.skin" parent = %"models\veh\veh_gurney\veh_gurney.tex" 
	ENDIF 
	IF InNetGame 
		LoadAsset "models\\animals\\anl_pigeon\\anl_pigeon.tex" 
		LoadAsset "models\\animals\\anl_pigeon\\anl_pigeon.skin" parent = %"models\animals\anl_pigeon\anl_pigeon.tex" 
		animload_anl_pigeon 
	ENDIF 
	LoadSkeleton name = "skeletons/CS_ShipEvent_Rope_R.ske" CS_ShipEvent_Rope_R 
	LoadSkeleton name = "skeletons/CS_ShipEvent_Rope_L.ske" CS_ShipEvent_Rope_L 
	LoadSkeleton name = "skeletons/CS_ShipEvent_Rope_F.ske" CS_ShipEvent_Rope_F 
	LoadSkeleton name = "skeletons/CS_ShipEvent_Rope_B.ske" CS_ShipEvent_Rope_B 
ENDSCRIPT

SCRIPT BO_KillCreate_NetGeo 
	IF ( ( InMultiplayerGame ) | ( InNetGame ) ) 
	ENDIF 
ENDSCRIPT

SCRIPT BO_Goals 
	IF InMultiplayerGame 
		add_multiplayer_mode_goals 
	ENDIF 
	IF NOT InSplitScreenGame 
		IF ( ( GameModeEquals is_classic ) | ( InNetGame ) ) 
			printf "adding classic goals" 
			AddGoal_HighScore { 
				unlimited_time 
				classic_mode_goal 
				score = BO_Classic_HighScore 
				goal_text = BO_Classic_HighScore_Text 
				view_goals_text = BO_Classic_HighScore_Text 
				view_goals_cameras = [ { 
						name = CAM_Classic_Intro01 
						frames = 1200 
						skippable = 1 
					} 
				] 
				difficulty_level_params = [ 
					{ score = BO_Classic_Easy_HighScore 
						goal_text = BO_Classic_Easy_HighScore_Text 
						view_goals_text = BO_Classic_Easy_HighScore_Text 
					} 
					{ score = BO_Classic_HighScore 
						goal_text = BO_Classic_HighScore_Text 
						view_goals_text = BO_Classic_HighScore_Text 
					} 
				] 
			} 
			AddGoal_ProScore { 
				unlimited_time 
				classic_mode_goal 
				difficulty_level_params = [ 
					{ 
						score = BO_Classic_Easy_ProScore 
						goal_text = BO_Classic_Easy_ProScore_Text 
						view_goals_text = BO_Classic_Easy_ProScore_Text 
					} 
					{ 
						score = BO_Classic_ProScore 
						goal_text = BO_Classic_ProScore_Text 
						view_goals_text = BO_Classic_ProScore_Text 
					} 
				] 
			} 
			AddGoal_SickScore { 
				unlimited_time 
				classic_mode_goal 
				difficulty_level_params = [ 
					{ 
						score = BO_Classic_Easy_SickScore 
						goal_text = BO_Classic_Easy_SickScore_Text 
						view_goals_text = BO_Classic_Easy_SickScore_Text 
					} 
					{ 
						score = BO_Classic_SickScore 
