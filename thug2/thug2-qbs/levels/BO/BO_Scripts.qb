			KillAllTextureSplats box = { height = 7 dist = 7 width = 7 offset = VECTOR(17.00000000000, 32.00000000000, -82.00000000000) } 
			KillAllTextureSplats box = { height = 7 dist = 7 width = 7 offset = VECTOR(17.00000000000, 22.00000000000, 117.00000000000) } 
