SCRIPT BO_SwitchSkaters 
	KillSpawnedscript name = BO_Spawn_SwitchSkaters 
	SpawnSkaterScript BO_Spawn_SwitchSkaters 
ENDSCRIPT

SCRIPT BO_Spawn_SwitchSkaters 
	wait 2 frames 
	Kill prefix = "TRG_Ped_Gurney" 
	pulse_blur 
	swap_skaters_get_current_name 
	SWITCH <name> 
		CASE custom 
			BO_Segway_ParticlesOff 
			IF NOT GoalManager_HasWonGoal name = BO_Goal_Gaps7 
				IF NOT IsAlive name = TRG_Gurney_Ghost 
					Create name = TRG_Gurney_Ghost 
					printf "Fuckup A" 
				ENDIF 
			ENDIF 
			printf "custom" 
			BO_Unlock_You_Goals 
			BO_SkateStopper_Hint_Check 
		CASE benfranklin 
			BO_Segway_ParticlesOff 
			SetGlobalFlag flag = GUEST_FOUND_BENFRANKLIN 
			SetGlobalFlag flag = SKATER_UNLOCKED_BENFRANKLIN 
			BO_Unlock_Ben_Goals 
			printf "benfranklin" 
			IF NOT GoalManager_HasWonGoal name = BO_Goal_Gaps7 
				IF NOT IsAlive name = TRG_Gurney_Ghost 
					Create name = TRG_Gurney_Ghost 
					printf "Fuckup B" 
				ENDIF 
			ENDIF 
			BO_SkateStopper_Hint_Check 
		CASE pro_teammate 
			SetGlobalFlag flag = PRO_FOUND_01 
			BO_Segway_ParticlesOff 
			BO_Unlock_Pro_Goals 
			printf "muska" 
			IF NOT GoalManager_HasWonGoal name = BO_Goal_Gaps7 
				IF NOT IsAlive name = TRG_Gurney_Ghost 
					Create name = TRG_Gurney_Ghost 
					printf "Fuckup C" 
				ENDIF 
			ENDIF 
			BO_SkateStopper_Hint_Check 
		CASE segwayrider 
			SetGlobalFlag flag = GUEST_FOUND_JESSEJAMES 
			BO_Unlock_Segway_Goals 
			IF NOT IsAlive name = TRG_BO_CarHopDummy 
				Create name = TRG_BO_CarHopDummy 
			ENDIF 
			IF NOT GoalManager_HasWonGoal name = BO_Goal_SkateTheLine4 
				IF NOT IsAlive name = TRG_Race_Ped 
					Create name = TRG_Race_Ped 
					Create name = Paulie_Collision 
				ENDIF 
			ENDIF 
			Kill name = TRG_Gurney_Ghost 
			printf "segwayrider" 
			BO_SkateStopper2_Hint_Check 
		DEFAULT 
			BO_Segway_ParticlesOff 
			printf "default" 
	ENDSWITCH 
ENDSCRIPT

SCRIPT BO_SkateStopper_Hint_Check 
	IF NOT GoalManager_GoalIsLocked name = BO_Goal_gaps15 
		IF NOT GoalManager_HasWonGoal name = BO_Goal_gaps15 
			Kill name = TRG_Ped_Hint_Skatestopper2 
			IF NOT IsAlive name = TRG_Ped_Hint_Skatestopper 
				Create name = TRG_Ped_Hint_Skatestopper 
			ENDIF 
		ENDIF 
	ENDIF 
ENDSCRIPT

SCRIPT BO_SkateStopper2_Hint_Check 
	IF NOT GoalManager_GoalIsLocked name = BO_Goal_gaps15 
		IF NOT GoalManager_HasWonGoal name = BO_Goal_gaps15 
			Kill name = TRG_Ped_Hint_Skatestopper 
			IF NOT IsAlive name = TRG_Ped_Hint_Skatestopper2 
				Create name = TRG_Ped_Hint_Skatestopper2 
			ENDIF 
		ENDIF 
	ENDIF 
ENDSCRIPT

SCRIPT BO_Goat 
	BEGIN 
		Obj_CycleAnim Anim = RANDOM(1, 1) RANDOMCASE Idle RANDOMCASE Idle2 RANDOMEND numcycles = RANDOM(1, 1) RANDOMCASE 1 RANDOMCASE 2 RANDOMEND 
	REPEAT 
ENDSCRIPT

SCRIPT BO_Segway_ParticlesOn 
	CreateFlexibleParticleSystem name = Segway2A params_script = APM_FLAMING_seg2a_particle_params 
	CreateFlexibleParticleSystem name = Segway2B params_script = APM_FLAMING_seg2b_particle_params 
ENDSCRIPT

SCRIPT BO_Segway_ParticlesOff 
	DestroyFlexibleParticleSystem name = Segway2A 
	DestroyFlexibleParticleSystem name = Segway2B 
ENDSCRIPT

SCRIPT BO_Talking 
	Obj_CycleAnim Anim = Ped_M_Talk2_RightHere 
	Obj_CycleAnim Anim = Ped_M_Talk2_MixIt 
	Obj_CycleAnim Anim = Ped_M_Talk2_SureThing 
	Obj_CycleAnim Anim = Ped_M_Talk2_Idle2 
