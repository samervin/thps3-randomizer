SCRIPT BO_BeatBoxScript 
	BEGIN 
		Wait 0.02999999933 second 
		Obj_ApplyScaling { y = 0.94999998808 z = 0.94999998808 } 
		Wait 0.30000001192 second 
		Obj_ApplyScaling { y = 1.00000000000 z = 1.00000000000 } 
		Wait 0.00999999978 second 
		Obj_ApplyScaling { y = 0.98000001907 z = 0.98000001907 } 
		Wait 0.00999999978 second 
		Obj_ApplyScaling { y = 1.00000000000 z = 1.00000000000 } 
		Wait 0.00999999978 second 
	REPEAT 
ENDSCRIPT

