		BEGIN 
			RANDOM_NO_REPEAT(1, 1, 1, 1, 1, 1, 1, 1, 1) 
				RANDOMCASE Obj_PlayStream SK6_BO_Bird09 vol = BO_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_CommonsTree04 RANDOMCASE TRG_SFX_SOB_CommonsTree05 RANDOMCASE TRG_SFX_SOB_CommonsTree06 RANDOMEND priority = StreamPriorityLow 
				wait 5 seconds 
				RANDOMCASE Obj_PlayStream SK6_BO_Bird10 vol = BO_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_CommonsTree04 RANDOMCASE TRG_SFX_SOB_CommonsTree05 RANDOMCASE TRG_SFX_SOB_CommonsTree06 RANDOMEND priority = StreamPriorityLow 
				wait 7 seconds 
