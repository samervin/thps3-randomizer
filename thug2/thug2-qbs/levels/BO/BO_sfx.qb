SCRIPT BO_SFX_Library_BG 
	BEGIN 
		RANDOM(1, 1, 1, 1) 
			RANDOMCASE Obj_PlayStream SK6_BO_LibraryMvmt01 emitter = TRG_SFX_SOB_LibraryBG 
			wait 27 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_LibraryMvmt02 emitter = TRG_SFX_SOB_LibraryBG 
			wait 26 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_LibraryMvmt03 emitter = TRG_SFX_SOB_LibraryBG 
			wait 24 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_LibraryMvmt04 emitter = TRG_SFX_SOB_LibraryBG 
			wait 30 seconds 
		RANDOMEND 
		wait 0.50000000000 seconds 
	REPEAT 
