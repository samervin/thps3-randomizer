				wait 3 seconds 
				RANDOMCASE Obj_PlayStream SK6_BO_Bird13 vol = BO_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_CommonsTree04 RANDOMCASE TRG_SFX_SOB_CommonsTree05 RANDOMCASE TRG_SFX_SOB_CommonsTree06 RANDOMEND priority = StreamPriorityLow 
				wait 3 seconds 
				RANDOMCASE Obj_PlayStream SK6_BO_Bird14 vol = BO_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_CommonsTree04 RANDOMCASE TRG_SFX_SOB_CommonsTree05 RANDOMCASE TRG_SFX_SOB_CommonsTree06 RANDOMEND priority = StreamPriorityLow 
				wait 7 seconds 
				RANDOMCASE Obj_PlayStream SK6_BO_Bird15 vol = BO_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_CommonsTree04 RANDOMCASE TRG_SFX_SOB_CommonsTree05 RANDOMCASE TRG_SFX_SOB_CommonsTree06 RANDOMEND priority = StreamPriorityLow 
				wait 7 seconds 
				RANDOMCASE Obj_PlayStream SK6_BO_Bird16 vol = BO_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_CommonsTree04 RANDOMCASE TRG_SFX_SOB_CommonsTree05 RANDOMCASE TRG_SFX_SOB_CommonsTree06 RANDOMEND priority = StreamPriorityLow 
				wait 7 seconds 
				RANDOMCASE Obj_PlayStream SK6_BO_Bird17 vol = BO_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_CommonsTree04 RANDOMCASE TRG_SFX_SOB_CommonsTree05 RANDOMCASE TRG_SFX_SOB_CommonsTree06 RANDOMEND priority = StreamPriorityLow 
				wait 5 seconds 
			RANDOMEND 
			wait RANDOM(1, 1, 1) RANDOMCASE 0.50000000000 RANDOMCASE 1.10000002384 RANDOMCASE 1.29999995232 RANDOMEND seconds 
		REPEAT 
	ENDIF 
ENDSCRIPT

SCRIPT BO_SFX_River01 
	Obj_PlaySound SK6_BO_RiverLoop01_11 vol = 40 emitter = TRG_SFX_SOB_River01 
