	IF NOT ( IsStreamPlaying SK6_Teapot_Sign_Whistle ) 
		TRG_SFX_Ghost_TeapotWhistle : Obj_PlayStream SK6_Teapot_Sign_Whistle vol = 150 dropoff = 120 
	ENDIF 
