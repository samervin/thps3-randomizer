	TRG_SFX_Ghost_ChurchSign : Obj_PlayStream SK6_NO_BreakNeonSign vol = 200 dropoff = 250 
	wait 1 second 
	create name = TRG_SFX_TrigBox_ChurchSignSizzle01 
ENDSCRIPT

