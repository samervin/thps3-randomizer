SCRIPT TRG_SFX_SOB_CommonsTree01 
	wait RANDOM(1, 1, 1, 1) RANDOMCASE 0 RANDOMCASE 0.20000000298 RANDOMCASE 0.80000001192 RANDOMCASE 0.89999997616 RANDOMEND seconds 
	BEGIN 
		RANDOM_NO_REPEAT(1, 1, 1, 1, 1, 1, 1, 1) 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird01 vol = BO_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_CommonsTree01 RANDOMCASE TRG_SFX_SOB_CommonsTree02 RANDOMCASE TRG_SFX_SOB_CommonsTree03 RANDOMEND priority = StreamPriorityLow 
			wait 4 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird02 vol = BO_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_CommonsTree01 RANDOMCASE TRG_SFX_SOB_CommonsTree02 RANDOMCASE TRG_SFX_SOB_CommonsTree03 RANDOMEND priority = StreamPriorityLow 
			wait 5 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird03 vol = BO_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_CommonsTree01 RANDOMCASE TRG_SFX_SOB_CommonsTree02 RANDOMCASE TRG_SFX_SOB_CommonsTree03 RANDOMEND priority = StreamPriorityLow 
			wait 4 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird04 vol = BO_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_CommonsTree01 RANDOMCASE TRG_SFX_SOB_CommonsTree02 RANDOMCASE TRG_SFX_SOB_CommonsTree03 RANDOMEND priority = StreamPriorityLow 
			wait 5 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird05 vol = BO_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_CommonsTree01 RANDOMCASE TRG_SFX_SOB_CommonsTree02 RANDOMCASE TRG_SFX_SOB_CommonsTree03 RANDOMEND priority = StreamPriorityLow 
			wait 8 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird06 vol = BO_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_CommonsTree01 RANDOMCASE TRG_SFX_SOB_CommonsTree02 RANDOMCASE TRG_SFX_SOB_CommonsTree03 RANDOMEND priority = StreamPriorityLow 
			wait 9 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird07 vol = BO_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_CommonsTree01 RANDOMCASE TRG_SFX_SOB_CommonsTree02 RANDOMCASE TRG_SFX_SOB_CommonsTree03 RANDOMEND priority = StreamPriorityLow 
			wait 4 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird08 vol = BO_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1) RANDOMCASE TRG_SFX_SOB_CommonsTree01 RANDOMCASE TRG_SFX_SOB_CommonsTree02 RANDOMCASE TRG_SFX_SOB_CommonsTree03 RANDOMEND priority = StreamPriorityLow 
			wait 5 seconds 
		RANDOMEND 
		wait RANDOM(1, 1, 1) RANDOMCASE 0.50000000000 RANDOMCASE 1.10000002384 RANDOMCASE 1.29999995232 RANDOMEND seconds 
	REPEAT 
ENDSCRIPT

SCRIPT TRG_SFX_SOB_CommonsTree02 
