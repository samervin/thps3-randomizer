SCRIPT BO_SFX_ConstructionSite01 
	IF NOT IsStreamPlaying ConstructionLoopStream 
		Obj_PlayStream SK6_BO_ConstructionLoop emitter = TRG_SFX_SOB_ConstructionSite01 id = ConstructionLoopStream num_loops = -1 priority = 51 
	ENDIF 
ENDSCRIPT

SCRIPT BO_SFX_SubwayMusic01 
	wait 1 gameframe 
	IF NOT InSplitScreenGame 
		IF NOT IsStreamPlaying GuitaristsStream 
			RANDOM_NO_REPEAT(1, 1, 1, 1, 1, 1, 1, 1, 1, 15) 
				RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_01 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
				wait 13 seconds 
				RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_02 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
				wait 16 seconds 
				RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_03 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
				wait 9 seconds 
				RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_04 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
				wait 11 seconds 
				RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_05 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
				wait 5 seconds 
				RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_06 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
				wait 11 seconds 
				RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_07 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
				wait 10 seconds 
				RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_08 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
				wait 11 seconds 
				RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_09 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
				wait 4 seconds 
				RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_12 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
				wait 5 seconds 
			RANDOMEND 
			BEGIN 
				RANDOM_NO_REPEAT(10, 10, 10, 10, 10, 10, 10, 10, 10, 1) 
					RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_01 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
					wait 13 seconds 
					RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_02 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
					wait 16 seconds 
					RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_03 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
					wait 9 seconds 
					RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_04 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
					wait 11 seconds 
					RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_05 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
					wait 5 seconds 
					RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_06 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
					wait 11 seconds 
					RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_07 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
					wait 10 seconds 
					RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_08 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
					wait 11 seconds 
					RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_09 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
					wait 4 seconds 
					RANDOMCASE Obj_PlayStream SK6_BO_Bum_Gtr_10 vol = 250 emitter = TRG_SFX_SOB_BassMan01 dropoff_function = linear id = GuitaristsStream 
					wait 14 seconds 
				RANDOMEND 
				wait 1 seconds 
			REPEAT 
		ENDIF 
	ENDIF 
ENDSCRIPT

