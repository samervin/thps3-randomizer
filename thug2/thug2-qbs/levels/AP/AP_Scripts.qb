SCRIPT AP_2d_sign_element_create parent = menu3d_anchor 
	IF GetGlobalFlag flag = SCREEN_MODE_WIDE 
		<offset> = PAIR(-8.00000000000, 0.00000000000) 
	ELSE 
		<offset> = PAIR(0.00000000000, 0.00000000000) 
	ENDIF 
	CreateScreenElement { 
		Type = SpriteElement 
		parent = <parent> 
		texture = AP_icon_1 
		id = AP_guy 
		scale = 2.70000004768 
		rgba = [ 128 128 128 128 ] 
		pos = ( PAIR(18.00000000000, 104.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ left top ] 
		z_priority = -51 
	} 
	CreateScreenElement { 
		Type = SpriteElement 
		parent = <parent> 
		texture = AP_icon_2 
		id = AP_arrow 
		scale = 1.79999995232 
		rgba = [ 128 128 128 100 ] 
		pos = ( PAIR(70.00000000000, 120.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ center top ] 
		alpha = 0 
		z_priority = -51 
	} 
	RunScriptOnScreenElement id = <parent> AP_icon_anim 
ENDSCRIPT

SCRIPT AP_icon_anim 
	BEGIN 
		RunScriptOnScreenElement id = AP_guy AP_guy_anim 
		wait 0.80000001192 seconds 
		RunScriptOnScreenElement id = AP_arrow AP_arrow_anim 
		wait RANDOM(1, 1, 1) RANDOMCASE 5 RANDOMCASE 7 RANDOMCASE 9 RANDOMEND seconds 
	REPEAT 
ENDSCRIPT

SCRIPT AP_guy_anim 
	start_pos = PAIR(14.00000000000, 104.00000000000) 
	DoMorph time = 0 pos = ( <start_pos> - PAIR(250.00000000000, 0.00000000000) ) 
	DoMorph time = 1 pos = <start_pos> 
	wait 1.50000000000 seconds 
	DoMorph time = 0.30000001192 pos = ( <start_pos> - PAIR(250.00000000000, 0.00000000000) ) 
ENDSCRIPT

SCRIPT AP_arrow_anim 
	DoMorph time = 0 alpha = 0 rot_angle = 0 
	DoMorph time = 0.50000000000 alpha = 1 
	DoMorph time = 0.50000000000 rot_angle = -200 
	DoMorph time = 0.50000000000 alpha = 0 
ENDSCRIPT


