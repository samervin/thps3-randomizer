SCRIPT AP_TELE_Bottom 
	IF NOT ( GameModeEquals is_ctf ) 
		TeleportSkaterToNode nodename = TRG_Restart_Start01 
		GetBonus score = 5000 
		text = "Rewind Bonus" 
		create_panel_message { 
			id = leaving_message 
			text = "Rewind!" 
			pos = PAIR(320.00000000000, 180.00000000000) 
			rgba = [ 118 , 110 , 14 , 128 ] 
			pulse_blur 
			start = 200 
			speed = 1 
			scale = 1.00000000000 
		} 
		playsound LA_Skid_11 vol = 50 
	ENDIF 
ENDSCRIPT

SCRIPT ESC_Ground 
	Obj_SetPathVelocity 0.50000000000 mph 
	Obj_PathHeading Off 
	Obj_FollowPathLinked 
ENDSCRIPT

