SCRIPT LA_BreakGlass 
	BloodSplat 
	GetBonus score = 100 text = "Glass Broken" 
	playsound HitGlassPane2x vol = 100 pitch = RANDOM(1, 1, 1, 1, 1) RANDOMCASE 75 RANDOMCASE 85 RANDOMCASE 100 RANDOMCASE 115 RANDOMCASE 125 RANDOMEND 
	Kill name = <name> 
	Shatteranddie name = <name> area = RANDOM(1, 1, 1) RANDOMCASE 588 RANDOMCASE 1000 RANDOMCASE 4000 RANDOMEND vibrate variance = 4.59999990463 vel_x = RANDOM(1, 1, 1) RANDOMCASE 0.00000000000 RANDOMCASE 30 RANDOMCASE -30 RANDOMEND vel_y = RANDOM(1, 1, 1) RANDOMCASE 10 RANDOMCASE 30 RANDOMCASE 50 RANDOMEND vel_z = RANDOM(1, 1, 1) RANDOMCASE 0 RANDOMCASE 30 RANDOMCASE -30 RANDOMEND spread = 1.00000000000 
ENDSCRIPT

