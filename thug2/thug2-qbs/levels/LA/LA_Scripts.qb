SCRIPT LA_2d_sign_element_create parent = menu3d_anchor 
	IF GetGlobalFlag flag = SCREEN_MODE_WIDE 
		<offset> = PAIR(-8.00000000000, 0.00000000000) 
	ELSE 
		<offset> = PAIR(0.00000000000, 0.00000000000) 
	ENDIF 
	CreateScreenElement { 
		Type = ContainerElement 
		parent = <parent> 
		id = LA_holder 
		pos = PAIR(0.00000000000, 0.00000000000) 
		z_priority = -53 
	} 
	CreateScreenElement { 
		Type = SpriteElement 
		parent = <parent> 
		texture = LA_icon_1 
		id = LA_ping 
		scale = 1 
		rgba = [ 128 128 128 100 ] 
		pos = ( PAIR(180.00000000000, 320.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ center center ] 
		z_priority = -51 
	} 
	CreateScreenElement { 
		Type = SpriteElement 
		parent = LA_holder 
		texture = LA_icon_2 
		id = LA_richter 
		scale = 5 
		rgba = [ 128 128 128 100 ] 
		pos = ( PAIR(120.00000000000, 300.00000000000) + <offset> ) 
		rot_angle = -30 
		just = [ center center ] 
	} 
	RunScriptOnScreenElement id = LA_holder LA_main_anim 
	RunScriptOnScreenElement id = LA_richter LA_richter_anim 
ENDSCRIPT

SCRIPT LA_richter_anim orig_pos = PAIR(120.00000000000, 300.00000000000) 
	BEGIN 
		x_off = RANDOM(1, 1, 1, 1, 1) RANDOMCASE PAIR(-30.00000000000, 0.00000000000) RANDOMCASE PAIR(-10.00000000000, 0.00000000000) RANDOMCASE PAIR(0.00000000000, 0.00000000000) RANDOMCASE PAIR(10.00000000000, 0.00000000000) RANDOMCASE PAIR(30.00000000000, 0.00000000000) RANDOMEND 
		y_off = RANDOM(1, 1, 1, 1, 1) RANDOMCASE PAIR(0.00000000000, -30.00000000000) RANDOMCASE PAIR(0.00000000000, -10.00000000000) RANDOMCASE PAIR(0.00000000000, 0.00000000000) RANDOMCASE PAIR(0.00000000000, 10.00000000000) RANDOMCASE PAIR(0.00000000000, 30.00000000000) RANDOMEND 
		DoMorph time = 0 pos = PAIR(120.00000000000, 300.00000000000) 
		DoMorph time = 0.05000000075 pos = ( PAIR(120.00000000000, 300.00000000000) + <x_off> + <y_off> ) 
	REPEAT 
ENDSCRIPT

SCRIPT LA_ping_anim 
	x_off = RANDOM(1, 1, 1, 1, 1) RANDOMCASE PAIR(10.00000000000, 0.00000000000) RANDOMCASE PAIR(60.00000000000, 0.00000000000) RANDOMCASE PAIR(110.00000000000, 0.00000000000) RANDOMCASE PAIR(140.00000000000, 0.00000000000) RANDOMCASE PAIR(180.00000000000, 0.00000000000) RANDOMEND 
	y_off = RANDOM(1, 1, 1, 1, 1, 1) RANDOMCASE PAIR(0.00000000000, 160.00000000000) RANDOMCASE PAIR(0.00000000000, 192.00000000000) RANDOMCASE PAIR(0.00000000000, 224.00000000000) RANDOMCASE PAIR(0.00000000000, 256.00000000000) RANDOMCASE PAIR(0.00000000000, 288.00000000000) RANDOMCASE PAIR(0.00000000000, 320.00000000000) RANDOMEND 
	DoMorph time = 0 pos = ( <x_off> + <y_off> ) alpha = 1 scale = 0 
	DoMorph time = 0.50000000000 scale = 1.50000000000 
	DoMorph time = 2.00000000000 alpha = 0 scale = 4 
ENDSCRIPT

SCRIPT LA_fade_in_out 
	wait 0.10000000149 seconds 
	DoMorph time = 0 alpha = 0 
	DoMorph time = 0.05000000075 alpha = 1 
	wait 1.50000000000 seconds 
	DoMorph time = 0.50000000000 alpha = 0 
ENDSCRIPT

SCRIPT LA_main_anim 
	BEGIN 
		RunScriptOnScreenElement id = LA_ping LA_ping_anim 
		RunScriptOnScreenElement id = LA_holder LA_fade_in_out 
		wait RANDOM(1, 1, 1) RANDOMCASE 5 RANDOMCASE 7 RANDOMCASE 9 RANDOMEND seconds 
	REPEAT 
ENDSCRIPT


