SCRIPT CPF_GrateOpenEnd 
	EndGap GapID = Open1 text = "They\'re GRATE!" score = 100 
	create name = Gap_VentFrus_01 
	create prefix = "TRG_Ledge_Grates" 
	IF IsAlive name = GrateClosed01 
		spawnscript CPF_GrateOpenCreate_Start 
	ENDIF 
ENDSCRIPT

