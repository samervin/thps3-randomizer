SCRIPT LA_Rubble_Vibration 
	IF NOT InMultiplayerGame 
		BEGIN 
			skater : Vibrate_Controller_Safe actuator = 1 percent = 50 
			wait 1 frames 
		REPEAT 10 
		skater : Vibrate_Controller_Safe actuator = 1 percent = 0 
	ENDIF 
ENDSCRIPT

