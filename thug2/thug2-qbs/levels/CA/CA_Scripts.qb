				] 
				view_goals_cameras = [ { virtual_cam 
						targetid = world 
						targetOffset = VECTOR(-4024.8, -2327.2, 7965.3) 
						positionOffset = VECTOR(5422.9, 208.4, 5890.8) 
						frames = 200 
						skippable = 1 
					} 
				] 
			} 
			AddGoal_collect { 
				unlimited_time 
				init_script = CA_iceyrails 
				goal_deactivate_script = CA_iceyrailskill 
				classic_mode_goal 
				version = 2 
				collect_type = "Icy rails" 
				use_hud_counter 
				hud_counter_caption = "Completely Scrape The 5 Icy rails" 
				goal_text = "Completely Scrape The 5 Icy rails" 
				view_goals_text = "Completely Scrape The 5 Icy rails" 
				goal_description = "Completely Scrape The 5 Icy rails" 
				goal_flags = [ got_1 
					got_2 
					got_3 
					got_4 
					got_5 
				] 
				view_goals_cameras = [ { virtual_cam 
						targetid = world 
						targetOffset = VECTOR(-7605.4, -1902.9, 6355.7) 
						positionOffset = VECTOR(2254.5, -282.7, 6753.4) 
						frames = 200 
						skippable = 1 
					} 
				] 
			} 
			AddGoal_gaps { 
				unlimited_time 
