FLAG_ICY = 25 
kg_iceyrail1 = 0 
kg_iceyrail2 = 0 
kg_iceyrail3 = 0 
kg_iceyrail4 = 0 
kg_iceyrail5 = 0 
SCRIPT CA_Icey_Rails 
	GetTriggerArray through 
	IF TriggerType <trigger_array> 
		IF skating 
			shatteranddie name = <rail> area = 5000 variance = 1 vel_x = 50 vel_y = 50 vel_z = 50 
			playsound HitGlassPane2X 
			SWITCH <group> 
				CASE 1 
					change kg_iceyrail1 = ( kg_iceyrail1 + 1 ) 
					SWITCH kg_iceyrail1 
						CASE 5 
							goal_collect_got_object goal_id = ca_classic_goal_collect2 flag = got_1 
					ENDSWITCH 
				CASE 2 
					change kg_iceyrail2 = ( kg_iceyrail2 + 1 ) 
					SWITCH kg_iceyrail2 
						CASE 5 
							goal_collect_got_object goal_id = ca_classic_goal_collect2 flag = got_2 
					ENDSWITCH 
				CASE 3 
					change kg_iceyrail3 = ( kg_iceyrail3 + 1 ) 
					SWITCH kg_iceyrail3 
						CASE 5 
							goal_collect_got_object goal_id = ca_classic_goal_collect2 flag = got_3 
					ENDSWITCH 
				CASE 4 
					change kg_iceyrail4 = ( kg_iceyrail4 + 1 ) 
					SWITCH kg_iceyrail4 
						CASE 5 
							goal_collect_got_object goal_id = ca_classic_goal_collect2 flag = got_4 
					ENDSWITCH 
				CASE 5 
					change kg_iceyrail5 = ( kg_iceyrail5 + 1 ) 
					SWITCH kg_iceyrail5 
						CASE 5 
							goal_collect_got_object goal_id = ca_classic_goal_collect2 flag = got_5 
					ENDSWITCH 
				ENDIF 
			ENDIF 
	ENDSWITCH 
ENDSCRIPT

SCRIPT CA_Trees_Brustle 
	playsound BonkBush 
ENDSCRIPT

SCRIPT TRG_CA_Car01 
	Car_Generic01 sticktoground TurnDist = 70 DefaultSpeed = 35 
ENDSCRIPT

SCRIPT Scoreboard_small_style 
	pos = PAIR(20, 10) 
	DoMorph scale = 1.20000004768 
	BEGIN 
		DoMorph time = 0.10000000149 pos = PAIR(320.00000000000, 290.00000000000) 
		DoMorph time = 0.10000000149 pos = PAIR(320.00000000000, 280.00000000000) 
		rgba = { 255 , 255 , 255 , 128 } 
	REPEAT 10 
ENDSCRIPT

SCRIPT CA_Kill_Rock 
	kill_panel_message_if_it_exists id = message_rock 
ENDSCRIPT

SCRIPT CA_NailTheRock 
	GetTriggerArray skate onto 
	playsound hitmetalcan 
	FormatText TextName = rock_text "WHOA DUDE! YOU NAILED THE ROCK!" 
	create_panel_message id = message_rock text = <rock_text> rgba = { 0 , 132 , 255 , 128 } style = Scoreboard_small_style z_priority = -30 
	wait 2 seconds 
	spawnscript CA_Kill_Rock 
ENDSCRIPT

SCRIPT Kill_Skater_Cabin_04 
	SK3_Killskater_water nodename = TRG_Restart_Conc02 
ENDSCRIPT

SCRIPT Kill_Skater_Rock01 
	SK3_Killskater nodename = TRG_Restart_Conc02 NoMessage 
	create_panel_message id = leaving_message text = "Thump!" text1 = "ha ha ha!" text = "nice shot!" 
ENDSCRIPT

SCRIPT CA_Peeing_Lip 
	GetTriggerArray lip onto 
	IF TriggerType <trigger_array> 
		playsound HitWoodPlanks 
		playsound KenHelp3 
		TRG_PeeingKid01 : obj_movetonode name = TRG_Peeing_Move_Node01 time = 1.60000002384 
		wait 0.50000000000 seconds 
		TRG_PeeingKid01 : obj_movetonode name = TRG_Peeing_Move_Node02 time = 4 
		wait 10 seconds 
		kill name = TRG_PeeingKid01 
	ENDIF 
ENDSCRIPT

SCRIPT CA_Move_Ramp 
	GoalManager_PauseAllGoals 
	hide_goal_panel_messages 
	create name = Wilderness_Steam_Gen_Lever_Low 
	create name = Wild_Log_Loader_Base 
	GetBonus score = 10000 text = "Ramp Adjusted!" 
	pauseskaters 
	skater : hide 
	skater : SparksOff 
	spawnscript LeverCam_01 
	printf "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" 
	Wilderness_Steam_Gen_Lever_Low : Obj_Rotate absolute = VECTOR(45.00000000000, 0.00000000000, 0.00000000000) time = 2 
	printf "00000000000000000000000000000000000" 
	kill name = TRGP_Toggle_Log_Loader02 
	kill name = Wild_Log_Loader_Claw_Base_Low 
	kill name = Wilderness_Steam_Gen_Lever_Low01 
	kill name = Wild_Log_Loader_Base_Low 
	kill name = TRG_Loader_Rail_Base_Low01 
	wait 2 seconds 
	spawnscript RampCam_01 
	printf "wait" 
	printf "Move pre" 
	Wild_Log_Loader_Base : Obj_movetorelpos VECTOR(0.00000000000, 240.00000000000, 0.00000000000) time = 3 seconds 
	printf "Move post" 
	playsound HitWoodPlanks volume = 50 pitch = 10 
	kill name = Wild_Log_Loader_Claw_Press 
	wait 3 seconds 
	playsound HitWoodPlanks volume = 100 pitch = 50 
	wait 1 seconds 
	create name = Wild_Log_Loader_Claw_Base_High02 
	kill name = Wild_Log_Loader_Base 
	create name = Wild_Log_Loader_Base1_obj 
	Wild_Log_Loader_Claw_Base_High02 : Obj_Rotate absolute = VECTOR(-40.08913040161, 0.00000000000, 0.00000000000) time = 1 second 
	wait 1 seconds 
	playsound HitWoodPlanks volume = 60 pitch = 30 
	create name = Wild_Log_Loader_Claw_Base_High01 
	kill name = Wild_Log_Loader_Claw_Base_High02 
	create prefix = "TRG_Loader_Rail_Base_High" 
	wait 1 seconds 
	unpauseskaters 
	skater : unhide 
	skater : SparksOn 
	GoalManager_UnPauseAllGoals 
	show_goal_panel_messages 
ENDSCRIPT

SCRIPT LeverCam_01 
	PlaySkaterCamAnim name = CAM01_Lever 
	printf "wait" 
	BEGIN 
		IF SkaterCamAnimFinished name = CAM01_Lever 
			BREAK 
		ENDIF 
		wait 2 frames 
	REPEAT 
ENDSCRIPT

SCRIPT RampCam_01 
	PlaySkaterCamAnim name = CAM01_Ramp 
	BEGIN 
		IF SkaterCamAnimFinished name = CAM01_Ramp 
			BREAK 
		ENDIF 
		wait 2 frames 
	REPEAT 
ENDSCRIPT

