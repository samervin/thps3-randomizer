SCRIPT CA_Setup 
	CA_CreateCars 
	CA_CreatePeds all 
	CA_Main_Initializer 
	ST_Initializer 
ENDSCRIPT

SCRIPT CA_startup 
ENDSCRIPT

SCRIPT CA_CreateCars 
ENDSCRIPT

SCRIPT CA_CreatePeds 
ENDSCRIPT

SCRIPT CA_KillCars 
ENDSCRIPT

SCRIPT CA_KillPeds 
ENDSCRIPT

SCRIPT CA_Main_Initializer 
	IF InMultiplayerGame 
		kill name = TRGP_Toggle_Log_Loader02 
		kill name = Wild_Log_Loader_Claw_Base_Low 
		kill name = Wilderness_Steam_Gen_Lever_Low01 
		kill name = Wild_Log_Loader_Base_Low 
		kill name = TRG_Loader_Rail_Base_Low01 
		kill name = Wild_Log_Loader_Claw_Press 
		create name = Wild_Log_Loader_Base1_obj 
		create name = Wild_Log_Loader_Claw_Base_High01 
	ENDIF 
ENDSCRIPT

SCRIPT ST_Initializer 
ENDSCRIPT

SCRIPT CA_Goals 
	IF InMultiplayerGame 
		add_multiplayer_mode_goals 
	ENDIF 
	IF NOT InSplitScreenGame 
		IF ( ( GameModeEquals is_classic ) | ( InNetGame ) ) 
			printf "adding classic goals" 
			AddGoal_HighScore { 
				unlimited_time 
				classic_mode_goal 
				goal_text = CA_Classic_HighScore_Text 
				view_goals_cameras = [ { 
						name = Cam_Score 
						frames = 1200 
						skippable = 1 
					} 
				] 
				difficulty_level_params = [ 
					{ score = CA_Classic_Easy_HighScore 
						goal_text = CA_Classic_Easy_HighScore_Text 
						view_goals_text = CA_Classic_Easy_HighScore_Text 
					} 
					{ score = CA_Classic_HighScore 
						goal_text = CA_Classic_HighScore_Text 
						view_goals_text = CA_Classic_HighScore_Text 
					} 
				] 
			} 
			AddGoal_ProScore { 
				unlimited_time 
				classic_mode_goal 
				score = CA_Classic_ProScore 
				goal_text = CA_Classic_ProScore_Text 
				view_goals_text = CA_Classic_ProScore_Text 
				difficulty_level_params = [ 
					{ score = CA_Classic_Easy_ProScore 
						goal_text = CA_Classic_Easy_ProScore_Text 
						view_goals_text = CA_Classic_Easy_ProScore_Text 
					} 
					{ score = CA_Classic_ProScore 
						goal_text = CA_Classic_ProScore_Text 
						view_goals_text = CA_Classic_ProScore_Text 
					} 
				] 
			} 
			AddGoal_SickScore { 
				unlimited_time 
				classic_mode_goal 
				score = CA_Classic_SickScore 
				goal_text = CA_Classic_SickScore_Text 
				view_goals_text = CA_Classic_SickScore_Text 
				difficulty_level_params = [ 
					{ score = CA_Classic_Easy_SickScore 
						goal_text = CA_Classic_Easy_SickScore_Text 
						view_goals_text = CA_Classic_Easy_SickScore_Text 
					} 
					{ score = CA_Classic_SickScore 
						goal_text = CA_Classic_SickScore_Text 
						view_goals_text = CA_Classic_SickScore_Text 
					} 
				] 
			} 
			AddGoal_HighCombo { 
				unlimited_time 
				classic_mode_goal 
				score = CA_Classic_HighCombo 
				goal_text = CA_Classic_HighCombo_Text 
				view_goals_text = CA_Classic_HighCombo_Text 
				difficulty_level_params = [ 
					{ score = CA_Classic_Easy_HighCombo 
						goal_text = CA_Classic_Easy_HighCombo_Text 
						view_goals_text = CA_Classic_Easy_HighCombo_Text 
					} 
					{ score = CA_Classic_HighCombo 
						goal_text = CA_Classic_HighCombo_Text 
						view_goals_text = CA_Classic_HighCombo_Text 
					} 
				] 
			} 
			AddGoal_Skate { 
				unlimited_time 
				classic_mode_goal 
				S_obj_id = TRG_SKATE_S 
				K_obj_id = TRG_SKATE_K 
				A_obj_id = TRG_SKATE_A 
				T_obj_id = TRG_SKATE_T 
