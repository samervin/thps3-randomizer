						positionOffset = VECTOR(1970.7, 244.9, 8101) 
						frames = 200 
						skippable = 1 
					} 
				] 
			} 
			AddGoal_collect { 
				unlimited_time 
				init_script = CA_snowmen 
				goal_deactivate_script = CA_snowmenkill 
				classic_mode_goal 
				collect_type = "Snowmen" 
				goal_text = "Smash 5 Snowmen" 
				view_goals_text = "Smash 5 Snowmen" 
				use_hud_counter 
				hud_counter_caption = "Snowmen smashed" 
				goal_flags = [ got_1 
					got_2 
					got_3 
					got_4 
					got_5 
				] 
				view_goals_cameras = [ { virtual_cam 
						targetid = world 
						targetOffset = VECTOR(-9767.2, -2399.5, 13295.3) 
						positionOffset = VECTOR(-1017.5, -404.4, 8884.1) 
						frames = 200 
						skippable = 1 
					} 
				] 
			} 
			AddGoal_Combo { 
