ENDSCRIPT

SCRIPT CA_Shatter_Snowmans 
	kill name = <name> 
	playsound Smashcake 
	printf "A$#@!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" 
	SWITCH <name> 
			printf "B$#@!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" 
		CASE CA_Classic_Snowman01 
			printf "C$#@!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" 
			goal_collect_got_object goal_id = ca_classic_goal_collect flag = got_1 
			CreateGlobalFlexParticleSystem name = JOW_CA_Snowman01 params_Script = JOW_CA_Snowman01_particle_params 
			JOW_CA_Snowman01 : Obj_SetPosition position = VECTOR(3533.11, -330, 6660.59) 
			CreateFastParticleSystem name = JOW_CA_Snowflake01 params_Script = JOW_CA_Snowflake01_fast_particle_params 
		CASE CA_Classic_Snowman02 
			goal_collect_got_object goal_id = ca_classic_goal_collect flag = got_2 
			CreateGlobalFlexParticleSystem name = JOW_CA_Snowman02 params_Script = JOW_CA_Snowman02_particle_params 
			JOW_CA_Snowman02 : Obj_SetPosition position = VECTOR(-1050.77, -451.507, 8894.62) 
			CreateFastParticleSystem name = JOW_CA_Snowflake02 params_Script = JOW_CA_Snowflake02_fast_particle_params 
		CASE CA_Classic_Snowman03 
			goal_collect_got_object goal_id = ca_classic_goal_collect flag = got_3 
			CreateGlobalFlexParticleSystem name = JOW_CA_Snowman03 params_Script = JOW_CA_Snowman03_particle_params 
			JOW_CA_Snowman03 : Obj_SetPosition position = VECTOR(-1716.71, -329.12, 4431.85) 
			CreateFastParticleSystem name = JOW_CA_Snowflake03 params_Script = JOW_CA_Snowflake03_fast_particle_params 
		CASE CA_Classic_Snowman04 
			goal_collect_got_object goal_id = ca_classic_goal_collect flag = got_4 
			CreateGlobalFlexParticleSystem name = JOW_CA_Snowman04 params_Script = JOW_CA_Snowman04_particle_params 
			JOW_CA_Snowman04 : Obj_SetPosition position = VECTOR(5454.72, -388.446, 4392.62) 
			CreateFastParticleSystem name = JOW_CA_Snowflake04 params_Script = JOW_CA_Snowflake04_fast_particle_params 
		CASE CA_Classic_Snowman05 
			goal_collect_got_object goal_id = ca_classic_goal_collect flag = got_5 
			CreateGlobalFlexParticleSystem name = JOW_CA_Snowman05 params_Script = JOW_CA_Snowman05_particle_params 
			JOW_CA_Snowman05 : Obj_SetPosition position = VECTOR(3585.5, -379.74, 3065.02) 
			CreateFastParticleSystem name = JOW_CA_Snowflake05 params_Script = JOW_CA_Snowflake05_fast_particle_params 
	ENDSWITCH 
ENDSCRIPT

SCRIPT CA_Secret_Tape 
	Obj_ClearExceptions 
	Obj_SetException ex = ObjectInRadius scr = CA_Secret_Tape_Got 
	Obj_SetInnerRadius 10 
	Obj_RotY speed = 250 
	Obj_Hover Amp = 10 Freq = 1 
ENDSCRIPT

SCRIPT CA_Secret_Tape_Got 
	Obj_ClearExceptions 
	GoalManager_SetGoalFlag name = ca_classic_goal_gaps got_1 1 
	Die 
ENDSCRIPT

