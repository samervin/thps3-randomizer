				version = 2 
				goal_text = "FS Boardslide The Entire Log QP" 
				view_goals_text = "FS Boardslide The Entire Log QP" 
				goal_description = "FS Boardslide The Entire Log QP" 
				goal_flags = [ got_1 
				] 
				view_goals_cameras = [ { virtual_cam 
						targetid = world 
