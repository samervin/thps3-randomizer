SCRIPT CA_2d_sign_element_create parent = menu3d_anchor 
	IF GetGlobalFlag flag = SCREEN_MODE_WIDE 
		<offset> = PAIR(-8.00000000000, 0.00000000000) 
	ELSE 
		<offset> = PAIR(0.00000000000, 0.00000000000) 
	ENDIF 
	CreateScreenElement { 
		Type = SpriteElement 
		parent = <parent> 
		texture = CA_icon_1 
		id = CA_moose 
		scale = 2.29999995232 
		rgba = [ 128 128 128 60 ] 
		pos = ( PAIR(15.00000000000, 235.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ left top ] 
		z_priority = -51 
	} 
	CreateScreenElement { 
		Type = SpriteElement 
		parent = <parent> 
		texture = CA_icon_2 
		id = CA_eh 
		scale = 1.60000002384 
		rgba = [ 128 128 128 80 ] 
		pos = ( PAIR(150.00000000000, 180.00000000000) + <offset> ) 
		rot_angle = 10 
		just = [ center center ] 
		z_priority = -51 
	} 
	RunScriptOnScreenElement id = CA_moose do_random_effect_paused params = { id = <id> } 
	RunScriptOnScreenElement id = CA_eh CA_eh_anim 
ENDSCRIPT

SCRIPT CA_eh_anim 
	BEGIN 
		start_pos = PAIR(150.00000000000, 180.00000000000) alpha = 0 
		DoMorph time = 0 pos = ( <start_pos> - PAIR(250.00000000000, 0.00000000000) ) alpha = 1 
		wait 2 seconds 
		DoMorph time = 0.30000001192 pos = <start_pos> 
		wait RANDOM(1, 1, 1) RANDOMCASE 2 RANDOMCASE 3 RANDOMCASE 4 RANDOMEND seconds 
		DoMorph time = 0.30000001192 pos = ( <start_pos> - PAIR(250.00000000000, 0.00000000000) ) alpha = 0 
		wait RANDOM(1, 1, 1) RANDOMCASE 5 RANDOMCASE 8 RANDOMCASE 3 RANDOMEND seconds 
	REPEAT 
ENDSCRIPT


