			AddGoal_SecretTape { 
				classic_mode_goal 
				goal_text = "Get the secret tape" 
				view_goals_text = "Get the secret tape" 
				classic_mode_goal 
				goal_description = "Get the secret tape" 
				secret_tape_id = TRG_SecretTape 
				goal_flags = [ got_1 
