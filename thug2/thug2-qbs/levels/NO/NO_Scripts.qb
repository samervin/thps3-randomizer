	RANDOM_NO_REPEAT(1, 1, 1) 
		RANDOMCASE PlayStream Zombie_Death01 vol = 200 priority = StreamPriorityHigh 
		RANDOMCASE PlayStream Zombie_Death02 vol = 200 priority = StreamPriorityHigh 
		RANDOMCASE PlayStream Zombie_Death03 vol = 200 priority = StreamPriorityHigh 
