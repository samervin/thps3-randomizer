		Create name = TRG_277 
		Create name = TRG_278 
	ENDIF 
	IF IsCareerMode 
		IF NOT isAlive name = TRG_veh_heli 
			IF NOT isAlive name = TRG_ped_voodoo_tricycle01 
				Create name = TRG_ped_voodoo_tricycle01 
			ENDIF 
		ENDIF 
	ENDIF 
	NO_Peds_Eventstart 
ENDSCRIPT

