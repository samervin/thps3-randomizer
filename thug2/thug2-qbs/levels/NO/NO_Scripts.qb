SCRIPT NO_Crypt4_open 
	Obj_MoveToRelPos VECTOR(0.00000000000, -2.00000000000, 0.00000000000) speed = 1 
	Obj_WaitMove 
	BEGIN 
		Obj_MoveToRelPos VECTOR(0.00000000000, 2.00000000000, 0.00000000000) speed = 1 
		Obj_WaitMove 
		Obj_MoveToRelPos VECTOR(0.00000000000, -2.00000000000, 0.00000000000) speed = 1 
		Obj_WaitMove 
	REPEAT 
ENDSCRIPT

