			RANDOMCASE TRG_SFX_Ghost_TrainSparks01 : Obj_PlayStream SK6_SmSpark19 vol = 40 pitch = 100 id = TrainSpark dropoff = 160 dropoff_function = exponential priority = StreamPriorityLow 
			wait 0.50999999046 seconds 
			RANDOMCASE TRG_SFX_Ghost_TrainSparks01 : Obj_PlayStream SK6_SmSpark20 vol = 40 pitch = 100 id = TrainSpark dropoff = 160 dropoff_function = exponential priority = StreamPriorityLow 
			wait 0.34000000358 seconds 
			RANDOMCASE TRG_SFX_Ghost_TrainSparks01 : Obj_PlayStream SK6_SmSpark21 vol = 40 pitch = 100 id = TrainSpark dropoff = 160 dropoff_function = exponential priority = StreamPriorityLow 
			wait 0.36000001431 seconds 
		RANDOMEND 
		wait 0.10000000149 seconds 
	REPEAT 
ENDSCRIPT

