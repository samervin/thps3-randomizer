SCRIPT NO_SFX_Techno_Music 
	IF NOT InSplitScreenGame 
		IF NOT IsStreamPlaying Techno_Music 
			RANDOM_NO_REPEAT(1, 1, 1, 1) 
				RANDOMCASE Obj_PlayStream Techno_02 vol = 250 emitter = TRG_SFX_SOB_Techno01 dropoff_function = inv_exponential id = Techno_Music num_loops = -1 priority = 101 
				RANDOMCASE Obj_PlayStream Techno_03 vol = 250 emitter = TRG_SFX_SOB_Techno01 dropoff_function = inv_exponential id = Techno_Music num_loops = -1 priority = 101 
				RANDOMCASE Obj_PlayStream Techno_04 vol = 250 emitter = TRG_SFX_SOB_Techno01 dropoff_function = inv_exponential id = Techno_Music num_loops = -1 priority = 101 
				RANDOMCASE Obj_PlayStream Techno_05 vol = 250 emitter = TRG_SFX_SOB_Techno01 dropoff_function = inv_exponential id = Techno_Music num_loops = -1 priority = 101 
			RANDOMEND 
			Obj_AddStream Techno_Music add = Techno_01 vol = 250 
			wait 1 gameframe 
			Obj_RemoveStream Techno_Music remove = Techno_02 
			Obj_RemoveStream Techno_Music remove = Techno_03 
			Obj_RemoveStream Techno_Music remove = Techno_04 
			Obj_RemoveStream Techno_Music remove = Techno_05 
		ENDIF 
	ENDIF 
ENDSCRIPT

