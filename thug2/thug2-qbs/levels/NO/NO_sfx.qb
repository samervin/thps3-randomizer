SCRIPT NO_SFX_Crypt01_Constant_Rumble 
	IF GetFlag flag = FLAG_CRYPT_1 
		Obj_PlaySound SK6_NO_CryptRumbleLoop pitch = 40 emitter = TRG_SFX_SOB_CryptRumble01 dropoff_function = exponential 
		BEGIN 
			IF NOT IsStreamPlaying ACryptStream 
				RANDOM_NO_REPEAT(1, 1, 1) 
					RANDOMCASE TRG_SFX_Ghost_Crypt01 : Obj_PlayStream SK6_NO_CryptYell01 id = ACryptStream vol = 200 dropoff = 100 
					RANDOMCASE TRG_SFX_Ghost_Crypt01 : Obj_PlayStream SK6_NO_CryptYell02 id = ACryptStream vol = 200 dropoff = 100 
					RANDOMCASE TRG_SFX_Ghost_Crypt01 : Obj_PlayStream SK6_NO_CryptYell03 id = ACryptStream vol = 200 dropoff = 100 
