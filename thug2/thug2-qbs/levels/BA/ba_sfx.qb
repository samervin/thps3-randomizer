SCRIPT BA_SFX_PicnicBirds01 
	wait RANDOM(1, 1, 1, 1) RANDOMCASE 0 RANDOMCASE 0.20000000298 RANDOMCASE 0.80000001192 RANDOMCASE 0.89999997616 RANDOMEND seconds 
	BEGIN 
		RANDOM_NO_REPEAT(1, 1, 1, 1, 1, 1, 1, 1) 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird01 vol = BA_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_PicnicBirds01 RANDOMCASE TRG_SFX_SOB_PicnicBirds07 RANDOMCASE TRG_SFX_SOB_PicnicBirds08 RANDOMCASE TRG_SFX_SOB_PicnicBirds09 RANDOMEND priority = StreamPriorityLow 
			wait 4 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird02 vol = BA_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_PicnicBirds01 RANDOMCASE TRG_SFX_SOB_PicnicBirds07 RANDOMCASE TRG_SFX_SOB_PicnicBirds08 RANDOMCASE TRG_SFX_SOB_PicnicBirds09 RANDOMEND priority = StreamPriorityLow 
			wait 5 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird03 vol = BA_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_PicnicBirds01 RANDOMCASE TRG_SFX_SOB_PicnicBirds07 RANDOMCASE TRG_SFX_SOB_PicnicBirds08 RANDOMCASE TRG_SFX_SOB_PicnicBirds09 RANDOMEND priority = StreamPriorityLow 
			wait 4 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird04 vol = BA_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_PicnicBirds01 RANDOMCASE TRG_SFX_SOB_PicnicBirds07 RANDOMCASE TRG_SFX_SOB_PicnicBirds08 RANDOMCASE TRG_SFX_SOB_PicnicBirds09 RANDOMEND priority = StreamPriorityLow 
			wait 5 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird05 vol = BA_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_PicnicBirds01 RANDOMCASE TRG_SFX_SOB_PicnicBirds07 RANDOMCASE TRG_SFX_SOB_PicnicBirds08 RANDOMCASE TRG_SFX_SOB_PicnicBirds09 RANDOMEND priority = StreamPriorityLow 
			wait 8 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird06 vol = BA_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_PicnicBirds01 RANDOMCASE TRG_SFX_SOB_PicnicBirds07 RANDOMCASE TRG_SFX_SOB_PicnicBirds08 RANDOMCASE TRG_SFX_SOB_PicnicBirds09 RANDOMEND priority = StreamPriorityLow 
			wait 9 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird07 vol = BA_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_PicnicBirds01 RANDOMCASE TRG_SFX_SOB_PicnicBirds07 RANDOMCASE TRG_SFX_SOB_PicnicBirds08 RANDOMCASE TRG_SFX_SOB_PicnicBirds09 RANDOMEND priority = StreamPriorityLow 
			wait 4 seconds 
			RANDOMCASE Obj_PlayStream SK6_BO_Bird08 vol = BA_SFX_BirdChirpVol emitter = RANDOM_NO_REPEAT(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_PicnicBirds01 RANDOMCASE TRG_SFX_SOB_PicnicBirds07 RANDOMCASE TRG_SFX_SOB_PicnicBirds08 RANDOMCASE TRG_SFX_SOB_PicnicBirds09 RANDOMEND priority = StreamPriorityLow 
			wait 5 seconds 
		RANDOMEND 
		wait RANDOM(1, 1, 1) RANDOMCASE 0.50000000000 RANDOMCASE 1.10000002384 RANDOMCASE 1.29999995232 RANDOMEND seconds 
	REPEAT 
ENDSCRIPT

