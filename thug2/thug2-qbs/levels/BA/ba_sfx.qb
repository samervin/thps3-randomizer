ENDSCRIPT

SCRIPT BA_SFX_HarborWater02 
	Obj_PlaySound SK6_BO_RiverLoop01_11 vol = 60 emitter = TRG_SFX_SOB_HarborWater02 
ENDSCRIPT

SCRIPT BA_SFX_HarborBG 
	IF skatercamanimfinished 
		HarborBG01Vol = 150 
		wait RANDOM(1, 1, 1, 1) RANDOMCASE 0.30000001192 RANDOMCASE 0.80000001192 RANDOMCASE 1.29999995232 RANDOMCASE 1.79999995232 RANDOMEND seconds 
		BEGIN 
			RANDOM(1, 1, 1, 1, 10, 5, 5, 10, 3) 
				RANDOMCASE Obj_PlayStream SK6_BA_HarborBell01 vol = <HarborBG01Vol> emitter = RANDOM(1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG01 RANDOMCASE TRG_SFX_SOB_HarborBG06 RANDOMCASE TRG_SFX_SOB_HarborBG07 RANDOMEND dropoff_function = inv_exponential priority = StreamPriorityLow 
				wait 4 seconds 
				RANDOMCASE Obj_PlayStream SK6_BA_HarborBell02 vol = <HarborBG01Vol> emitter = RANDOM(1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG01 RANDOMCASE TRG_SFX_SOB_HarborBG06 RANDOMCASE TRG_SFX_SOB_HarborBG07 RANDOMEND dropoff_function = inv_exponential priority = StreamPriorityLow 
				wait 4 seconds 
				RANDOMCASE Obj_PlayStream SK6_BA_HarborBell04 vol = <HarborBG01Vol> emitter = RANDOM(1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG01 RANDOMCASE TRG_SFX_SOB_HarborBG06 RANDOMCASE TRG_SFX_SOB_HarborBG07 RANDOMEND dropoff_function = inv_exponential priority = StreamPriorityLow 
				wait 5 seconds 
				RANDOMCASE Obj_PlayStream SK6_BA_HarborBell05 vol = <HarborBG01Vol> emitter = RANDOM(1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG01 RANDOMCASE TRG_SFX_SOB_HarborBG06 RANDOMCASE TRG_SFX_SOB_HarborBG07 RANDOMEND dropoff_function = inv_exponential priority = StreamPriorityLow 
				wait 5 seconds 
				RANDOMCASE Obj_PlayStream SK6_BA_HarborBird01 vol = <HarborBG01Vol> emitter = RANDOM(1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG01 RANDOMCASE TRG_SFX_SOB_HarborBG06 RANDOMCASE TRG_SFX_SOB_HarborBG07 RANDOMEND dropoff_function = inv_exponential priority = StreamPriorityLow 
				wait 5.50000000000 seconds 
				RANDOMCASE 
				IF NOT ( IsStreamPlaying SK6_BA_HarborBird02 ) 
					Obj_PlayStream SK6_BA_HarborBird02 vol = <HarborBG01Vol> emitter = RANDOM(1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG01 RANDOMCASE TRG_SFX_SOB_HarborBG06 RANDOMCASE TRG_SFX_SOB_HarborBG07 RANDOMEND dropoff_function = inv_exponential priority = StreamPriorityLow 
					wait 5.50000000000 seconds 
				ENDIF 
				RANDOMCASE 
				IF NOT ( IsStreamPlaying SK6_BA_HarborBird03 ) 
					Obj_PlayStream SK6_BA_HarborBird03 vol = <HarborBG01Vol> emitter = RANDOM(1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG01 RANDOMCASE TRG_SFX_SOB_HarborBG06 RANDOMCASE TRG_SFX_SOB_HarborBG07 RANDOMEND dropoff_function = inv_exponential priority = StreamPriorityLow 
					wait 6 seconds 
				ENDIF 
				RANDOMCASE Obj_PlayStream SK6_BA_HarborBird04 vol = <HarborBG01Vol> emitter = RANDOM(1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG01 RANDOMCASE TRG_SFX_SOB_HarborBG06 RANDOMCASE TRG_SFX_SOB_HarborBG07 RANDOMEND dropoff_function = inv_exponential priority = StreamPriorityLow 
				wait 7 seconds 
				RANDOMCASE 
				IF NOT ( IsStreamPlaying HarborHornSound ) 
					printf "NO HARBOUR HORN STREAM IS PLAYING!!!" 
					RANDOM_NO_REPEAT(1, 1, 1, 1) 
						RANDOMCASE Obj_PlayStream SK6_BA_HarborHorn01 vol = <HarborBG01Vol> emitter = RANDOM(1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG01 RANDOMCASE TRG_SFX_SOB_HarborBG06 RANDOMCASE TRG_SFX_SOB_HarborBG07 RANDOMEND dropoff_function = inv_exponential id = HarborHornSound priority = StreamPriorityLow 
						wait 5 seconds 
						RANDOMCASE Obj_PlayStream SK6_BA_HarborHorn02 vol = <HarborBG01Vol> emitter = RANDOM(1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG01 RANDOMCASE TRG_SFX_SOB_HarborBG06 RANDOMCASE TRG_SFX_SOB_HarborBG07 RANDOMEND dropoff_function = inv_exponential id = HarborHornSound priority = StreamPriorityLow 
						wait 11 seconds 
						RANDOMCASE Obj_PlayStream SK6_BA_HarborHorn03 vol = <HarborBG01Vol> emitter = RANDOM(1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG01 RANDOMCASE TRG_SFX_SOB_HarborBG06 RANDOMCASE TRG_SFX_SOB_HarborBG07 RANDOMEND dropoff_function = inv_exponential id = HarborHornSound priority = StreamPriorityLow 
						wait 9 seconds 
						RANDOMCASE Obj_PlayStream SK6_BA_HarborHorn04 vol = <HarborBG01Vol> emitter = RANDOM(1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG01 RANDOMCASE TRG_SFX_SOB_HarborBG06 RANDOMCASE TRG_SFX_SOB_HarborBG07 RANDOMEND dropoff_function = inv_exponential id = HarborHornSound priority = StreamPriorityLow 
						wait 5 seconds 
					RANDOMEND 
				ENDIF 
			RANDOMEND 
			wait RANDOM(1, 1, 1) RANDOMCASE 0.50000000000 RANDOMCASE 1 RANDOMCASE 1.29999995232 RANDOMEND seconds 
		REPEAT 
	ENDIF 
ENDSCRIPT

SCRIPT BA_SFX_HarborBG02 
	HarborBG02Vol = 150 
	wait RANDOM(1, 1, 1, 1) RANDOMCASE 0.15000000596 RANDOMCASE 0.64999997616 RANDOMCASE 1.14999997616 RANDOMCASE 1.64999997616 RANDOMEND seconds 
	BEGIN 
		RANDOM(1, 1, 1, 5, 5, 10, 10, 3) 
			RANDOMCASE Obj_PlayStream SK6_BA_HarborBell03 vol = <HarborBG02Vol> emitter = RANDOM(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG02 RANDOMCASE TRG_SFX_SOB_HarborBG03 RANDOMCASE TRG_SFX_SOB_HarborBG04 RANDOMCASE TRG_SFX_SOB_HarborBG05 RANDOMEND dropoff_function = inv_exponential priority = StreamPriorityLow 
			wait 4 seconds 
			RANDOMCASE Obj_PlayStream SK6_BA_HarborBell06 vol = <HarborBG02Vol> emitter = RANDOM(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG02 RANDOMCASE TRG_SFX_SOB_HarborBG03 RANDOMCASE TRG_SFX_SOB_HarborBG04 RANDOMCASE TRG_SFX_SOB_HarborBG05 RANDOMEND dropoff_function = inv_exponential priority = StreamPriorityLow 
			wait 6 seconds 
			RANDOMCASE Obj_PlayStream SK6_BA_HarborBell07 vol = <HarborBG02Vol> emitter = RANDOM(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG02 RANDOMCASE TRG_SFX_SOB_HarborBG03 RANDOMCASE TRG_SFX_SOB_HarborBG04 RANDOMCASE TRG_SFX_SOB_HarborBG05 RANDOMEND dropoff_function = inv_exponential priority = StreamPriorityLow 
			wait 5 seconds 
			RANDOMCASE 
			IF NOT ( IsStreamPlaying SK6_BA_HarborBird02 ) 
				Obj_PlayStream SK6_BA_HarborBird02 vol = <HarborBG02Vol> emitter = RANDOM(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG02 RANDOMCASE TRG_SFX_SOB_HarborBG03 RANDOMCASE TRG_SFX_SOB_HarborBG04 RANDOMCASE TRG_SFX_SOB_HarborBG05 RANDOMEND dropoff_function = inv_exponential priority = StreamPriorityLow 
				wait 5.50000000000 seconds 
			ENDIF 
			RANDOMCASE 
			IF NOT ( IsStreamPlaying SK6_BA_HarborBird03 ) 
				Obj_PlayStream SK6_BA_HarborBird03 vol = <HarborBG02Vol> emitter = RANDOM(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG02 RANDOMCASE TRG_SFX_SOB_HarborBG03 RANDOMCASE TRG_SFX_SOB_HarborBG04 RANDOMCASE TRG_SFX_SOB_HarborBG05 RANDOMEND dropoff_function = inv_exponential priority = StreamPriorityLow 
				wait 6 seconds 
			ENDIF 
			RANDOMCASE Obj_PlayStream SK6_BA_HarborBird05 vol = <HarborBG02Vol> emitter = RANDOM(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG02 RANDOMCASE TRG_SFX_SOB_HarborBG03 RANDOMCASE TRG_SFX_SOB_HarborBG04 RANDOMCASE TRG_SFX_SOB_HarborBG05 RANDOMEND dropoff_function = inv_exponential priority = StreamPriorityLow 
			wait 8 seconds 
			RANDOMCASE Obj_PlayStream SK6_BA_HarborBird06 vol = <HarborBG02Vol> emitter = RANDOM(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG02 RANDOMCASE TRG_SFX_SOB_HarborBG03 RANDOMCASE TRG_SFX_SOB_HarborBG04 RANDOMCASE TRG_SFX_SOB_HarborBG05 RANDOMEND dropoff_function = inv_exponential priority = StreamPriorityLow 
			wait 7 seconds 
			RANDOMCASE 
			IF NOT ( IsStreamPlaying HarborHornSound ) 
				printf "NO HARBOUR HORN STREAM IS PLAYING!!!" 
				RANDOM_NO_REPEAT(1, 1, 1, 1) 
					RANDOMCASE Obj_PlayStream SK6_BA_HarborHorn01 vol = <HarborBG02Vol> emitter = RANDOM(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG02 RANDOMCASE TRG_SFX_SOB_HarborBG03 RANDOMCASE TRG_SFX_SOB_HarborBG04 RANDOMCASE TRG_SFX_SOB_HarborBG05 RANDOMEND dropoff_function = inv_exponential id = HarborHornSound priority = StreamPriorityLow 
					wait 5 seconds 
					RANDOMCASE Obj_PlayStream SK6_BA_HarborHorn02 vol = <HarborBG02Vol> emitter = RANDOM(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG02 RANDOMCASE TRG_SFX_SOB_HarborBG03 RANDOMCASE TRG_SFX_SOB_HarborBG04 RANDOMCASE TRG_SFX_SOB_HarborBG05 RANDOMEND dropoff_function = inv_exponential id = HarborHornSound priority = StreamPriorityLow 
					wait 11 seconds 
					RANDOMCASE Obj_PlayStream SK6_BA_HarborHorn03 vol = <HarborBG02Vol> emitter = RANDOM(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG02 RANDOMCASE TRG_SFX_SOB_HarborBG03 RANDOMCASE TRG_SFX_SOB_HarborBG04 RANDOMCASE TRG_SFX_SOB_HarborBG05 RANDOMEND dropoff_function = inv_exponential id = HarborHornSound priority = StreamPriorityLow 
					wait 9 seconds 
					RANDOMCASE Obj_PlayStream SK6_BA_HarborHorn04 vol = <HarborBG02Vol> emitter = RANDOM(1, 1, 1, 1) RANDOMCASE TRG_SFX_SOB_HarborBG02 RANDOMCASE TRG_SFX_SOB_HarborBG03 RANDOMCASE TRG_SFX_SOB_HarborBG04 RANDOMCASE TRG_SFX_SOB_HarborBG05 RANDOMEND dropoff_function = inv_exponential id = HarborHornSound priority = StreamPriorityLow 
					wait 5 seconds 
				RANDOMEND 
			ENDIF 
		RANDOMEND 
		wait RANDOM(1, 1, 1) RANDOMCASE 0.80000001192 RANDOMCASE 1.20000004768 RANDOMCASE 1.70000004768 RANDOMEND seconds 
	REPEAT 
