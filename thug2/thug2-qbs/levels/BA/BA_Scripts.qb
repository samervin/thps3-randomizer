						targetid = world 
						targetOffset = VECTOR(-5333.8, -271.9, -4152.8) 
						positionOffset = VECTOR(1828.9, 102.8, 2815.3) 
						frames = 200 
						skippable = 1 
				} ] 
				classic_mode_goal 
			} 
			AddGoal_Combo { 
				unlimited_time 
				letter_info = [ 
					{ obj_id = TRG_COMBO_C text = "C" } 
					{ obj_id = TRG_COMBO_O text = "O" } 
					{ obj_id = TRG_COMBO_M text = "M" } 
					{ obj_id = TRG_COMBO_B text = "B" } 
					{ obj_id = TRG_COMBO_O01 text = "O" } 
