	AddGoal_gaps { 
		version = 20 
		skater = pro 
		reward_points = 100 
		silent_activation 
		view_goals_text = BA_Gap20_Goal_Text 
		goal_description = BA_Gap20_Goal_Description 
		view_goals_tip = BA_Gap20_Goal_Tip 
		view_goals_cameras = [ 
			{ 
				targetOffset = VECTOR(-4143.79980468750, -133.19999694824, -4639.70019531250) 
				positionOffset = VECTOR(3628.39990234375, 573.50000000000, 1622.30004882812) 
		} ] 
		goal_flags = [ 
			{ skater = pro goal_flags = [ got_1 ] } 
			{ skater = custom goal_flags = [ got_1 ] } 
			{ skater = mechbullrider goal_flags = [ got_1 ] } 
