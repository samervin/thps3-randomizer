	IF GotParam start 
		Gap_Gen_PureAir start GapID = <GapID> 
	ELSE 
		IF GotParam End 
			Gap_Gen_PureAir End GapID = <GapID> text = "Guell Planter Dragon Transfer" score = 100 gapscript = BA_Goal_GuellTransfer_Got1 
