			} 
			{ 
				score = BA_GuellHighCombo_Normal 
				goal_description = BA_HighCombo_Normal_Goal_Description 
			} 
			{ 
				score = BA_GuellHighCombo_Hard 
				goal_description = BA_HighCombo_Hard_Goal_Description 
			} 
		] 
		unlocked_by_another 
	} 
ENDSCRIPT

