				view_goals_cameras = [ { virtual_cam 
						targetid = world 
						targetOffset = VECTOR(11691.4, -1109.6, 17852.6) 
						positionOffset = VECTOR(6784.8, 157.4, 9231.8) 
						frames = 200 
