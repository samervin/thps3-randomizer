						targetid = world 
						targetOffset = VECTOR(-6171.5, -1466.8, -3655.3) 
						positionOffset = VECTOR(2157.7, 121.6, 1645.6) 
						frames = 200 
						skippable = 1 
				} ] 
				classic_mode_goal 
			} 
