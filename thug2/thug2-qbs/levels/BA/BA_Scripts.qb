		RANDOMCASE TRG_SFX_Ghost_BullInCage : Obj_PlayStream SK6_BA_BullScream03 vol = 150 dropoff = 150 id = BullStream 
		RANDOMCASE TRG_SFX_Ghost_BullInCage : Obj_PlayStream SK6_BA_BullScream04 vol = 150 dropoff = 150 id = BullStream 
		RANDOMCASE TRG_SFX_Ghost_BullInCage : Obj_PlayStream SK6_BA_BullScream05 vol = 150 dropoff = 150 id = BullStream 
		RANDOMCASE TRG_SFX_Ghost_BullInCage : Obj_PlayStream SK6_BA_BullScream06 vol = 150 dropoff = 150 id = BullStream 
	RANDOMEND 
ENDSCRIPT

