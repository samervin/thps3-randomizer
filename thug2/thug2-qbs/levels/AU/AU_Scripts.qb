		variance = 1.00000000000 
		spread = 1.50000000000 
		life = 6 
		bounce = 0.50000000000 
		scale = 0.40000000596 
		vel_x = 0 
		vel_y = 60 
		vel_z = 0 
	} 
	Kill Name = <Name> 
ENDSCRIPT

