	Wait RANDOM(1, 1, 1) RANDOMCASE 1 Seconds RANDOMCASE 1.50000000000 Seconds RANDOMCASE 2 Seconds RANDOMEND 
	Create Name = <nodename> 
ENDSCRIPT

