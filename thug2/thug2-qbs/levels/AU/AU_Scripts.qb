	Obj_MoveToRelPos VECTOR(0.00000000000, -250.00000000000, 0.00000000000) Speed = 8 Acceleration = 2 
	Obj_WaitMove 
	GoToPreserveParams AU_Beaver_Bird 
ENDSCRIPT

