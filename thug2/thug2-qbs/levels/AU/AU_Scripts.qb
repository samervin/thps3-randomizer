SCRIPT AU_AborigineGap 
	IF IsAlive Name = TRG_Ped_Secret01 
		TRG_Ped_Secret01 : Obj_RotZ Angle = 180 Speed = 1000 FLAG_MAX_COORDS 
	ENDIF 
	IF GoalManager_GoalExists Name = AU_Goal_Gaps3 
		IF NOT GoalManager_HasWonGoal Name = AU_Goal_Gaps3 
			GoalManager_SetGoalFlag Name = AU_Goal_Gaps3 got_1 1 
			IF NOT IsAlive Name = TRG_Ped_MiniKart01 
				Create Name = TRG_Ped_MiniKart01 
			ENDIF 
			IF IsAlive Name = TRG_Ped_Foreman01 
				Kill Name = TRG_Ped_Foreman01 
			ENDIF 
			IF NOT IsAlive Name = TRG_Ped_Foreman02 
				Create Name = TRG_Ped_Foreman02 
			ENDIF 
		ENDIF 
	ENDIF 
ENDSCRIPT

