SCRIPT AU_2d_sign_element_create parent = menu3d_anchor 
	IF GetGlobalFlag Flag = SCREEN_MODE_WIDE 
		<offset> = PAIR(-8.00000000000, 0.00000000000) 
	ELSE 
		<offset> = PAIR(0.00000000000, 0.00000000000) 
	ENDIF 
	CreateScreenElement { 
		Type = SpriteElement 
		parent = <parent> 
		texture = AU_icon_1 
		ID = AU_turtle 
		scale = 3.50000000000 
		rgba = [ 128 128 128 100 ] 
		pos = ( PAIR(220.00000000000, 310.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ center center ] 
		z_priority = -51 
	} 
	flame_angle = -90 
	CreateScreenElement { 
		Type = SpriteElement 
		parent = <parent> 
		texture = AU_icon_2 
		ID = AU_flame 
		scale = 2.20000004768 
		rgba = [ 124 45 23 128 ] 
		pos = ( PAIR(76.00000000000, 182.00000000000) + <offset> ) 
		rot_angle = <flame_angle> 
		just = [ center bottom ] 
		z_priority = -51 
	} 
	RunScriptOnScreenElement ID = AU_turtle AU_turtle_anim 
	RunScriptOnScreenElement ID = AU_flame AU_flame_anim 
ENDSCRIPT

SCRIPT AU_flame_anim 
	BEGIN 
		new_pt = RANDOM(1, 1, 1, 1) RANDOMCASE PAIR(150.00000000000, 215.00000000000) RANDOMCASE PAIR(76.00000000000, 182.00000000000) RANDOMCASE PAIR(115.00000000000, 152.00000000000) RANDOMCASE PAIR(198.00000000000, 192.00000000000) RANDOMEND 
		DoMorph time = 0 scale = 2.20000004768 pos = <new_pt> alpha = 1 
		BEGIN 
			DoMorph time = 0 alpha = 1 
			DoMorph time = 0.07999999821 alpha = RANDOM(1, 1, 1) RANDOMCASE 0.40000000596 RANDOMCASE 0.50000000000 RANDOMCASE 0.80000001192 RANDOMEND rot_angle = RANDOM(1, 1) RANDOMCASE -89 RANDOMCASE -91 RANDOMEND 
		REPEAT RANDOM(1, 1, 1) RANDOMCASE 10 RANDOMCASE 15 RANDOMCASE 20 RANDOMEND 
		DoMorph time = 1.50000000000 scale = 2.50000000000 pos = ( <new_pt> + PAIR(5.00000000000, -15.00000000000) ) alpha = 0 rot_angle = -90 
		Wait RANDOM(1, 1, 1) RANDOMCASE 1 RANDOMCASE 2 RANDOMCASE 3 RANDOMEND Seconds 
	REPEAT 
ENDSCRIPT

SCRIPT AU_turtle_anim 
	BEGIN 
		DoMorph time = 0 rot_angle = -3 
		DoMorph time = 0.20000000298 rot_angle = 3 
		DoMorph time = 0.30000001192 rot_angle = -3 
	REPEAT 
ENDSCRIPT

SCRIPT AU_EnterSand 
	change SFX_FootStepWalk01 = AU_SANDSTEP01 
	change SFX_FootStepWalk02 = AU_SANDSTEP02 
	change SFX_FootStepWalk03 = AU_SANDSTEP03 
	change SFX_FootStepRun01 = AU_SANDSTEP01 
	change SFX_FootStepRun02 = AU_SANDSTEP02 
	change SFX_FootStepRun03 = AU_SANDSTEP03 
	change SFX_FootStepRun04 = AU_SANDSTEP01 
	change SFX_FootStepRun05 = AU_SANDSTEP02 
	ForceToWalk 
ENDSCRIPT

SCRIPT AU_ExitSand 
	SFX_Change_Footstep_Sounds_To_Default 
	KillForceToWalk 
ENDSCRIPT

SCRIPT AU_WaterKill 
	SFX_Change_Footstep_Sounds_To_Default 
	SK3_KillSkater nodename = <nodename> 
ENDSCRIPT

AU_StateLogic_Table = { 
	AU_STATE_RampKid = { 
		ped_update_type = no_move_update 
		script_ped_state = AU_STATECONTROL_RampKid 
	} 
	AU_STATE_LifeGuard_Walking = { 
		ped_update_type = generic_move_update 
		script_ped_state = AU_STATECONTROL_Lifeguard_Walking 
	} 
	AU_STATE_LifeGuard_Scanning = { 
		ped_update_type = no_move_update 
		script_ped_state = AU_STATECONTROL_Lifeguard_Scanning 
	} 
	AU_STATE_Cop_Pissed = { 
		ped_update_type = no_move_update 
		script_ped_state = AU_STATECONTROL_Cop_pissed 
	} 
	AU_STATE_F_Bikini = { 
		ped_update_type = no_move_update 
		script_ped_state = AU_STATECONTROL_F_Bikini 
	} 
	AU_STATE_F_Bikini_Front = { 
		ped_update_type = no_move_update 
		script_ped_state = AU_STATECONTROL_F_Bikini_Front 
	} 
	AU_STATE_F_Bikini_sit = { 
		ped_update_type = no_move_update 
		script_ped_state = AU_STATECONTROL_F_Bikini_Sit 
	} 
} 
AU_MetalDetectLogic_Table = { 
	AU_STATE_MetalDetect_Walking = { 
		ped_update_type = generic_move_update 
		script_ped_state = AU_STATECONTROL_MetalDetect_Walking 
	} 
	AU_STATE_MetalDetect_Standing = { 
		ped_update_type = no_move_update 
		script_ped_state = AU_STATECONTROL_MetalDetect_Standing 
	} 
	STATE_Standing = { 
		ped_update_type = no_move_update 
		script_ped_state = AU_STATECONTROL_MetalDetect_Talking 
	} 
} 
AU_Minikart_Table = { 
	AU_STATE_Minikart = { 
		ped_update_type = no_move_update 
		script_ped_state = AU_STATECONTROL_Minikart 
	} 
	STATE_GetAttention = { 
		ped_update_type = no_move_update 
		script_ped_state = AU_STATECONTROL_Minikart 
	} 
	STATE_Standing = { 
		ped_update_type = no_move_update 
		script_ped_state = AU_STATECONTROL_Minikart_Standing 
	} 
} 
BE_GrillerLogic_Table = { 
	BE_STATE_Griller = { 
		script_ped_state = BE_STATECONTROL_Grilling 
		exit_state_action = wait_anim_finished 
	} 
	STATE_avoidstop = { 
		high_priority 
		script_ped_state = STATECONTROL_avoidstop_custom01 
	} 
} 
SCRIPT BE_STATECONTROL_Grilling 
	BEGIN 
		RANDOM(1, 1, 1, 1, 1, 1) 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Griller_Cooking01 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Griller_Cooking02 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Griller_FixesGrill 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Griller_LooksAround 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Griller_Stretch 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_Griller_CallingCustomers 
		RANDOMEND 
		Obj_WaitAnimFinished 
	REPEAT 
ENDSCRIPT

SCRIPT PEDAI_MetalDetectStopWaypoint 
	Ped_SetLogicState AU_STATE_MetalDetect_Standing Table = AU_MetalDetectLogic_Table 
ENDSCRIPT

SCRIPT AU_Ped_Detector_Talk 
	Ped_SetLogicState AU_STATE_MetalDetect_Talking Table = AU_MetalDetectLogic_Table 
ENDSCRIPT

SCRIPT AU_STATECONTROL_MetalDetect_Walking 
	GetTags 
	OBJ_EnableAnimBlending enabled = 1 
	BEGIN 
		PlayAnimWithPartialAnimIfExists Anim = Ped_MetalDetect_WalkCyle 
		Obj_WaitAnimFinished 
	REPEAT 
ENDSCRIPT

SCRIPT AU_STATECONTROL_MetalDetect_Standing 
	Ped_StopMoving 
	PlayAnimWithPartialAnimIfExists Anim = Ped_MetalDetect_WalkCyleStop 
	Obj_WaitAnimFinished 
	GetRandomValue Name = RepeatCount a = 1 b = 3 resolution = 3 Integer 
	BEGIN 
		RANDOM(1, 1) 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_MetalDetect_Idle01 
			SpawnSound AU_SFX_Metal_Detector_Beep 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_MetalDetect_PicksUpCoin 
			SpawnSound AU_SFX_Metal_Detector_FindVO 
		RANDOMEND 
		Obj_WaitAnimFinished 
	REPEAT <RepeatCount> 
	Ped_StartMoving 
	PlayAnimWithPartialAnimIfExists Anim = Ped_MetalDetect_StartWalkCycle 
	Obj_WaitAnimFinished 
	Ped_SetLogicState AU_STATE_MetalDetect_Walking Table = AU_MetalDetectLogic_Table 
ENDSCRIPT

SCRIPT AU_STATECONTROL_MetalDetect_Talking 
	Ped_StopMoving 
	PlayAnimWithPartialAnimIfExists Anim = Ped_MetalDetect_WalkCyleStop 
	Obj_WaitAnimFinished 
	GetRandomValue Name = RepeatCount a = 1 b = 3 resolution = 3 Integer 
	BEGIN 
		Printf "---------------------------------METAL DETECTOR TALKING--------------------------------------" 
		PlayAnimWithPartialAnimIfExists Anim = Ped_MetalDetect_Idle01 
		Obj_WaitAnimFinished 
	REPEAT <RepeatCount> 
	Ped_StartMoving 
	PlayAnimWithPartialAnimIfExists Anim = Ped_MetalDetect_StartWalkCycle 
	Obj_WaitAnimFinished 
	Ped_SetLogicState AU_STATE_MetalDetect_Walking Table = AU_MetalDetectLogic_Table 
ENDSCRIPT

SCRIPT AU_STATECONTROL_RampKid 
	BEGIN 
		GetRandomValue Name = RepeatCount a = 1 b = 3 resolution = 3 Integer 
		BEGIN 
			RANDOM(2, 1) 
				RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_RampKid_Idle01 
				RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_RampKid_Looking 
			RANDOMEND 
			Obj_WaitAnimFinished 
		REPEAT <RepeatCount> 
		PlayAnimWithPartialAnimIfExists Anim = Ped_RampKid_PutBoardDown 
		Obj_WaitAnimFinished 
		GetRandomValue Name = RepeatCount a = 1 b = 3 resolution = 3 Integer 
		BEGIN 
			RANDOM(1, 1, 1) 
				RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_RampKid_BrdDwnLooks 
				RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = Ped_RampKid_BrdDwnHelmet 
				RANDOMCASE Printf "Rampkid skip" 
			RANDOMEND 
			Obj_WaitAnimFinished 
		REPEAT <RepeatCount> 
		PlayAnimWithPartialAnimIfExists Anim = Ped_RampKid_PickUpBrd 
		Obj_WaitAnimFinished 
	REPEAT 
ENDSCRIPT

SCRIPT AU_STATECONTROL_Minikart 
	BEGIN 
		PlayAnimWithPartialAnimIfExists Anim = Veh_Minikart_Idle 
		Obj_WaitAnimFinished 
	REPEAT 
ENDSCRIPT

SCRIPT AU_STATECONTROL_Minikart_Standing 
	PlayAnimWithPartialAnimIfExists Anim = Veh_Minikart_Ollie 
	Obj_WaitAnimFinished 
	PlayAnimWithPartialAnimIfExists Anim = Veh_Minikart_Land 
	Obj_WaitAnimFinished 
	BEGIN 
		PlayAnimWithPartialAnimIfExists Anim = Veh_Minikart_Idle 
		Obj_WaitAnimFinished 
	REPEAT 
ENDSCRIPT

SCRIPT PEDAI_LifeGuard_StopWayPoint 
	Ped_StopMoving 
	Ped_GetCurrentNodeNames 
	Obj_MoveToNode Name = <node_from> Speed = 5 mph 
	Obj_WaitMove 
	Ped_StartMoving 
	Ped_SetLogicState AU_STATE_LifeGuard_Scanning Table = AU_StateLogic_Table 
ENDSCRIPT

SCRIPT AU_STATECONTROL_Lifeguard_Scanning 
	Ped_TurnToCurrentWaypointOrientation time = 0.75000000000 
	PlayAnimWithPartialAnimIfExists Anim = WWalkToStand 
	Obj_WaitAnimFinished 
	BEGIN 
		RANDOM(1, 1, 1) 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = WStandIdle2 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = WStandIdle3 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = WStandIdle4 
		RANDOMEND 
		Obj_WaitAnimFinished 
	REPEAT 5 
	Ped_Statelogic_SetDefaultState 
ENDSCRIPT

SCRIPT AU_STATECONTROL_Lifeguard_Walking 
	PlayAnimWithPartialAnimIfExists Anim = WWalkToStand 
	Obj_WaitAnimFinished 
	BEGIN 
		PlayAnimWithPartialAnimIfExists Anim = WWalk 
		Obj_WaitAnimFinished 
	REPEAT 
ENDSCRIPT

SCRIPT AU_STATECONTROL_Cop_pissed 
	obj_getID 
	<ObjID> : SwitchOnAtomic ped_m_accessories 
	<ObjID> : SwitchOffAtomic ped_Board 
	BEGIN 
		RANDOM(1, 1, 1, 1) 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = PED_M_Pissed01 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = PED_M_Pissed02 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = PED_M_Pissed03 
			RANDOMCASE PlayAnimWithPartialAnimIfExists Anim = PED_M_Pissed04 
		RANDOMEND 
		Obj_WaitAnimFinished 
	REPEAT 
ENDSCRIPT


