	IF Skater : IsSkaterFocused 
		StartGap GapID = <ID1> Flags = [ PURE_AIR ] TrickText = "Double Kickflip" TrickScript = AU_DoubleFlip_Got 
	ENDIF 
ENDSCRIPT

SCRIPT AU_Gap_DoubleCar_End 
	EndGap GapID = <ID1> 
	SetException Ex = SkaterLandedClean Scr = AU_DoubleFlip_Clean Group = AU_DoubleFlip_Group 
	Wait 1 Second 
	ClearExceptionGroup AU_DoubleFlip_Group 
	UnSetFlag Flag = FLAG_DOUBLEFLIP_GOT 
ENDSCRIPT

SCRIPT AU_DoubleFlip_Got 
	SetFlag Flag = FLAG_DOUBLEFLIP_GOT 
ENDSCRIPT

SCRIPT AU_DoubleFlip_Clean 
	ClearExceptionGroup AU_DoubleFlip_Group 
	IF GoalManager_GoalExists Name = AU_Goal_Gaps7 
		IF NOT GoalManager_GoalIsLocked Name = AU_Goal_Gaps7 
			IF NOT GoalManager_HasWonGoal Name = AU_Goal_Gaps7 
				Wait 0.75000000000 Second 
				IF GetFlag Flag = FLAG_DOUBLEFLIP_GOT 
					GoalManager_SetGoalFlag Name = AU_Goal_Gaps7 got_1 1 
				ENDIF 
			ENDIF 
		ENDIF 
	ENDIF 
ENDSCRIPT

