	IF ( <Name> = MiniKartDriver ) 
	ELSE 
		GetTriggerArray [ { skate offegdge } { jump off } ] 
		IF Triggertype <trigger_array> 
			Trigger_Speed_Boost Speed = 3200 DefSkaterVO = 1 
		ENDIF 
	ENDIF 
