		IF NOT GoalManager_GoalFlagSet Name = AU_Goal_Gaps12 Flag = <Flag> 
			SpawnScript AU_SFX_ScreamingpeopleAtCafe 
			GoalManager_SetGoalFlag Name = AU_Goal_Gaps12 <Flag> 1 
		ENDIF 
		Printf "CR CR CR --- MEAL GOAL DOESN\'T EXIST, MEATHEAD!" 
	ENDIF 
ENDSCRIPT

