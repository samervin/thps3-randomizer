SCRIPT AU_Gap_BridgeR2R_Easy_End 
	IF GoalManager_GoalExists Name = AU_Classic_Goal_Gaps 
		Printf "CR CR CR --- GOAL GDAY FLAG IS %a" a = <Flag> 
		IF ( <Flag> = got_1 ) 
			EndGap GapID = <ID1> Score = 50 text = "G\'Day Ramp 2 Ramp" GapScript = AU_GDAY_Got01 
		ENDIF 
		IF ( <Flag> = got_2 ) 
			EndGap GapID = <ID1> Score = 50 text = "G\'Day Ramp 2 Ramp" GapScript = AU_GDAY_Got02 
		ENDIF 
		IF ( <Flag> = got_3 ) 
			EndGap GapID = <ID1> Score = 50 text = "G\'Day Ramp 2 Ramp" GapScript = AU_GDAY_Got03 
		ENDIF 
		IF ( <Flag> = got_4 ) 
			EndGap GapID = <ID1> Score = 50 text = "G\'Day Ramp 2 Ramp" GapScript = AU_GDAY_Got04 
		ENDIF 
		IF ( <Flag> = got_5 ) 
			EndGap GapID = <ID1> Score = 50 text = "G\'Day Ramp 2 Ramp" GapScript = AU_GDAY_Got05 
		ENDIF 
	ENDIF 
	EndGap GapID = <ID1> Score = 50 text = "G\'Day Ramp 2 Ramp" 
ENDSCRIPT

SCRIPT AU_GDAY_Got01 
	IF NOT GoalManager_GoalFlagSet Name = AU_Classic_Goal_Gaps Flag = got_1 
		GoalManager_SetGoalFlag Name = AU_Classic_Goal_Gaps got_1 1 
		GoTo AU_Classic_GDAY_Message 
	ENDIF 
ENDSCRIPT

