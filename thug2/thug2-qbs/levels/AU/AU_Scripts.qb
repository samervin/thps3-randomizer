SCRIPT AU_SandWarning 
	IF NOT ScreenElementExists ID = wetwarning 
		Create_Panel_Message { text = RANDOM(1, 1, 1) RANDOMCASE "Gonna get wet!!!" RANDOMCASE "Where are you going??" RANDOMCASE "Heading for trouble!" RANDOMEND Style = Goal_Collect_Text ID = wetwarning } 
		TRG_SFX_Ghost_LifeguardYelling : Obj_StopStream LifeguardStream 
		RANDOM(1, 1, 1, 1, 2, 2) 
			RANDOMCASE TRG_SFX_Ghost_LifeguardYelling : Obj_PlayStream AU_LifeguardYell01 priority = StreamPriorityHigh vol = 200 dropoff = 600 ID = LifeguardStream 
			RANDOMCASE TRG_SFX_Ghost_LifeguardYelling : Obj_PlayStream AU_LifeguardYell02 priority = StreamPriorityHigh vol = 200 dropoff = 600 ID = LifeguardStream 
			RANDOMCASE TRG_SFX_Ghost_LifeguardYelling : Obj_PlayStream AU_LifeguardYell03 priority = StreamPriorityHigh vol = 200 dropoff = 600 ID = LifeguardStream 
			RANDOMCASE TRG_SFX_Ghost_LifeguardYelling : Obj_PlayStream AU_LifeguardYell04 priority = StreamPriorityHigh vol = 200 dropoff = 600 ID = LifeguardStream 
			RANDOMCASE TRG_SFX_Ghost_LifeguardYelling : Obj_PlayStream AU_LifeguardYell05 priority = StreamPriorityHigh vol = 200 dropoff = 600 ID = LifeguardStream 
			RANDOMCASE TRG_SFX_Ghost_LifeguardYelling : Obj_PlayStream AU_LifeguardYell06 priority = StreamPriorityHigh vol = 200 dropoff = 600 ID = LifeguardStream 
		RANDOMEND 
	ENDIF 
ENDSCRIPT

SCRIPT AU_Event_A 
	Kill Prefix = "Geo_PostEvent_A" 
	Kill Prefix = "TRG_PostEvent_A" 
	Kill Prefix = "Geo_PreEvent_A" 
	Kill Prefix = "TRG_PreEvent_A" 
	IF ScreenElementExists ID = ped_speech_dialog 
		DestroyScreenElement ID = ped_speech_dialog 
	ENDIF 
	KillAllTextureSplats box = { height = 50 dist = 30 width = 30 offset = VECTOR(-339.00000000000, 47.00000000000, 870.00000000000) } 
	KillAllTextureSplats box = { height = 50 dist = 10 width = 10 offset = VECTOR(-376.00000000000, 46.00000000000, 802.00000000000) } 
	PlayCutScene Name = "CutScenes\\AU_LevelEvent1.Cut" RestartNode = TRG_Restart_Hydrant 
ENDSCRIPT

SCRIPT AU_Event_A_Out 
	Kill Prefix = "Geo_PostEvent_A" 
	Kill Prefix = "TRG_PostEvent_A" 
	Kill Name = TRG_SFX_TrigBox_SnoringWorker 
	Create Prefix = "Geo_PostEvent_A" 
	Create Prefix = "TRG_PostEvent_A" 
	CreateFastParticleSystem Name = JOW_SecretFoam01 params_Script = JOW_AU_SecretFoam01_fast_particle_params 
	CreateFastParticleSystem Name = JOW_SecretFoam02 params_Script = JOW_AU_SecretFoam02_fast_particle_params 
	CreateFastParticleSystem Name = JOW_SecretFoam03 params_Script = JOW_AU_SecretFoam03_fast_particle_params 
	CreateFastParticleSystem Name = JOW_SecretFoam04 params_Script = JOW_AU_SecretFoam04_fast_particle_params 
	CreateFastParticleSystem Name = JOW_SecretFoam05 params_Script = JOW_AU_SecretFoam05_fast_particle_params 
	CreateFastParticleSystem Name = JOW_SecretFoam06 params_Script = JOW_AU_SecretFoam06_fast_particle_params 
	CreateFastParticleSystem Name = JOW_Gusher01 params_Script = JOW_AU_Gusher01_fast_particle_params 
	CreateFastParticleSystem Name = JOW_Gusher02 params_Script = JOW_AU_Gusher02_fast_particle_params 
	SendException CRANE_POST_SPOT Prefix = "Geo_Crane_Obj" 
	Kill Name = Geo_Crane_Obj_KennyHead 
	Kill Name = Geo_Crane_Obj_Chain 
	IF IsAlive Name = TRG_Ped_Foreman01 
		Kill Name = TRG_Ped_Foreman01 
	ENDIF 
	Kill Name = NightOn_01_Street_lamp_06 
	TODManager_MarkPermanentlyDead Name = NightOn_01_Street_lamp_06 
	Kill Name = NightOff_01_Street_lamp_06 
	TODManager_MarkPermanentlyDead Name = NightOff_01_Street_lamp_06 
	Kill Name = NightOn_01_Street_lamp_03_Globe01 
	TODManager_MarkPermanentlyDead Name = NightOn_01_Street_lamp_03_Globe01 
	Kill Name = NightOff_01_Street_lamp_03_Globe 
	TODManager_MarkPermanentlyDead Name = NightOff_01_Street_lamp_03_Globe 
	IF IsAlive Name = TRG_Night_LevelLight_01_Lamp70 
		Kill Name = TRG_Night_LevelLight_01_Lamp70 
	ENDIF 
	TODManager_MarkPermanentlyDead Name = TRG_Night_LevelLight_01_Lamp70 
	Kill Name = NightOff_01_Geo_LampShadow05 
	TODManager_MarkPermanentlyDead Name = NightOff_01_Geo_LampShadow05 
	IF GoalManager_GoalExists Name = AU_Goal_Gaps2 
		IF NOT GoalManager_HasWonGoal Name = AU_Goal_Gaps2 
			GoalManager_SetGoalFlag Name = AU_Goal_Gaps2 got_1 1 
		ENDIF 
	ENDIF 
	Create Name = TRG_SFX_TrigBox_CrackedHydrant 
ENDSCRIPT

SCRIPT AU_Event_B 
	IF InMultiPlayerGame 
	ELSE 
		IF GetFlag Flag = FLAG_EVENT_B_POST_STATE 
		ELSE 
			IF GetFlag Flag = FLAG_EVENT_A_POST_STATE 
				GetCurrentSkaterProfileIndex 
				GetSkaterProfileInfo Player = <CurrentSkaterProfileIndex> 
				Printf "CR CR CR --- Skater Name is %a" a = <Name> 
				IF ( <Name> = MiniKartDriver ) 
					GetTriggerArray Grind Onto 
					IF Triggertype <trigger_array> 
						SetFlag Flag = FLAG_EVENT_B_POST_STATE 
						Wait 0.25000000000 Seconds 
						Kill Prefix = "Geo_PreEvent_B" 
						Kill Prefix = "TRG_PreEvent_B" 
						IF ScreenElementExists ID = ped_speech_dialog 
							DestroyScreenElement ID = ped_speech_dialog 
						ENDIF 
						PlayCutScene Name = "CutScenes\\AU_LevelEvent2.Cut" RestartNode = TRG_Restart_Event_B 
					ENDIF 
				ENDIF 
			ENDIF 
		ENDIF 
	ENDIF 
ENDSCRIPT

SCRIPT AU_Event_B_Out 
	Printf "CR CR CR --- GOT TO EVENT B OUT SCRIPT!!!" 
	Kill Prefix = "Geo_PostEvent_A_Sway" 
	Kill Prefix = "Geo_PreEvent_B" 
	Kill Prefix = "TRG_PreEvent_B" 
	Kill Prefix = "Geo_PostEvent_B" 
	Kill Prefix = "TRG_PostEvent_B" 
	IF IsAlive Name = NightOn_01_Geo_PreEvent_B_StreetLamp01 
		Printf "CR CR CR --- Upright nighttime lampost is still alive, so kill it!" 
		Kill Name = NightOn_01_Geo_PreEvent_B_StreetLamp01 
	ENDIF 
	IF IsAlive Name = NightOff_01_Geo_PreEvent_B_StreetLamp01 
		Printf "CR CR CR --- Upright daytime lampost is still alive, so kill it!" 
		Kill Name = NightOff_01_Geo_PreEvent_B_StreetLamp01 
	ENDIF 
	IF IsAlive Name = TRG_Ped_Foreman02 
		Kill Name = TRG_Ped_Foreman02 
	ENDIF 
	IF IsAlive Name = Geo_Crane_Obj_Chain 
		Kill Name = Geo_Crane_Obj_Chain 
	ENDIF 
	IF IsAlive Name = Geo_Crane_Obj_KennyHead 
		Kill Name = Geo_Crane_Obj_KennyHead 
	ENDIF 
	Kill Name = NightOff_01_Geo_PreEvent_B_StreetLamp01 
	TODManager_MarkPermanentlyDead Name = NightOff_01_Geo_PreEvent_B_StreetLamp01 
	Kill Name = NightOn_01_Geo_PreEvent_B_StreetLamp01 
	TODManager_MarkPermanentlyDead Name = NightOn_01_Geo_PreEvent_B_StreetLamp01 
	Kill Name = NightOff_01_Geo_PreEvent_B_StreetLampGlobe 
	TODManager_MarkPermanentlyDead Name = NightOff_01_Geo_PreEvent_B_StreetLampGlobe 
	Kill Name = NightOn_01_Geo_PreEvent_B_StreetLampGlobe01 
	TODManager_MarkPermanentlyDead Name = NightOn_01_Geo_PreEvent_B_StreetLampGlobe01 
	IF IsAlive Name = TRG_Night_LevelLight_01_Lamp68 
		Kill Name = TRG_Night_LevelLight_01_Lamp68 
	ENDIF 
	TODManager_MarkPermanentlyDead Name = TRG_Night_LevelLight_01_Lamp68 
	Kill Name = NightOff_01_Geo_PreEvent_B_LampShadow 
	TODManager_MarkPermanentlyDead Name = NightOff_01_Geo_PreEvent_B_LampShadow 
	Create Prefix = "Geo_PostEvent_B" 
	Create Prefix = "TRG_PostEvent_B" 
	Printf "CR CR CR --- LAST OF CREATE/KILL OUT SCRIPT STUFF...MOVING TO GOAL CHECK!!!" 
	IF GoalManager_GoalExists Name = AU_Goal_Gaps10 
		IF NOT GoalManager_HasWonGoal Name = AU_Goal_Gaps10 
			Printf "CR CR CR --- Goal Exists and is not beaten...spawn win goal stuff" 
			SpawnScript AU_Event_B_GoalEnd 
		ENDIF 
	ENDIF 
ENDSCRIPT

SCRIPT AU_Event_B_GoalEnd 
	Printf "CR CR CR --- GOT TO SPAWNED GOAL END SCRIPT SO PAUSE SKATERS" 
	PauseSkaters 
	Printf "CR CR CR --- JUST PAUSED SKATERS SO NOW PLAY CAMERA" 
	PlaySkaterCamAnim Name = CAM_BustedSkaters01 
	Kill Name = TRG_Ped_Cop01 
	Create Name = TRG_Ped_Cop02 
	Wait 2.50000000000 Seconds 
	SendException EVENT_2_DONE Name = TRG_Ped_Busted01 
	SendException EVENT_2_DONE Name = TRG_Ped_Busted02 
	BEGIN 
		IF SkaterCamAnimFinished Name = CAM_BustedSkaters01 
			BREAK 
		ENDIF 
		Wait 1 frames 
	REPEAT 
	Printf "CR CR CR --- CAMERA IS DONE SO UNPAUSE SKATERS" 
	GoalManager_SetGoalFlag Name = AU_Goal_Gaps10 got_1 1 
	UnPauseSkaters 
ENDSCRIPT

SCRIPT AU_Event_B_GoalDone 
	UnPauseSkaters 
ENDSCRIPT

SCRIPT AU_Crane_Setup 
	IF InMultiPlayerGame 
	ELSE 
		GetTriggerArray spin Onto 
		IF Triggertype <trigger_array> 
			IF GetFlag Flag = FLAG_EVENT_A_POST_STATE 
			ELSE 
				Create_Panel_Message { text = "Keep Spinning - 4!" Style = Goal_Collect_Text } 
				SpawnScript AU_Hydrant_Counter 
			ENDIF 
		ENDIF 
	ENDIF 
ENDSCRIPT

SCRIPT AU_Hydrant_Counter 
	SetException Ex = SkaterJump Scr = AU_Hydrant_Counter_Kill 
	SetException Ex = SkaterBailed Scr = AU_Hydrant_Counter_Kill 
	Wait 1 Second 
	Create_Panel_Message { text = "Keep Spinning - 3!" Style = Goal_Collect_Text } 
	Wait 1 Second 
	Create_Panel_Message { text = "Keep Spinning - 2!" Style = Goal_Collect_Text } 
	Wait 1 Second 
	Create_Panel_Message { text = "Keep Spinning - 1!" Style = Goal_Collect_Text } 
	Wait 1 Second 
	Create_Panel_Message { text = "FIRE IN THE HOLE!" Style = Goal_Collect_Text } 
	Wait 1 Second 
	UnSetFlag Flag = FLAG_EVENT_A_PRE_STATE 
	SetFlag Flag = FLAG_EVENT_A_POST_STATE 
	AU_Event_A 
ENDSCRIPT

SCRIPT AU_Hydrant_Counter_Kill 
	IF GetFlag Flag = FLAG_EVENT_A_POST_STATE 
	ELSE 
		Wait 0.50000000000 Seconds 
		Create_Panel_Message { text = "Almost!" Style = Goal_Collect_Text } 
	ENDIF 
ENDSCRIPT

