SCRIPT SFX_HandleLandOnSand 
	RANDOM_NO_REPEAT(1, 1, 1, 1, 1) 
		RANDOMCASE Obj_PlaySound ( SFX_FootStepRun01 ) pitch = RANDOM_RANGE PAIR(97.00000000000, 102.00000000000) vol = RANDOM_RANGE PAIR(105.00000000000, 120.00000000000) 
		RANDOMCASE Obj_PlaySound ( SFX_FootStepRun02 ) pitch = RANDOM_RANGE PAIR(97.00000000000, 102.00000000000) vol = RANDOM_RANGE PAIR(105.00000000000, 120.00000000000) 
		RANDOMCASE Obj_PlaySound ( SFX_FootStepRun03 ) pitch = RANDOM_RANGE PAIR(97.00000000000, 102.00000000000) vol = RANDOM_RANGE PAIR(105.00000000000, 120.00000000000) 
		RANDOMCASE Obj_PlaySound ( SFX_FootStepRun04 ) pitch = RANDOM_RANGE PAIR(97.00000000000, 102.00000000000) vol = RANDOM_RANGE PAIR(105.00000000000, 120.00000000000) 
		RANDOMCASE Obj_PlaySound ( SFX_FootStepRun05 ) pitch = RANDOM_RANGE PAIR(97.00000000000, 102.00000000000) vol = RANDOM_RANGE PAIR(105.00000000000, 120.00000000000) 
	RANDOMEND 
	wait 0.10000000149 seconds 
	RANDOM_NO_REPEAT(1, 1, 1, 1, 1) 
		RANDOMCASE Obj_PlaySound ( SFX_FootStepRun01 ) pitch = RANDOM_RANGE PAIR(97.00000000000, 102.00000000000) vol = RANDOM_RANGE PAIR(105.00000000000, 120.00000000000) 
		RANDOMCASE Obj_PlaySound ( SFX_FootStepRun02 ) pitch = RANDOM_RANGE PAIR(97.00000000000, 102.00000000000) vol = RANDOM_RANGE PAIR(105.00000000000, 120.00000000000) 
		RANDOMCASE Obj_PlaySound ( SFX_FootStepRun03 ) pitch = RANDOM_RANGE PAIR(97.00000000000, 102.00000000000) vol = RANDOM_RANGE PAIR(105.00000000000, 120.00000000000) 
		RANDOMCASE Obj_PlaySound ( SFX_FootStepRun04 ) pitch = RANDOM_RANGE PAIR(97.00000000000, 102.00000000000) vol = RANDOM_RANGE PAIR(105.00000000000, 120.00000000000) 
		RANDOMCASE Obj_PlaySound ( SFX_FootStepRun05 ) pitch = RANDOM_RANGE PAIR(97.00000000000, 102.00000000000) vol = RANDOM_RANGE PAIR(105.00000000000, 120.00000000000) 
	RANDOMEND 
ENDSCRIPT

SCRIPT AU_SFX_Pigeons_Idle 
	IF skatercamanimfinished 
		wait RANDOM(1, 1, 1) RANDOMCASE 1 RANDOMCASE 0.50000000000 RANDOMCASE 0.10000000149 RANDOMEND seconds 
		IF NOT IsStreamPlaying PigeonFlyUpSound 
			IF NOT IsStreamPlaying PigeonIdleSound 
				RANDOM(2, 1, 1) 
					RANDOMCASE 
					RANDOMCASE Obj_PlayStream BO_Pigeon id = PigeonIdleSound vol = 50 pitch = RANDOM_RANGE PAIR(95.00000000000, 100.00000000000) priority = StreamPriorityLowMid 
					RANDOMCASE Obj_PlayStream BO_Pigeon_02 id = PigeonIdleSound vol = 50 pitch = RANDOM_RANGE PAIR(95.00000000000, 100.00000000000) priority = StreamPriorityLowMid 
				RANDOMEND 
			ENDIF 
		ENDIF 
	ENDIF 
ENDSCRIPT

SCRIPT AU_SFX_Pigeons_FlyUp 
	IF IsStreamPlaying PigeonIdleSound 
		StopStream PigeonIdleSound 
	ENDIF 
	IF IsStreamPlaying BO_Pigeon 
		StopStream BO_Pigeon 
	ENDIF 
	StopStream BO_PigeonFly 
	IF NOT IsStreamPlaying PigeonFlyUpSound 
		Obj_PlayStream BO_PigeonFly id = PigeonFlyUpSound vol = 150 
	ENDIF 
ENDSCRIPT


