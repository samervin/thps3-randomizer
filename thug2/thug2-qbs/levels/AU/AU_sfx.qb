SCRIPT AU_SFX_Aborigine_Music 
	IF NOT InSplitScreenGame 
		IF skatercamanimfinished 
			IF NOT IsStreamPlaying Aborigine_Stream 
				RANDOM_NO_REPEAT(1, 1, 1, 1) 
					RANDOMCASE Obj_PlayStream Aborigine_02 vol = 150 id = Aborigine_Stream emitter = TRG_SFX_SOB_AborigineMusic dropoff_function = inv_exponential num_loops = -1 
					RANDOMCASE Obj_PlayStream Aborigine_03 vol = 150 id = Aborigine_Stream emitter = TRG_SFX_SOB_AborigineMusic dropoff_function = inv_exponential num_loops = -1 
					RANDOMCASE Obj_PlayStream Aborigine_04 vol = 150 id = Aborigine_Stream emitter = TRG_SFX_SOB_AborigineMusic dropoff_function = inv_exponential num_loops = -1 
					RANDOMCASE Obj_PlayStream Aborigine_05 vol = 150 id = Aborigine_Stream emitter = TRG_SFX_SOB_AborigineMusic dropoff_function = inv_exponential num_loops = -1 
				RANDOMEND 
				Obj_AddStream Aborigine_Stream add = Aborigine_01 vol = 150 
				wait 1 gameframe 
				Obj_RemoveStream Aborigine_Stream remove = Aborigine_02 
				Obj_RemoveStream Aborigine_Stream remove = Aborigine_03 
				Obj_RemoveStream Aborigine_Stream remove = Aborigine_04 
				Obj_RemoveStream Aborigine_Stream remove = Aborigine_05 
			ENDIF 
		ENDIF 
	ENDIF 
ENDSCRIPT

