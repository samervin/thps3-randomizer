	wait 1 gameframe 
	IF NOT IsStreamPlaying SeagullFlyUpStream 
		RANDOM(1, 1) 
			RANDOMCASE Obj_PlayStream AU_Seagull_Fly_Up_01 id = GullFlyUpSound vol = 150 id = SeagullFlyUpStream 
			RANDOMCASE Obj_PlayStream AU_Seagull_Fly_Up_02 id = GullFlyUpSound vol = 150 id = SeagullFlyUpStream 
		RANDOMEND 
	ENDIF 
ENDSCRIPT

SCRIPT AU_SFX_Metal_Detector_Beep 
	BEGIN 
		IF NOT IsStreamPlaying MetDetStream 
			RANDOM_NO_REPEAT(1, 1) 
				RANDOMCASE Obj_PlayStream AU_Met_Detector_Beep_01 vol = 100 priority = StreamPriorityLow dropoff = 150 id = MetDetStream 
				RANDOMCASE Obj_PlayStream AU_Met_Detector_Beep_02 vol = 100 priority = StreamPriorityLow dropoff = 150 id = MetDetStream 
			RANDOMEND 
		ENDIF 
		wait 2 seconds 
	REPEAT 2 
ENDSCRIPT

SCRIPT AU_SFX_Metal_Detector_FindVO 
	Obj_StopStream MetDetStream 
	RANDOM_NO_REPEAT(1, 1) 
		RANDOMCASE Obj_PlayStream AU_Met_Detector_Beep_01 vol = 100 priority = StreamPriorityLow dropoff = 150 id = MetDetStream 
		RANDOMCASE Obj_PlayStream AU_Met_Detector_Beep_02 vol = 100 priority = StreamPriorityLow dropoff = 150 id = MetDetStream 
	RANDOMEND 
	wait 2 seconds 
	RANDOM_NO_REPEAT(1, 1, 1) 
		RANDOMCASE Obj_PlayStream AU_Met_Det_Guy_Find_VO_01 vol = 200 priority = StreamPriorityMid dropoff = 150 id = MetDetStream 
		RANDOMCASE Obj_PlayStream AU_Met_Det_Guy_Find_VO_02 vol = 200 priority = StreamPriorityMid dropoff = 150 id = MetDetStream 
		RANDOMCASE Obj_PlayStream AU_Met_Det_Guy_Find_VO_03 vol = 200 priority = StreamPriorityMid dropoff = 150 id = MetDetStream 
	RANDOMEND 
ENDSCRIPT

SCRIPT AU_SFX_Bridge_Reverb 
	IF NOT GameIsPaused 
		IF NOT InSplitScreenGame 
			IF ( inside ) 
				printf "Inside Subway Reverb Box 01" 
				change InsideAdjacentReverbBox01 = 1 
				GetValueFromVolume cdvol 
				IF ( InsideAdjacentReverbBox02 = 0 ) 
					IF ( <value> = 0 ) 
						SetSfxReverb 50 mode = REV_MODE_ROOM 
					ELSE 
						SetSfxReverb 60 mode = REV_MODE_ROOM 
					ENDIF 
				ENDIF 
			ELSE 
				printf "Outside Subway Reverb Box 01" 
				IF ( InsideAdjacentReverbBox02 = 0 ) 
					SetSfxReverb 0 mode = REV_MODE_ROOM 
				ELSE 
				ENDIF 
				change InsideAdjacentReverbBox01 = 0 
			ENDIF 
		ENDIF 
	ENDIF 
ENDSCRIPT

SCRIPT AU_SFX_SecreteAreaReverb01 
	IF NOT GameIsPaused 
		IF NOT InSplitScreenGame 
			IF ( inside ) 
				printf "Inside Subway Reverb Box 01" 
				change InsideAdjacentReverbBox01 = 1 
				GetValueFromVolume cdvol 
				IF ( InsideAdjacentReverbBox02 = 0 ) 
					IF ( <value> = 0 ) 
						SetSfxReverb 65 mode = REV_MODE_ROOM 
					ELSE 
						SetSfxReverb 80 mode = REV_MODE_ROOM 
