SCRIPT AU_SFX_Snoring_Worker 
	IF NOT IsStreamPlaying CraneEngineIdleSFX 
		Obj_PlayStream SK6_AU_CraneEngineIdle vol = 150 emitter = TRG_SFX_SOB_SnoringWorker id = CraneEngineIdleSFX num_loops = -1 priority = StreamPriorityMidHigh dropoff_function = exponential 
	ENDIF 
	IF NOT InNetGame 
		BEGIN 
			IF NOT IsStreamPlaying ConstructionSnoring 
				RANDOM_NO_REPEAT(1, 1, 1, 1, 1) 
					RANDOMCASE Obj_PlayStream AU_WorkerSnoring01 vol = 200 emitter = TRG_SFX_SOB_SnoringWorker priority = StreamPriorityLowMid id = ConstructionSnoring 
					RANDOMCASE Obj_PlayStream AU_WorkerSnoring02 vol = 200 emitter = TRG_SFX_SOB_SnoringWorker priority = StreamPriorityLowMid id = ConstructionSnoring 
					RANDOMCASE Obj_PlayStream AU_WorkerSnoring03 vol = 200 emitter = TRG_SFX_SOB_SnoringWorker priority = StreamPriorityLowMid id = ConstructionSnoring 
					RANDOMCASE Obj_PlayStream AU_WorkerSnoring04 vol = 200 emitter = TRG_SFX_SOB_SnoringWorker priority = StreamPriorityLowMid id = ConstructionSnoring 
					RANDOMCASE Obj_PlayStream AU_WorkerSnoring05 vol = 200 emitter = TRG_SFX_SOB_SnoringWorker priority = StreamPriorityLowMid id = ConstructionSnoring 
				RANDOMEND 
			ENDIF 
			wait 2 seconds 
		REPEAT 
	ENDIF 
ENDSCRIPT

