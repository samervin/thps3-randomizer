SCRIPT AU_SFX_Waves01 
	IF skatercamanimfinished 
		IF NOT IsStreamPlaying AU_SFX_WavesLeftStream 
			BEGIN 
				RANDOM_NO_REPEAT(1, 1, 1, 1, 1, 1) 
					RANDOMCASE Obj_PlayStream AU_WavesLeft01 vol = 50 emitter = TRG_SFX_SOB_Waves01 dropoff_function = inv_exponential id = AU_SFX_WavesLeftStream 
					RANDOMCASE Obj_PlayStream AU_WavesLeft02 vol = 50 emitter = TRG_SFX_SOB_Waves01 dropoff_function = inv_exponential id = AU_SFX_WavesLeftStream 
					RANDOMCASE Obj_PlayStream AU_WavesLeft03 vol = 50 emitter = TRG_SFX_SOB_Waves01 dropoff_function = inv_exponential id = AU_SFX_WavesLeftStream 
					RANDOMCASE Obj_PlayStream AU_WavesLeft04 vol = 50 emitter = TRG_SFX_SOB_Waves01 dropoff_function = inv_exponential id = AU_SFX_WavesLeftStream 
					RANDOMCASE Obj_PlayStream AU_WavesLeft05 vol = 50 emitter = TRG_SFX_SOB_Waves01 dropoff_function = inv_exponential id = AU_SFX_WavesLeftStream 
					RANDOMCASE Obj_PlayStream AU_WavesLeft06 vol = 50 emitter = TRG_SFX_SOB_Waves01 dropoff_function = inv_exponential id = AU_SFX_WavesLeftStream 
				RANDOMEND 
