SCRIPT SE_SFX_Robot_Beeps Robot = TRG_Droid_01 
	RANDOM(1, 1, 1, 1, 1) 
		RANDOMCASE <Robot> : Obj_PlayStream SK6_SE_Robot_Beep01 dropoff = 250 priority = StreamPriorityLow 
		RANDOMCASE <Robot> : Obj_PlayStream SK6_SE_Robot_Beep02 dropoff = 250 priority = StreamPriorityLow 
		RANDOMCASE <Robot> : Obj_PlayStream SK6_SE_Robot_Beep03 dropoff = 250 priority = StreamPriorityLow 
		RANDOMCASE <Robot> : Obj_PlayStream SK6_SE_Robot_Beep04 dropoff = 250 priority = StreamPriorityLow 
		RANDOMCASE <Robot> : Obj_PlayStream SK6_SE_Robot_Beep05 dropoff = 250 priority = StreamPriorityLow 
	RANDOMEND 
ENDSCRIPT

SCRIPT SE_SFX_IgniteEngine01 
	wait 0.10000000149 seconds 
	IF NOT ( ( GetFlag flag = RedButton01 ) & ( GetFlag flag = RedButton02 ) ) 
		PlaySound SK6_SE_PressButton01 vol = 160 
	ENDIF 
ENDSCRIPT

SCRIPT SE_SFX_IgniteEngine02 
	wait 0.10000000149 seconds 
	IF NOT ( ( GetFlag flag = RedButton01 ) & ( GetFlag flag = RedButton02 ) ) 
		PlaySound SK6_SE_PressButton01 vol = 160 
	ENDIF 
ENDSCRIPT

