SCRIPT SE_SFX_RedZap_01 
	IF InSplitscreenGame 
		IF NOT IsStreamPlaying RedZapper 
			Obj_PlayStream SK6_SE_RedElectricalZappingLoop emitter = TRG_SFX_SOB_RedZap01 id = RedZapper num_loops = -1 
		ENDIF 
	ELSE 
		Obj_PlayStream SK6_SE_RedElectricalZappingLoop emitter = TRG_SFX_SOB_RedZap01 id = RedZapper num_loops = -1 
	ENDIF 
ENDSCRIPT

