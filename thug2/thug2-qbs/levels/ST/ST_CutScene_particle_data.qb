
SCRIPT load_cutscene_particle_textures 
	LoadParticleTexture "particles\\apm_flamequad_01" 
	LoadParticleTexture "particles\\apm_spark_01" 
	LoadParticleTexture "particles\\ba_apm_smokepuff01s" 
ENDSCRIPT

