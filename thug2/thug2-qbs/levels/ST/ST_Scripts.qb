SCRIPT ST_2d_sign_element_create parent = menu3d_anchor 
	IF GetGlobalFlag flag = SCREEN_MODE_WIDE 
		<offset> = PAIR(-8.00000000000, 0.00000000000) 
	ELSE 
		<offset> = PAIR(0.00000000000, 0.00000000000) 
	ENDIF 
	CreateScreenElement { 
		type = ContainerElement 
		parent = <parent> 
		pos = PAIR(0.00000000000, 0.00000000000) 
		id = SK_bullet_holder 
		z_priority = -53 
	} 
	CreateScreenElement { 
		type = SpriteElement 
		parent = SK_bullet_holder 
		texture = SK_icon_1 
		id = SK_bullet1 
		scale = 1.50000000000 
		rgba = [ 128 128 128 128 ] 
		pos = ( PAIR(9.00000000000, 148.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ left top ] 
	} 
	CreateScreenElement { 
		type = SpriteElement 
		parent = SK_bullet_holder 
		texture = SK_icon_1 
		id = SK_bullet2 
		scale = 1.50000000000 
		rgba = [ 128 128 128 128 ] 
		pos = ( PAIR(9.00000000000, 148.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ left top ] 
	} 
	CreateScreenElement { 
		type = SpriteElement 
		parent = SK_bullet_holder 
		texture = SK_icon_1 
		id = SK_bullet3 
		scale = 1.50000000000 
		rgba = [ 128 128 128 128 ] 
		pos = ( PAIR(9.00000000000, 148.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ left top ] 
	} 
	CreateScreenElement { 
		type = SpriteElement 
		parent = SK_bullet_holder 
		texture = SK_icon_1 
		id = SK_bullet4 
		scale = 1.50000000000 
		rgba = [ 128 128 128 128 ] 
		pos = ( PAIR(9.00000000000, 148.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ left top ] 
	} 
	CreateScreenElement { 
		type = SpriteElement 
		parent = SK_bullet_holder 
		texture = SK_icon_1 
		id = SK_bullet5 
		scale = 1.50000000000 
		rgba = [ 128 128 128 128 ] 
		pos = ( PAIR(9.00000000000, 148.00000000000) + <offset> ) 
		rot_angle = 0 
		just = [ left top ] 
	} 
	CreateScreenElement { 
		type = SpriteElement 
		parent = <parent> 
		texture = SK_icon_2 
		id = SK_crash 
		scale = 2.40000009537 
		rgba = [ 128 128 128 128 ] 
		pos = ( PAIR(80.00000000000, 370.00000000000) + <offset> ) 
		rot_angle = -20 
		just = [ center center ] 
		z_priority = -51 
	} 
	RunScriptOnScreenElement id = SK_bullet_holder SK_bullet_anim 
	RunScriptOnScreenElement id = SK_crash do_random_effect_paused params = { id = <id> } 
ENDSCRIPT

SCRIPT SK_bullet_anim 
	BEGIN 
		bull1_pos = RANDOM(1, 1) RANDOMCASE PAIR(-10.00000000000, 30.00000000000) RANDOMCASE PAIR(-5.00000000000, 90.00000000000) RANDOMEND 
		bull2_pos = RANDOM(1, 1) RANDOMCASE PAIR(15.00000000000, 150.00000000000) RANDOMCASE PAIR(60.00000000000, 220.00000000000) RANDOMEND 
		bull3_pos = RANDOM(1, 1) RANDOMCASE PAIR(90.00000000000, 188.00000000000) RANDOMCASE PAIR(15.00000000000, 220.00000000000) RANDOMEND 
		bull4_pos = RANDOM(1, 1) RANDOMCASE PAIR(130.00000000000, 240.00000000000) RANDOMCASE PAIR(24.00000000000, 280.00000000000) RANDOMEND 
		bull5_pos = RANDOM(1, 1) RANDOMCASE PAIR(120.00000000000, 300.00000000000) RANDOMCASE PAIR(40.00000000000, 320.00000000000) RANDOMEND 
		SK_bullet1 : DoMorph time = 0 pos = <bull1_pos> scale = 1.79999995232 alpha = 0 
		SK_bullet2 : DoMorph time = 0 pos = <bull2_pos> scale = 1.79999995232 alpha = 0 
		SK_bullet3 : DoMorph time = 0 pos = <bull3_pos> scale = 1.79999995232 alpha = 0 
		SK_bullet4 : DoMorph time = 0 pos = <bull4_pos> scale = 1.79999995232 alpha = 0 
		SK_bullet5 : DoMorph time = 0 pos = <bull5_pos> scale = 1.79999995232 alpha = 0 
		DoMorph time = 0 alpha = 1 
		wait RANDOM(1, 1, 1) RANDOMCASE 1 RANDOMCASE 2 RANDOMCASE 3 RANDOMEND seconds 
		SK_bullet1 : DoMorph time = 0.10000000149 pos = <bull1_pos> alpha = 1 
		wait RANDOM(1, 1, 1) RANDOMCASE 1 RANDOMCASE 2 RANDOMCASE 3 RANDOMEND seconds 
		SK_bullet2 : DoMorph time = 0.10000000149 pos = <bull2_pos> alpha = 1 
		wait RANDOM(1, 1, 1) RANDOMCASE 1 RANDOMCASE 2 RANDOMCASE 3 RANDOMEND seconds 
		SK_bullet3 : DoMorph time = 0.10000000149 pos = <bull3_pos> alpha = 1 
		wait RANDOM(1, 1, 1) RANDOMCASE 1 RANDOMCASE 2 RANDOMCASE 3 RANDOMEND seconds 
		SK_bullet4 : DoMorph time = 0.10000000149 pos = <bull4_pos> alpha = 1 
		wait RANDOM(1, 1, 1) RANDOMCASE 1 RANDOMCASE 2 RANDOMCASE 3 RANDOMEND seconds 
		SK_bullet5 : DoMorph time = 0.10000000149 pos = <bull5_pos> alpha = 1 
		wait RANDOM(1, 1, 1) RANDOMCASE 5 RANDOMCASE 8 RANDOMCASE 12 RANDOMEND seconds 
		DoMorph time = 1 alpha = 0 
		wait RANDOM(1, 1, 1) RANDOMCASE 1 RANDOMCASE 2 RANDOMCASE 3 RANDOMEND seconds 
	REPEAT 
ENDSCRIPT

ST_CatLogic_Table = { 
	ST_STATE_IdleCat = { 
		script_ped_state = ST_STATECONTROL_KittyNice 
	} 
	STATE_chasecatch = { 
		script_ped_state = ST_STATECONTROL_Kittycatch 
	} 
} 
SCRIPT ST_STATECONTROL_KittyNice 
	OBJ_EnableAnimBlending enabled = 1 
	Obj_SetInnerRadius 25 
	SetEventHandler EX = ObjectInRadius scr = ST_Cat_StartChase 
	BEGIN 
		RANDOM(1, 1) 
			RANDOMCASE PlayAnimWithPartialAnimIfExists anim = idle 
			RANDOMCASE PlayAnimWithPartialAnimIfExists anim = SitFromIdle 
			Obj_waitAnimFinished 
			BEGIN 
				RANDOM(1, 1, 1) 
					RANDOMCASE PlayAnimWithPartialAnimIfExists anim = SitIdle1 
					RANDOMCASE PlayAnimWithPartialAnimIfExists anim = SitIdle2 
					RANDOMCASE PlayAnimWithPartialAnimIfExists anim = SitIdle3 
				RANDOMEND 
				Obj_waitAnimFinished 
			REPEAT 4 
			PlayAnimWithPartialAnimIfExists anim = SitFromIdle backwards 
		RANDOMEND 
		IF NOT IsStreamPlaying CatMeowSFX 
			RANDOM(4, 1, 1) 
				RANDOMCASE 
				RANDOMCASE Obj_PlayStream ST_Cat_Idle01 vol = 80 priority = StreamPriorityMidHigh dropoff = 150 id = CatMeowSFX 
				RANDOMCASE Obj_PlayStream ST_Cat_Idle02 vol = 80 priority = StreamPriorityMidHigh dropoff = 150 id = CatMeowSFX 
			RANDOMEND 
		ENDIF 
		Obj_waitAnimFinished 
	REPEAT 
ENDSCRIPT

SCRIPT ST_Cat_StartChase 
	ClearEventHandler ObjectInRadius 
	Ped_Utils_BeginPlayerChase MaxHomeDist = 25 Table = ST_CatLogic_Table 
ENDSCRIPT

SCRIPT ST_STATECONTROL_Kittycatch 
	PlayAnimWithPartialAnimIfExists anim = Pounce cycle 
	RANDOM(1, 1) 
		RANDOMCASE Obj_PlayStream ST_Cat_Angry01 vol = 200 priority = StreamPriorityMidHigh dropoff = 150 
		RANDOMCASE Obj_PlayStream ST_Cat_Angry02 vol = 200 priority = StreamPriorityMidHigh dropoff = 150 
	RANDOMEND 
	Obj_LockToObject VECTOR(0.00000000000, 59.00000000000, 0.00000000000) ObjectName = skater LagRange = PAIR(0.20000000298, 0.40000000596) 
	wait 0.30000001192 seconds 
	IF NOT skater : walking 
		ShakeCamera { 
			duration = 2 
			vert_amp = 4.00000000000 
			horiz_amp = 4.00000000000 
			vert_vel = 5.26999998093 
			horiz_vel = 10.92000007629 
		} 
	ENDIF 
	PlayAnimWithPartialAnimIfExists anim = attack cycle 
	skater : Obj_GetScaling 
	sz = ( ( ( 1 - ( <scaling> . VECTOR(0.00000000000, 0.00000000000, 1.00000000000) ) ) * -75 ) + 1 ) 
	catoffset = ( <sz> * VECTOR(0.00000000000, 0.00000000000, 1.00000000000) ) 
	Obj_LockToObject <catoffset> bone = bone_neck ObjectName = skater LagRange = PAIR(1.00000000000, 1.00000000000) 
	obj_getID 
	SWITCH <objid> 
		CASE TRG_ped_pinkcat 
			wait 2 seconds 
		CASE TRG_ped_escape_pinkcat 
			wait 20 seconds 
	ENDSWITCH 
	Obj_LockToObject off 
	PlayAnimWithPartialAnimIfExists anim = Pounce cycle 
	skater : Obj_GetPosition 
	<pos> = ( <pos> + VECTOR(60.00000000000, 0.00000000000, 60.00000000000) ) 
	Obj_MoveToPos <pos> time = 0.15000000596 
	Obj_WaitMove 
	Ped_GetCurrentNodeNames 
	Obj_MoveToNode name = <node_from> orient 
	PlayAnimWithPartialAnimIfExists anim = idle cycle 
	wait 5 seconds 
	Ped_StateLogic_SetDefaultState 
ENDSCRIPT


