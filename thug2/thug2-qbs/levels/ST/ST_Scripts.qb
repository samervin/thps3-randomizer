				g_endgoal_rocket_18 : Obj_MoveToRelPos VECTOR(0.00000000000, 25.00000000000, 0.00000000000) Speed = 50 
				g_endgoal_rocket_19 : Obj_MoveToRelPos VECTOR(0.00000000000, 25.00000000000, 0.00000000000) Speed = 50 
