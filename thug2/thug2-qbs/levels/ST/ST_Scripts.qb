				g_endgoal_rocket_23 : Obj_MoveToRelPos VECTOR(0.00000000000, 25.00000000000, 0.00000000000) Speed = 50 
				create name = TRG_rail_endgoal_rocket_01 
				create name = TRG_rail_endgoal_rocket_02 
