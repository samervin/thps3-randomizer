SCRIPT ST_EndGoal_Hawk_intro_cleanup 
	IF NOT isAlive name = TRG_ped_endgoal_escape_01 
		create prefix = "TRG_ped_endgoal_escape_" 
	ENDIF 
	IF isAlive name = TRG_Ped_Endgoal_Hawk1 
