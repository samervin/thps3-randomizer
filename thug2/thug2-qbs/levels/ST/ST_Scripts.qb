				g_endgoal_rocket_21 : Obj_MoveToRelPos VECTOR(0.00000000000, 25.00000000000, 0.00000000000) Speed = 50 
				g_endgoal_rocket_26 : Obj_MoveToRelPos VECTOR(0.00000000000, 25.00000000000, 0.00000000000) Speed = 50 
				g_endgoal_rocket_27 : Obj_MoveToRelPos VECTOR(0.00000000000, 25.00000000000, 0.00000000000) Speed = 50 
				create name = TRG_rail_endgoal_rocket_04 
