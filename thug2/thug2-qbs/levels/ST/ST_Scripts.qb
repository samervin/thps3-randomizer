				g_endgoal_rocket_48 : Obj_MoveToRelPos VECTOR(0.00000000000, 25.00000000000, 0.00000000000) Speed = 50 
				g_endgoal_rocket_49 : Obj_MoveToRelPos VECTOR(0.00000000000, 25.00000000000, 0.00000000000) Speed = 50 
				create name = TRG_rail_endgoal_rocket_28 
