		RANDOMCASE PlayStream ST_ChickenCoopMayhem04 vol = 200 priority = StreamPriorityHigh 
		RANDOMCASE PlayStream ST_ChickenCoopMayhem05 vol = 200 priority = StreamPriorityHigh 
